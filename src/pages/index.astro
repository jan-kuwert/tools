---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ImageEditor from '../components/ImageEditor.astro';
import ModeBadge from '../components/ModeBadge.astro';
import { categories, href, tools, type Category, type Tool } from '../tools';

type Dir = 'n' | 'e' | 's' | 'w';
type Screen = Category | 'centre';
// Navigation graph: from any screen, the edges lead to all other screens one move away, never to an empty one.
const graph: Record<Screen, Partial<Record<Dir, Screen>>> = {
  centre: { n: 'files', e: 'pdf', s: 'images', w: 'audio' },
  audio: { n: 'files', e: 'centre', s: 'images' },
  pdf: { n: 'files', s: 'images', w: 'centre' },
  images: { n: 'centre', e: 'pdf', w: 'audio' },
  files: { e: 'pdf', s: 'centre', w: 'audio' },
};
const screens: Screen[] = ['centre', ...categories.map((c) => c.id)];

const dropTypes: [Category | 'code', string][] = [['images', 'Images'], ['pdf', 'PDF'], ['audio', 'Audio'], ['code', 'JSON & JS'], ['files', 'Archives']];
const toolsIn = (c: Category) => tools.filter((t) => t.category === c);
const labelOf = (s: Screen) => (s === 'centre' ? 'Start' : categories.find((x) => x.id === s)!.label);
const iconOf = (s: Screen) => (s === 'centre' ? 'home' : s);
const toolIcon = (t: Tool) => (t.slug.startsWith('text/') ? 'code' : t.category);
const ARROW = { n: 'arrow-up', e: 'arrow-right', s: 'arrow-down', w: 'arrow-left' } as const;
---
<Base title="Tools · fast, private file tools" wide>
<div class="home" data-at="centre">
  <div class="hub" data-home data-hub tabindex="0" role="region" aria-label="Tools. Arrow keys move between screens; Escape returns to the start.">
    {screens.map((id) => (
      <section
        class={`screen ${id === 'centre' ? 'screen-centre' : 'screen-panel'}`}
        data-screen={id}
        {...Object.fromEntries(Object.entries(graph[id]).map(([d, to]) => [`data-${d}`, to]))}
        aria-label={id === 'centre' ? 'Start' : undefined}
        aria-labelledby={id === 'centre' ? undefined : `hub-${id}`}
      >
        <div class="cell-scroll">
          {id === 'centre' ? (
            <div class="cell-inner centre-inner">
              <h1>Quick file tools that respect your privacy.</h1>
              <p class="lede">Almost everything runs right here in your browser. Your files never leave your device.</p>
              <label class="drop hero-drop" data-hero-drop>
                <input type="file" multiple data-hero-input />
                <span class="drop-types" aria-hidden="true">
                  {dropTypes.map(([g, label]) => (
                    <span class="drop-type"><Icon name={g} />{label}</span>
                  ))}
                </span>
                <span class="drop-title">Drop any file to start</span>
                <span class="btn btn-primary drop-btn" aria-hidden="true">Choose files</span>
                <span class="drop-hint">Or paste from the clipboard. We pick the right tool for you.</span>
              </label>
              <p class="status" data-drop-status role="status" aria-live="polite"></p>
              <button class="btn all-tools" type="button" data-all-tools aria-haspopup="dialog">
                <Icon name="grid" />Show all tools
              </button>
            </div>
          ) : (
            <div class="cell-inner" style={`--cols: ${Math.min(toolsIn(id).length, 4)}`}>
              <div class="panel-head">
                <span class="tile"><Icon name={id} /></span>
                <h2 id={`hub-${id}`} tabindex="-1">{labelOf(id)}</h2>
              </div>
              <p class="panel-blurb">{categories.find((c) => c.id === id)!.blurb}</p>
              <ul class="tool-grid">
                {toolsIn(id).map((t) => (
                  <li>
                    <a class="tool-card" href={href(t.slug)}>
                      <span class="tile"><Icon name={toolIcon(t)} /></span>
                      <h3>{t.title}</h3>
                      <p>{t.summary}</p>
                      <span class="card-mode"><ModeBadge mode={t.mode} /></span>
                    </a>
                  </li>
                ))}
              </ul>
              <p class="panel-hint">Drop files anywhere on this page and we pick the right tool.</p>
            </div>
          )}
        </div>
        {(Object.entries(graph[id]) as [Dir, Screen][]).map(([dir, to]) => (
          <a class={`edge ea-${dir}`} href={to === 'centre' ? href() : `#${to}`} data-go={to} data-dir={dir} aria-label={`Go to ${labelOf(to)}`} data-tip={labelOf(to)}>
            <span class="edge-circle"><Icon name={iconOf(to)} /></span>
            <span class="edge-chev"><Icon name={ARROW[dir]} /></span>
          </a>
        ))}
      </section>
    ))}
  </div>
  <div class="hub-veil" aria-hidden="true"><span>Drop to start</span></div>

  <dialog class="picker" data-picker aria-labelledby="picker-title">
    <div class="picker-head">
      <h2 id="picker-title">All tools</h2>
      <button class="icon-btn" type="button" data-picker-close aria-label="Close"><Icon name="xmark" /></button>
    </div>
    <div class="picker-search">
      <label class="visually-hidden" for="picker-search">Search tools</label>
      <Icon name="search" class="picker-search-icon" />
      <input id="picker-search" class="search" type="search" placeholder="Search tools… (e.g. pdf, mp3, resize)" autocomplete="off" autofocus aria-controls="picker-list" data-picker-search />
    </div>
    <div class="picker-list" id="picker-list" data-picker-list>
      {categories.map((c) => (
        <section data-picker-group>
          <h3><Icon name={c.id} />{c.label}</h3>
          <ul>
            {toolsIn(c.id).map((t) => (
              <li data-keywords={`${t.title} ${t.summary} ${c.label} ${t.slug}`.toLowerCase()}>
                <a href={href(t.slug)}>
                  <span class="tile"><Icon name={toolIcon(t)} /></span>
                  <span class="pk-text"><strong>{t.title}</strong><small>{t.summary}</small></span>
                  <ModeBadge mode={t.mode} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="muted pk-empty" data-picker-empty hidden>No tool matches that search.</p>
    </div>
    <dl class="picker-legend">
      <div><dt><Icon name="device" />On your device</dt><dd>Runs in your browser. Your files never leave your device.</dd></div>
      <div><dt><Icon name="cloud" />Cloud · EU</dt><dd>Uploaded to our server in Belgium only after you confirm. Nothing is stored.</dd></div>
    </dl>
  </dialog>

  <div class="home-inner home-work">
    <section class="stage" data-stage hidden aria-label="Your files">
      <div class="stage-bar" data-stage-bar>
        <button class="btn" type="button" data-back>← Back</button>
        <button class="btn btn-ghost" type="button" data-restart>Start over</button>
      </div>
      <div data-chooser>
        <h2 tabindex="-1" data-chooser-title>What do you want to do?</h2>
        <p class="muted" data-file-summary></p>
        <ul class="tool-grid" data-choices>
          {tools.map((t) => (
            <li data-choice={t.slug} hidden>
              <button class="tool-card choice-card" type="button" data-pick={t.slug} data-url={href(t.slug)} data-title={t.title}>
                <span class="tile"><Icon name={toolIcon(t)} /></span>
                <h3>{t.title}</h3>
                <p>{t.summary}</p>
                <span class="card-mode"><ModeBadge mode={t.mode} /></span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="cloud-alt" data-cloud-alt>
        <span>Need a transparent cutout instead?</span>
        <button class="btn" type="button" data-pick="images/remove-background">Remove background <ModeBadge mode="cloud" /></button>
      </div>
    </section>

    <ImageEditor />
  </div>
</div>
</Base>

<style is:global>
  /* Home only. Neutral surfaces; --accent only on the primary button, focus, drop hover and arrow chevrons. */
  main.wide { width: 100%; padding: 0; }
  .home { --gutter: clamp(1rem, 4vw, 3rem); position: relative; }
  .home-inner { width: min(100% - 2 * var(--gutter), 1600px); margin-inline: auto; }
  .home .tile {
    display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 12px; flex: none;
    color: var(--muted); background: var(--surface-2);
  }

  /* Hub: screens stacked in one stage; JS slides them in and out (transform/opacity only). */
  .hub {
    position: relative; isolation: isolate; overflow: hidden; touch-action: none;
    height: 100dvh; /* site chrome floats in the corners (Base.astro, wide) */
  }
  .hub.dragging { user-select: none; }
  .hub:focus-visible { outline-offset: -4px; }
  /* The global rule shows every .mode tooltip inside a focused ancestor; the hub itself is focusable. */
  .hub:focus-visible .mode::after { opacity: 0; transform: translateY(-3px); }
  .hub:focus-visible .mode:hover::after { opacity: 1; transform: none; }
  .screen { position: absolute; inset: 0; background: var(--bg); visibility: hidden; }
  .screen[data-active], .screen.leaving, .screen.peek { visibility: visible; }
  .screen[data-active] { z-index: 1; }
  /* Faint edge washes on the start screen hint that there is more in every direction. */
  .screen-centre::before {
    --edge: color-mix(in srgb, var(--accent) 7%, transparent);
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(var(--edge), transparent 5rem), linear-gradient(to top, var(--edge), transparent 5rem),
      linear-gradient(to right, var(--edge), transparent 5rem), linear-gradient(to left, var(--edge), transparent 5rem);
  }
  .cell-scroll {
    position: absolute; inset: 0; overflow-y: auto; overscroll-behavior: contain; touch-action: none;
    display: flex; flex-direction: column; padding: 5.25rem 5.5rem; scrollbar-width: thin;
  }
  /* Tall content (small screens) scrolls natively; horizontal swipes still reach the hub. */
  .scrolls > .cell-scroll { touch-action: pan-y; }
  /* Auto margins centre short content but keep tall content scrollable from its top. */
  .cell-inner { margin: auto; width: min(100%, 1120px); }
  @media (max-width: 600px) { .cell-scroll { padding: 4.75rem 3.5rem; } }

  /* Edge arrows: big destination icon in a round button, small accent chevron toward the edge. */
  .edge { position: absolute; z-index: 2; display: grid; place-items: center; color: var(--fg); text-decoration: none; }
  .edge-circle {
    display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    border: 1px solid var(--border); background: color-mix(in srgb, var(--surface) 90%, transparent);
    backdrop-filter: blur(8px); box-shadow: var(--shadow); color: var(--muted);
    transition: transform 0.1s ease-out, scale 0.1s ease-out, border-color 0.1s, color 0.1s;
  }
  .edge-circle .icon svg { width: 26px; height: 26px; }
  .edge-chev {
    position: absolute; display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%;
    background: var(--accent); color: var(--accent-fg);
  }
  .home .edge-chev svg { width: 14px; height: 14px; stroke-width: 2.4; }
  .edge:hover .edge-circle, .edge:focus-visible .edge-circle { color: var(--fg); border-color: color-mix(in srgb, var(--fg) 30%, var(--border)); }
  .edge:active .edge-circle { scale: 0.94; }
  .edge:focus-visible { outline: none; }
  .edge:focus-visible .edge-circle { outline: 3px solid var(--accent); outline-offset: 2px; }
  .ea-n { top: 1.4rem; left: 50%; translate: -50% 0; }
  .ea-s { bottom: 1.4rem; left: 50%; translate: -50% 0; }
  .ea-e { right: 1.4rem; top: 50%; translate: 0 -50%; }
  .ea-w { left: 1.4rem; top: 50%; translate: 0 -50%; }
  .ea-n .edge-chev { top: -8px; }
  .ea-s .edge-chev { bottom: -8px; }
  .ea-e .edge-chev { right: -8px; }
  .ea-w .edge-chev { left: -8px; }
  .ea-n:hover .edge-circle { transform: translateY(-2px); }
  .ea-s:hover .edge-circle { transform: translateY(2px); }
  .ea-e:hover .edge-circle { transform: translateX(2px); }
  .ea-w:hover .edge-circle { transform: translateX(-2px); }
  .edge::after {
    content: attr(data-tip); position: absolute; z-index: 3; width: max-content; padding: 0.35rem 0.6rem; border-radius: 8px;
    background: var(--fg); color: var(--bg); font-size: 0.8rem; font-weight: 600; pointer-events: none;
    opacity: 0; transition: opacity 0.1s;
  }
  .edge:hover::after, .edge:focus-visible::after { opacity: 1; }
  .ea-n::after { top: calc(100% + 8px); }
  .ea-s::after { bottom: calc(100% + 8px); }
  .ea-e::after { right: calc(100% + 12px); }
  .ea-w::after { left: calc(100% + 12px); }
  @media (max-width: 600px) {
    .edge-circle { width: 44px; height: 44px; }
    .edge-circle .icon svg { width: 22px; height: 22px; }
    .ea-n { top: 1rem; } .ea-s { bottom: 1rem; } .ea-e { right: 0.6rem; } .ea-w { left: 0.6rem; }
  }

  /* Start screen */
  .centre-inner { width: min(100%, 46rem); text-align: center; }
  .centre-inner h1 { font-size: clamp(1.7rem, 4vw, 2.7rem); line-height: 1.08; letter-spacing: -0.03em; margin: 0 0 0.6rem; }
  .lede { color: var(--muted); margin: 0 auto 1.5rem; max-width: 40ch; }
  .home .hero-drop {
    min-height: clamp(12rem, 32vh, 19rem); align-content: center; gap: 0.8rem;
    padding: 1.75rem 1rem; border-radius: 24px; border: 2px dashed var(--border);
    background: var(--surface); box-shadow: var(--shadow);
    transition: transform 0.12s ease-out, box-shadow 0.12s, border-color 0.12s;
  }
  .home .hero-drop:is(:hover, .over, :focus-within) {
    border-color: var(--accent); background: var(--surface);
    transform: translateY(-2px); box-shadow: 0 16px 40px -20px rgb(0 0 0 / 0.25);
  }
  .hero-drop:has(input:focus-visible) { outline: 3px solid var(--accent); outline-offset: 3px; }
  .hero-drop .drop-title { font-size: clamp(1.3rem, 3vw, 1.75rem); letter-spacing: -0.02em; }
  .drop-btn { pointer-events: none; font-size: 1.02rem; padding: 0.7rem 1.4rem; border-radius: 12px; }
  .drop-types { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.45rem; }
  .drop-type {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.25rem 0.7rem 0.25rem 0.45rem;
    border-radius: 999px; font-size: 0.82rem; font-weight: 600; color: var(--fg); border: 1px solid var(--border);
  }
  .home .drop-type .icon svg { color: var(--muted); width: 16px; height: 16px; }
  .centre-inner .status { min-height: 0; margin: 0.5rem 0 0; }
  .all-tools { margin-top: 1rem; border-radius: 999px; transition: transform 0.1s ease-out, border-color 0.1s; }
  .home .all-tools .icon svg { width: 18px; height: 18px; color: var(--muted); }

  /* Category panels */
  .panel-head { display: flex; align-items: center; gap: 0.75rem; }
  .panel-head h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); letter-spacing: -0.02em; margin: 0; }
  .panel-head h2:focus { outline: none; }
  .panel-blurb { color: var(--muted); margin: 0.4rem 0 1.5rem; }
  .panel-hint { color: var(--muted); font-size: 0.88rem; margin: 1.25rem 0 0; text-align: center; }
  .home .tool-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 0.9rem; }
  /* Size panels to their card count so short categories don't sit in an empty half-screen. */
  .screen-panel .cell-inner { width: min(100%, max(26rem, var(--cols) * 16rem + (var(--cols) - 1) * 0.9rem)); }
  .home .tool-card {
    display: grid; grid-template-columns: auto 1fr; grid-template-areas: 'tile mode' 'title title' 'text text';
    align-content: start; gap: 0.6rem 0.5rem; border-radius: 16px; padding: 1rem 1.1rem 1.15rem;
    transition: transform 0.12s ease-out, border-color 0.12s, box-shadow 0.12s;
  }
  .home .tool-card .tile { grid-area: tile; }
  .card-mode { grid-area: mode; justify-self: end; align-self: start; display: flex; }
  .home .tool-card h3 { grid-area: title; margin-top: 0.15rem; }
  .home .tool-card p { grid-area: text; }
  .home .tool-card:hover { transform: translateY(-2px); box-shadow: 0 12px 28px -16px rgb(0 0 0 / 0.3); }
  .home .tool-card:active { transform: translateY(0) scale(0.99); }
  @media (max-width: 600px) {
    .home .tool-card { grid-template-columns: auto 1fr auto; grid-template-areas: 'tile title mode' 'tile text text'; align-items: start; gap: 0.2rem 0.75rem; padding: 0.85rem 0.9rem; }
    .home .tool-card h3 { margin: 0; font-size: 0.98rem; }
  }

  /* All-tools dialog */
  dialog.picker {
    width: min(94vw, 40rem); max-width: none; max-height: min(86dvh, 46rem); padding: 0; overflow: hidden;
  }
  dialog.picker[open] { display: flex; flex-direction: column; animation: picker-in 0.16s ease-out; }
  @keyframes picker-in { from { opacity: 0; transform: translateY(6px) scale(0.99); } }
  .picker-head { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1rem 0 1.25rem; }
  .picker-head h2 { margin: 0; }
  .picker-search { position: relative; padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); }
  .picker-search-icon { position: absolute; left: 1.85rem; top: 50%; translate: 0 -50%; color: var(--muted); pointer-events: none; }
  .home .picker-search-icon svg { width: 18px; height: 18px; }
  .home .search { width: 100%; margin: 0; border-radius: 999px; padding: 0.6rem 1rem 0.6rem 2.6rem; font-size: 1rem; background: var(--surface); }
  .picker-list { overflow-y: auto; overscroll-behavior: contain; padding: 0.25rem 0.6rem 1rem; }
  .picker-list h3 {
    display: flex; align-items: center; gap: 0.45rem; margin: 0.9rem 0.6rem 0.35rem;
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted);
  }
  .home .picker-list h3 .icon svg { width: 16px; height: 16px; }
  .picker-list ul { list-style: none; margin: 0; padding: 0; }
  .picker-list a {
    display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.6rem; border-radius: 12px;
    color: var(--fg); text-decoration: none; transition: background 0.1s;
  }
  .picker-list a:hover, .picker-list a:focus-visible { background: var(--surface-2); }
  .picker-list a:focus-visible { outline-offset: -2px; }
  .picker-list .tile { width: 2.25rem; height: 2.25rem; border-radius: 10px; }
  .pk-text { display: grid; flex: 1; min-width: 0; line-height: 1.35; }
  .pk-text small { color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pk-empty { padding: 1rem 0.6rem; margin: 0; }
  /* Arrow-key focus moves through rows; their mode tooltips would cover the next row. */
  .picker :focus-visible .mode::after { opacity: 0; transform: translateY(-3px); }
  .picker .mode:hover::after { opacity: 1; transform: none; }
  .picker-legend { display: grid; gap: 0.4rem; margin: 0; padding: 0.75rem 1.25rem 0.9rem; border-top: 1px solid var(--border); font-size: 0.82rem; color: var(--muted); }
  .picker-legend div { display: grid; grid-template-columns: 8.5rem 1fr; gap: 0.5rem; }
  .picker-legend dt { display: flex; align-items: center; gap: 0.35rem; font-weight: 600; color: var(--fg); }
  .home .picker-legend .icon svg { width: 16px; height: 16px; color: var(--muted); }
  .picker-legend dd { margin: 0; }
  @media (max-width: 520px) { .picker-legend div { grid-template-columns: 1fr; gap: 0.1rem; } }

  /* Shown while dragging files over a category panel (the start screen has its own drop zone). */
  .hub-veil {
    position: absolute; inset: 0.75rem; height: calc(100dvh - 1.5rem); z-index: 4; pointer-events: none;
    display: grid; place-items: center; border: 2px dashed var(--accent); border-radius: 24px;
    background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: blur(4px);
    font-size: 1.4rem; font-weight: 650; opacity: 0; transition: opacity 0.12s;
  }
  .home[data-dragging]:not([data-at='centre']) .hub-veil { opacity: 1; }
  .home:has(> .hub[hidden]) .hub-veil { display: none; }

  /* Handoff stage (chooser, embedded tool) and the image editor. */
  .home-work { padding: 2rem 0 4rem; max-width: 1280px; }
  .home-work:not(:has(> [data-stage]:not([hidden]), > [data-image-editor]:not([hidden]))) { display: none; }
  .stage-bar { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin-bottom: 1rem; }
  .stage-bar [data-restart] { margin-left: auto; }
  .stage-bar:not(:has(button:not([hidden]))) { display: none; }
  .choice-card { width: 100%; font: inherit; text-align: left; cursor: pointer; }
  .stage h2[tabindex]:focus { outline: none; }
  .cloud-alt { display: flex; gap: 0.5rem 0.75rem; align-items: center; flex-wrap: wrap; margin-bottom: 1rem; color: var(--muted); font-size: 0.93rem; }
  .tool-frame { display: block; width: 100%; height: 70vh; border: 0; }
</style>

<script>
  import { el, sniff, UserError } from '../lib/tool';

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;

  // All-tools dialog: live filter, ↑/↓ moves through results, Enter opens, Escape closes (native).
  const picker = $<HTMLDialogElement>('[data-picker]');
  const pickSearch = $<HTMLInputElement>('[data-picker-search]');
  const pickRows = [...picker.querySelectorAll<HTMLElement>('li[data-keywords]')];
  const pickGroups = [...picker.querySelectorAll<HTMLElement>('[data-picker-group]')];
  const pickEmpty = $('[data-picker-empty]');
  const visiblePicks = () => [...picker.querySelectorAll<HTMLAnchorElement>('li[data-keywords]:not([hidden]) a')];

  function filterPicks() {
    const terms = pickSearch.value.toLowerCase().split(/\s+/).filter(Boolean);
    for (const li of pickRows) li.hidden = !terms.every((t) => li.dataset.keywords!.includes(t));
    for (const g of pickGroups) g.hidden = !g.querySelector('li:not([hidden])');
    pickEmpty.hidden = pickRows.some((li) => !li.hidden);
  }
  pickSearch.addEventListener('input', filterPicks);
  $('[data-all-tools]').addEventListener('click', () => {
    pickSearch.value = '';
    filterPicks();
    picker.showModal();
  });
  $('[data-picker-close]').addEventListener('click', () => picker.close());
  // The dialog has no padding, so a click on the element itself is a click on the backdrop.
  picker.addEventListener('click', (e) => {
    if (e.target === picker) picker.close();
  });
  picker.addEventListener('keydown', (e) => {
    const links = visiblePicks();
    const i = links.indexOf(document.activeElement as HTMLAnchorElement);
    if (e.key === 'Enter' && e.target === pickSearch) {
      e.preventDefault();
      links[0]?.click();
    } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      const next = e.key === 'ArrowDown' ? Math.min(i + 1, links.length - 1) : i - 1;
      (next < 0 ? pickSearch : links[next])?.focus();
    }
  });

  // Hub: one full-size stage; screens slide in from the edge in the direction of travel.
  type Dir = 'n' | 'e' | 's' | 'w';
  const home = $('.home');
  const hub = $('[data-hub]');
  const screens = new Map([...hub.querySelectorAll<HTMLElement>('[data-screen]')].map((s) => [s.dataset.screen!, s]));
  const DIRS: Dir[] = ['n', 'e', 's', 'w'];
  const KEY_DIR: Record<string, Dir> = { ArrowUp: 'n', ArrowDown: 's', ArrowLeft: 'w', ArrowRight: 'e' };
  const VEC: Record<Dir, [number, number]> = { n: [0, -1], s: [0, 1], e: [1, 0], w: [-1, 0] };
  const EASE = 'cubic-bezier(0.33, 1, 0.68, 1)';
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let active = 'centre';
  let running: Animation[] = [];
  let leaving: HTMLElement | undefined;
  let peeking: HTMLElement | undefined;

  const neighbour = (from: string, dir: Dir) => screens.get(from)?.dataset[dir];
  const dirTo = (from: string, to: string) => DIRS.find((d) => neighbour(from, d) === to);
  const screenFromHash = () => (screens.has(location.hash.slice(1)) ? location.hash.slice(1) : 'centre');
  const scrollerOf = (id: string) => screens.get(id)!.querySelector<HTMLElement>('.cell-scroll')!;
  const tf = (xPct: number, yPct: number, x = 0, y = 0) => `translate(calc(${xPct}% + ${x}px), calc(${yPct}% + ${y}px))`;

  function setActive(id: string) {
    active = id;
    home.dataset.at = id;
    for (const [key, s] of screens) {
      s.inert = key !== id;
      s.toggleAttribute('data-active', key === id);
    }
    // Keep the URL shareable without adding a history entry per move.
    if (current === 'home' && screenFromHash() !== id) history.replaceState(history.state, '', id === 'centre' ? location.pathname + location.search : `#${id}`);
  }

  /** Jump every running transition to its end state. */
  function settle() {
    running.forEach((a) => a.cancel());
    running = [];
    leaving?.classList.remove('leaving');
    peeking?.classList.remove('peek');
    leaving = peeking = undefined;
    for (const s of screens.values()) s.style.transform = '';
  }

  /** Show `to`, sliding it in from the `dir` edge; screens that aren't neighbours cross-fade. (x, y): drag offset in px. */
  function navigate(to: string, dir = dirTo(active, to), x = 0, y = 0) {
    if (to === active) return;
    const from = screens.get(active)!;
    const target = screens.get(to)!;
    settle();
    setActive(to);
    if (reduceMotion.matches) return;
    leaving = from;
    from.classList.add('leaving');
    const opts: KeyframeAnimationOptions = { duration: 280, easing: EASE };
    if (dir) {
      const [vx, vy] = VEC[dir];
      running = [
        from.animate([{ transform: tf(0, 0, x, y), opacity: 1 }, { transform: tf(-vx * 100, -vy * 100), opacity: 0.4 }], opts),
        target.animate([{ transform: tf(vx * 100, vy * 100, x, y) }, { transform: tf(0, 0) }], opts),
      ];
    } else {
      running = [
        from.animate([{ opacity: 1 }, { opacity: 0 }], opts),
        target.animate([{ opacity: 0, transform: 'scale(0.98)' }, { opacity: 1, transform: 'none' }], opts),
      ];
    }
    running[0].onfinish = () => leaving === from && settle();
  }

  /** Navigate and, when focus is inside the hub, carry it along so it isn't lost in an inert screen. */
  function go(to: string, dir?: Dir) {
    const focusInside = hub.contains(document.activeElement) && document.activeElement !== hub;
    navigate(to, dir);
    if (focusInside) (to === 'centre' ? hub : screens.get(to)!.querySelector<HTMLElement>('h2[tabindex]')!).focus({ preventScroll: true });
  }

  /** True when the active screen's content can still scroll toward `dir` (only vertical content scrolls). */
  function canScroll(dir: Dir) {
    const sc = scrollerOf(active);
    if (dir === 's') return sc.scrollTop + sc.clientHeight < sc.scrollHeight - 1;
    if (dir === 'n') return sc.scrollTop > 0;
    return false;
  }

  // Which screens have content taller than the stage (they get native vertical touch scrolling).
  const ro = new ResizeObserver(() => {
    for (const s of screens.values()) {
      const sc = s.querySelector<HTMLElement>('.cell-scroll')!;
      s.classList.toggle('scrolls', sc.scrollHeight > sc.clientHeight + 1);
    }
  });
  for (const s of screens.values()) {
    ro.observe(s.querySelector('.cell-scroll')!);
    ro.observe(s.querySelector('.cell-inner')!);
  }

  hub.addEventListener('keydown', (e) => {
    if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
    if ((e.target as Element).closest('input, textarea, select, [contenteditable]')) return;
    if (e.key === 'Escape' || e.key === 'Home') {
      e.preventDefault();
      return go('centre');
    }
    const dir = KEY_DIR[e.key];
    if (!dir) return;
    e.preventDefault();
    // Tall screens (small viewports) scroll their own content before moving on.
    if (canScroll(dir)) {
      const sc = scrollerOf(active);
      return sc.scrollBy({ top: (dir === 's' ? 1 : -1) * sc.clientHeight * 0.8, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    }
    const next = neighbour(active, dir);
    if (next) go(next, dir);
  });

  // Wheel: a mouse notch or ~60 px of trackpad travel moves one screen, then input is ignored until the
  // wheel has been idle for 180 ms, so trackpad inertia can't trigger a second move.
  let wheelSum = 0;
  let wheelDir: Dir | undefined;
  let wheelLocked = false;
  let wheelScrolled = false;
  let wheelIdle = 0;
  hub.addEventListener(
    'wheel',
    (e) => {
      if (e.ctrlKey) return; // pinch zoom
      clearTimeout(wheelIdle);
      wheelIdle = window.setTimeout(() => {
        wheelLocked = wheelScrolled = false;
        wheelSum = 0;
      }, 180);
      const unit = e.deltaMode === WheelEvent.DOM_DELTA_LINE ? 40 : e.deltaMode === WheelEvent.DOM_DELTA_PAGE ? hub.clientHeight : 1;
      const horizontal = Math.abs(e.deltaX) > Math.abs(e.deltaY);
      const delta = (horizontal ? e.deltaX : e.deltaY) * unit;
      if (!delta) return;
      const dir: Dir = horizontal ? (delta > 0 ? 'e' : 'w') : delta > 0 ? 's' : 'n';
      if (wheelLocked) return e.preventDefault();
      if (canScroll(dir)) {
        wheelScrolled = true;
        return;
      }
      // Content that just scrolled to its edge needs a fresh gesture to navigate.
      if (wheelScrolled) return e.preventDefault();
      const next = neighbour(active, dir);
      e.preventDefault();
      if (!next) return;
      if (dir !== wheelDir) {
        wheelDir = dir;
        wheelSum = 0;
      }
      wheelSum += Math.abs(delta);
      if (wheelSum < 60) return;
      wheelLocked = true;
      wheelSum = 0;
      go(next, dir);
    },
    { passive: false },
  );

  // Touch/pen swipes: the screen follows the finger (rubber-banded where there is nothing to go to).
  type Drag = { id: number; x0: number; y0: number; axis?: 'x' | 'y'; d: number; v: number; t: number; dir?: Dir; next?: string };
  let drag: Drag | undefined;
  let dragFrame = 0;
  let suppressClick = false;
  let swiped = false;

  function paintDrag() {
    dragFrame = 0;
    if (!drag?.axis) return;
    const cur = screens.get(active)!;
    const along = drag.next ? drag.d : drag.d * 0.3;
    const [x, y] = drag.axis === 'x' ? [along, 0] : [0, along];
    cur.style.transform = tf(0, 0, x, y);
    const peek = drag.next ? screens.get(drag.next) : undefined;
    if (peeking && peeking !== peek) {
      peeking.classList.remove('peek');
      peeking.style.transform = '';
    }
    peeking = peek;
    if (peek && drag.dir) {
      const [vx, vy] = VEC[drag.dir];
      peek.classList.add('peek');
      peek.style.transform = tf(vx * 100, vy * 100, x, y);
    }
  }

  function snapBack() {
    const cur = screens.get(active)!;
    const from = cur.style.transform;
    const peek = peeking;
    const peekFrom = peek?.style.transform;
    settle();
    if (reduceMotion.matches || !from) return;
    const opts: KeyframeAnimationOptions = { duration: 200, easing: EASE };
    running = [cur.animate([{ transform: from }, { transform: 'none' }], opts)];
    if (peek && peekFrom && drag?.dir) {
      const [vx, vy] = VEC[drag.dir];
      peeking = peek;
      peek.classList.add('peek');
      running.push(peek.animate([{ transform: peekFrom }, { transform: tf(vx * 100, vy * 100) }], { ...opts, fill: 'forwards' }));
      running[1].onfinish = () => peeking === peek && settle();
    }
  }

  hub.addEventListener('pointerdown', (e) => {
    suppressClick = swiped = false;
    if (e.pointerType === 'mouse' || !e.isPrimary || current !== 'home') return;
    settle();
    drag = { id: e.pointerId, x0: e.clientX, y0: e.clientY, d: 0, v: 0, t: e.timeStamp };
  });
  hub.addEventListener('pointermove', (e) => {
    if (!drag || e.pointerId !== drag.id) return;
    const dx = e.clientX - drag.x0;
    const dy = e.clientY - drag.y0;
    if (!drag.axis) {
      if (Math.hypot(dx, dy) < 10) return;
      drag.axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
      hub.setPointerCapture(e.pointerId);
      hub.classList.add('dragging');
    }
    const d = drag.axis === 'x' ? dx : dy;
    const dt = e.timeStamp - drag.t;
    if (dt > 0) drag.v = 0.8 * ((d - drag.d) / dt) + 0.2 * drag.v;
    drag.t = e.timeStamp;
    drag.d = d;
    // The finger moves opposite to the direction of travel.
    drag.dir = drag.axis === 'x' ? (d < 0 ? 'e' : 'w') : d < 0 ? 's' : 'n';
    drag.next = neighbour(active, drag.dir);
    dragFrame ||= requestAnimationFrame(paintDrag);
  });
  function endDrag(e: PointerEvent) {
    if (!drag || e.pointerId !== drag.id) return;
    const done = drag;
    cancelAnimationFrame(dragFrame);
    dragFrame = 0;
    hub.classList.remove('dragging');
    if (!done.axis) return void (drag = undefined);
    suppressClick = true;
    // Cancelled: the browser took the gesture for native scrolling; touchend decides edge swipes.
    swiped = e.type === 'pointerup';
    const commit = e.type === 'pointerup' && done.next && (Math.abs(done.d) > 50 || (Math.abs(done.v) > 0.4 && Math.abs(done.d) > 15));
    if (commit) {
      const along = done.d;
      navigate(done.next!, done.dir, done.axis === 'x' ? along : 0, done.axis === 'y' ? along : 0);
    } else {
      paintDrag();
      snapBack();
    }
    drag = undefined;
  }
  hub.addEventListener('pointerup', endDrag);
  hub.addEventListener('pointercancel', endDrag);
  // A swipe that started on a link or the drop zone must not also click it.
  hub.addEventListener(
    'click',
    (e) => {
      if (!suppressClick) return;
      suppressClick = false;
      e.preventDefault();
      e.stopPropagation();
    },
    true,
  );
  // Tall screens pan vertically natively (the pointer is cancelled), so decide edge swipes on touchend.
  let touch: { y: number; top: boolean; bottom: boolean } | undefined;
  hub.addEventListener(
    'touchstart',
    (e) => {
      touch = undefined;
      if (!screens.get(active)!.classList.contains('scrolls') || e.touches.length > 1) return;
      touch = { y: e.touches[0].clientY, top: !canScroll('n'), bottom: !canScroll('s') };
    },
    { passive: true },
  );
  hub.addEventListener(
    'touchend',
    (e) => {
      if (!touch || swiped || current !== 'home') return;
      const dy = e.changedTouches[0].clientY - touch.y;
      const dir: Dir | undefined = dy > 60 && touch.top && !canScroll('n') ? 'n' : dy < -60 && touch.bottom && !canScroll('s') ? 's' : undefined;
      touch = undefined;
      if (!dir) return;
      const next = neighbour(active, dir);
      if (next) go(next, dir);
    },
    { passive: true },
  );

  // Edge arrows, header category links and the brand link move the hub instead of navigating.
  document.addEventListener('click', (e) => {
    if (current !== 'home' || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[href]');
    if (!a || picker.contains(a)) return;
    const id = a.dataset.go ?? (a.pathname === location.pathname && a.search === location.search ? a.hash.slice(1) || 'centre' : undefined);
    if (!id || !screens.has(id)) return;
    e.preventDefault();
    go(id, a.dataset.dir as Dir | undefined);
  });

  // Universal drop zone → chooser, embedded tool or image editor.
  // Files are handed over in memory only: nothing is persisted or uploaded.
  type View = 'home' | 'choose' | 'tool' | 'editor';
  type Kind = 'image' | 'pdf' | 'audio' | 'json' | 'js' | 'gzip' | 'other';

  const homeParts = document.querySelectorAll<HTMLElement>('[data-home]');
  const drop = $('[data-hero-drop]');
  const input = $<HTMLInputElement>('[data-hero-input]');
  const status = $('[data-drop-status]');
  const stage = $('[data-stage]');
  const back = $<HTMLButtonElement>('[data-back]');
  const restart = $<HTMLButtonElement>('[data-restart]');
  const chooser = $('[data-chooser]');
  const cloudAlt = $('[data-cloud-alt]');
  const editor = $('[data-image-editor]');

  let files: File[] = [];
  let current: View = 'home';
  let frame: HTMLIFrameElement | undefined;
  let editorOpen = false;

  // Each view below home is a history entry, so the browser back/forward buttons step through them.
  // Files live only in memory: entries restored without them (e.g. after reload) fall back to home.
  type Entry = { view: Exclude<View, 'home'>; slug?: string; depth: number };
  const entry = () => history.state as Entry | null;
  const push = (view: Entry['view'], slug?: string) => history.pushState({ view, slug, depth: (entry()?.depth ?? 0) + 1 } satisfies Entry, '');

  const AUDIO_EXT = /\.(m4a|aac|mp3|wav|ogg|oga|opus|flac|weba)$/i;
  // ISO-BMFF brands that carry audio; excludes HEIC/AVIF (also "ftyp").
  const AUDIO_BRAND = /^(M4A |M4B |M4P |mp4[12]|isom|iso[2-6]|dash|3gp)/;

  async function kindOf(f: File): Promise<Kind> {
    const t = await sniff(f);
    if (t === 'jpeg' || t === 'png' || t === 'webp') return 'image';
    if (t === 'pdf' || t === 'gzip') return t;
    if (t === 'zip') return 'other';
    const b = new Uint8Array(await f.slice(0, 12).arrayBuffer());
    const s = (o: number, str: string) => [...str].every((c, i) => b[o + i] === c.charCodeAt(0));
    const ascii = String.fromCharCode(...b.subarray(8, 12));
    if (s(0, 'ID3') || s(0, 'OggS') || s(0, 'fLaC') || (s(0, 'RIFF') && s(8, 'WAVE')) || (s(4, 'ftyp') && AUDIO_BRAND.test(ascii))) return 'audio';
    if (b[0] === 0xff && (b[1] & 0xe0) === 0xe0) return 'audio'; // MPEG/ADTS frame sync
    if (f.type.startsWith('audio/') || AUDIO_EXT.test(f.name)) return 'audio';
    if (f.type === 'application/json' || /\.json$/i.test(f.name)) return 'json';
    if (/^(text|application)\/javascript$/.test(f.type) || /\.[mc]?js$/i.test(f.name)) return 'js';
    return 'other';
  }

  function show(view: View) {
    if (view !== 'tool') {
      frame?.remove();
      frame = undefined;
    }
    current = view;
    homeParts.forEach((p) => (p.hidden = view !== 'home'));
    chooser.hidden = view !== 'choose';
    cloudAlt.hidden = !(view === 'editor' && files.length === 1);
    editor.hidden = view !== 'editor';
    // The editor has its own close control.
    back.hidden = view === 'editor';
    restart.hidden = !(view === 'tool' && (entry()?.depth ?? 0) > 1);
    stage.hidden = view === 'home' || (view === 'editor' && cloudAlt.hidden);
  }

  /** Leave to home by unwinding our history entries, so Back doesn't return into a cleared view. */
  function goHome() {
    files = [];
    const depth = entry()?.depth ?? 0;
    if (depth > 0) history.go(-depth);
    else showHome();
  }

  /** Back on the hub at the screen the files were dropped on (kept in the URL hash). */
  function showHome() {
    show('home');
    settle();
    setActive(screenFromHash());
    (active === 'centre' ? input : hub).focus({ preventScroll: true });
  }

  function choose(slugs: string[]) {
    if (slugs.length === 1) return openTool(slugs[0]);
    for (const li of document.querySelectorAll<HTMLElement>('[data-choice]')) li.hidden = !slugs.includes(li.dataset.choice!);
    const list = $('[data-choices]');
    slugs.forEach((s) => list.append(list.querySelector(`[data-choice="${s}"]`)!));
    $('[data-file-summary]').textContent = files.length === 1 ? files[0].name : `${files.length} files`;
    push('choose');
    showChooser();
  }

  function showChooser() {
    show('choose');
    $('[data-chooser-title]').focus();
  }

  function openTool(slug: string, record = true) {
    const pick = $(`[data-pick="${slug}"][data-url]`);
    if (record) push('tool', slug);
    frame?.remove();
    frame = el('iframe', { src: `${pick.dataset.url}?embed`, title: pick.dataset.title!, className: 'tool-frame' });
    const f = frame;
    f.addEventListener('load', () => onFrameLoad(f));
    show('tool');
    stage.append(f);
    stage.scrollIntoView({ block: 'start' });
    back.focus();
  }

  function onFrameLoad(f: HTMLIFrameElement) {
    const win = f.contentWindow as (Window & typeof globalThis) | null;
    const doc = f.contentDocument;
    if (!win || !doc?.querySelector('[data-tool]')) return;
    // ToolShell pages take files through [data-input]; text tools through [data-file].
    const target = doc.querySelector<HTMLInputElement>('[data-input], [data-file]');
    if (target) {
      const dt = new win.DataTransfer();
      // Rebuild each File in the frame's realm so arrayBuffer() returns that realm's ArrayBuffer;
      // libraries' `instanceof ArrayBuffer` checks fail otherwise (e.g. pdf-lib).
      (target.multiple ? files : files.slice(0, 1)).forEach((file) => dt.items.add(new win.File([file], file.name, { type: file.type, lastModified: file.lastModified })));
      target.files = dt.files;
      target.dispatchEvent(new win.Event('change'));
    }
    new win.ResizeObserver(() => (f.style.height = `${Math.ceil(doc.documentElement.getBoundingClientRect().height)}px`)).observe(doc.documentElement);
    // Site links (privacy, settings) leave the embed instead of navigating inside it.
    doc.addEventListener('click', (e) => {
      const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href]');
      if (!a || a.download || a.getAttribute('href')!.startsWith('#') || e.ctrlKey || e.metaKey || e.shiftKey) return;
      e.preventDefault();
      location.href = a.href;
    });
  }

  async function openEditor() {
    push('editor');
    show('editor');
    try {
      await (await import('../lib/editor')).openImageEditor(files);
      editorOpen = true;
    } catch (err) {
      console.error(err);
      goHome();
      status.textContent = err instanceof UserError ? err.message : 'The image editor could not be loaded. Please reload the page.';
    }
  }

  async function handle(list: File[]) {
    if (!list.length) return;
    if (picker.open) picker.close();
    status.textContent = '';
    let kinds: Kind[];
    try {
      kinds = await Promise.all(list.map(kindOf));
    } catch {
      status.textContent = 'Could not read that file.';
      return;
    }
    files = list;
    const kind = kinds.every((k) => k === kinds[0]) ? kinds[0] : 'other';
    const single = list.length === 1;
    if (kind === 'image') return openEditor();
    if (kind === 'audio') return openTool('audio/convert');
    if (kind === 'pdf') return choose(single ? ['pdf/split', 'pdf/organize', 'pdf/compress'] : ['pdf/merge', 'files/zip']);
    if (single && kind === 'json') return openTool('text/json');
    if (single && kind === 'js') return openTool('text/js-minify');
    if (single && kind === 'gzip') return openTool('files/gzip');
    choose(single ? ['files/zip', 'files/gzip'] : ['files/zip']);
  }

  input.addEventListener('change', () => {
    handle([...(input.files ?? [])]);
    input.value = '';
  });
  // Accept drops anywhere on the home view so a near miss doesn't open the file in the browser.
  const hasFiles = (e: DragEvent) => !!e.dataTransfer?.types.includes('Files');
  const setDragging = (on: boolean) => {
    drop.classList.toggle('over', on);
    home.toggleAttribute('data-dragging', on);
  };
  document.addEventListener('dragover', (e) => {
    if (!hasFiles(e)) return;
    e.preventDefault();
    if (current === 'home') setDragging(true);
    else e.dataTransfer!.dropEffect = 'none';
  });
  document.addEventListener('dragleave', (e) => {
    if (!e.relatedTarget) setDragging(false);
  });
  document.addEventListener('drop', (e) => {
    if (!hasFiles(e)) return;
    e.preventDefault();
    setDragging(false);
    if (current === 'home') handle([...e.dataTransfer!.files]);
  });
  document.addEventListener('paste', (e) => {
    const pasted = [...(e.clipboardData?.files ?? [])];
    if (current === 'home' && pasted.length) {
      e.preventDefault();
      handle(pasted);
    }
  });

  stage.addEventListener('click', (e) => {
    const pick = (e.target as Element).closest<HTMLElement>('[data-pick]');
    if (pick) openTool(pick.dataset.pick!);
  });
  back.addEventListener('click', () => history.back());
  restart.addEventListener('click', goHome);
  editor.addEventListener('editor:close', () => {
    editorOpen = false;
    goHome();
  });
  addEventListener('popstate', () => {
    const e = entry();
    // Home (possibly with a #category from a header link or Back).
    if (!e) return showHome();
    if (!files.length || (e.view === 'editor' && !editorOpen)) {
      history.replaceState(null, '');
      return showHome();
    }
    if (e.view === 'choose') showChooser();
    else if (e.view === 'tool') openTool(e.slug!, false);
    else show('editor');
  });
  // A reload keeps history.state but not the in-memory files.
  if (entry()) history.replaceState(null, '');
  setActive(screenFromHash());
</script>
