---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ModeBadge from '../components/ModeBadge.astro';
import SettingsForm from '../components/SettingsForm.astro';
import { categories, href, toolHref, tools, type Category } from '../tools';

const toolsIn = (c: Category) => tools.filter((t) => t.category === c);
const debrisExtensions = (
  'jpg jpeg png webp svg pdf ' +
  'm4a aac mp3 wav ogg oga opus flac webm ' +
  'zip 7z rar tar gz tgz xz txz bz2 tbz tbz2 iso cab gpx ' +
  'txt csv tsv log json js mjs cjs jsx ts tsx htm html css scss xml yaml yml toml ini env sh py rb go rs java c h cpp sql md markdown'
).split(' ');
// Upper teeth along the top lip: longest in the middle, clipped by the mouth outline.
const teeth = Array.from({ length: 11 }, (_, i) => {
  const w = 688 / 11, x = 24 + i * w, t = (i - 5) / 5, h = 50 + 24 * (1 - t * t);
  return `M${x + 3} 20h${w - 6}v${h - 14}q0 14-${(w - 6) / 2} 14t-${(w - 6) / 2}-14Z`;
}).join('');
---
<Base title="Tools · fast, private file tools" wide>
<div class="home" data-at="centre">
  <header class="topbar">
    <div class="tb-acts">
      <button class="tb-btn" type="button" data-outputs-open aria-haspopup="dialog" aria-label="Outputs" title="Outputs"><Icon name="download" /><span class="tb-label">Outputs</span><span class="out-count" data-out-count hidden></span></button>
      <button class="tb-btn" type="button" data-settings-open aria-haspopup="dialog" aria-label="Settings" title="Settings"><Icon name="settings" /></button>
    </div>
  </header>

  <div class="hub" data-hub tabindex="-1" role="region" aria-label="Tools">
    <section class="screen screen-centre" data-screen="centre" aria-label="Start">
      <div class="extension-field" aria-hidden="true">
        {debrisExtensions.map((ext) => (
          <div class="extension-slot" style={`order:${Math.floor(Math.random() * 100000)};--x:${Math.random()};--y:${Math.random()};font-size:${0.62 + Math.random() * 0.13}rem;--speed:${48 + Math.random() * 77}s;--delay:-${Math.random() * 123}s;--tilt:${Math.random() * 16 - 8}deg`}><span>.{ext}</span></div>
        ))}
      </div>
      <div class="cell-scroll">
        <div class="cell-inner centre-inner">
          <h1>A collection of <span class="eye-word">t<span class="visually-hidden">oo</span><svg class="word-eyes" viewBox="58 4 39 25" aria-hidden="true"><g fill="#fff" stroke="currentColor" stroke-width="3.5"><ellipse cx="67.5" cy="17.5" rx="7" ry="8.5"/><ellipse cx="87.5" cy="16.5" rx="7" ry="9.5"/></g><g class="eye-pupils" fill="#17181a"><ellipse cx="67.5" cy="17.5" rx="2.5" ry="4"/><ellipse cx="87.5" cy="16.5" rx="2.5" ry="4"/></g></svg>ls</span> that respect your privacy.</h1>
          <nav class="jump" aria-label="Categories">
            {categories.map((c) => (
              <a class="jump-chip" href={`#${c.id}`} data-go={c.id} title={c.blurb} style={`--cat: var(--c-${c.id})`}><Icon name={c.id} />{c.label}</a>
            ))}
          </nav>
          <p class="drop-instruction" id="drop-anywhere">Feed me files<svg class="drop-arrow" viewBox="0 0 60 48" aria-hidden="true"><path d="M4 6c22-4 40 6 42 34m-10-8 10 10 8-13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg></p>
          <label class="drop hero-drop" data-hero-drop>
            <input type="file" multiple data-hero-input aria-labelledby="drop-anywhere" aria-describedby="drop-hint" />
            <svg class="mouth-shape" viewBox="0 0 736 280" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <path id="drop-mouth-outline" d="M34 58C160 30 576 30 702 58C716 61 722 72 718 86C696 196 548 272 368 272C188 272 40 196 18 86C14 72 20 61 34 58Z" />
                <clipPath id="drop-mouth-clip"><use href="#drop-mouth-outline" /></clipPath>
                <radialGradient id="drop-throat" cx="50%" cy="42%" r="60%"><stop offset="0" stop-color="#5c0f22" /><stop offset="1" stop-color="#22050c" /></radialGradient>
              </defs>
              <use href="#drop-mouth-outline" fill="url(#drop-throat)" />
              <g clip-path="url(#drop-mouth-clip)">
                <path fill="#e2667e" d="M176 290C196 222 300 208 368 232C436 208 540 222 560 290Z" />
                <path d="M368 236V272" fill="none" stroke="#a83a52" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                <path fill="#fff" stroke="#c9c4bc" stroke-width="1.5" vector-effect="non-scaling-stroke" d={teeth} />
              </g>
              <use href="#drop-mouth-outline" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
            </svg>
            <span class="btn btn-primary drop-btn" aria-hidden="true"><Icon name="upload" />Choose files</span>
            <span class="drop-hint" id="drop-hint">Or paste from the clipboard. We open the right tool with your files.</span>
          </label>
          <p class="status" data-drop-status role="status" aria-live="polite"></p>
          <div class="centre-actions">
            <button class="btn all-tools" type="button" data-all-tools><Icon name="arrow-down" />See all tools</button>
          </div>
        </div>
        <section class="cats" id="all-tools" aria-labelledby="cats-title">
          <h2 id="cats-title">Everything you can do</h2>
          <div class="cat-grid">
            {categories.map((c) => (
              <article class="cat-card" style={`--cat: var(--c-${c.id})`}>
                <a class="cc-head" href={`#${c.id}`} data-go={c.id}>
                  <span class="tile"><Icon name={c.id} /></span>
                  <span class="cc-title"><strong>{c.label}</strong><small>{c.blurb}</small></span>
                  <Icon name="arrow-right" class="cc-go" />
                </a>
                <ul class="cc-tools">
                  {toolsIn(c.id).map((t) => (
                    <li>
                      <a href={toolHref(t)} data-open-screen={c.id} data-open-slug={t.slug}>
                        <span class="cc-text"><strong>{t.title}</strong><small>{t.summary}</small></span>
                        {t.mode === 'cloud' && <ModeBadge mode={t.mode} />}
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
          <dl class="cats-legend">
            <div><dt><Icon name="device" />On your device</dt><dd>Every tool runs in your browser and uploads nothing, unless it is marked:</dd></div>
            <div><dt><Icon name="cloud" />Cloud · EU</dt><dd>Uploaded to our server in Belgium only after you confirm. Nothing is stored.</dd></div>
          </dl>
          <p class="cats-more"><a href={href('privacy')}><Icon name="shield" />Privacy: how we check</a></p>
        </section>
      </div>
    </section>

    {categories.map((c) => (
      <section class="screen screen-cat" data-screen={c.id} data-app={href(c.app)} aria-label={c.label}>
        <div class="cat-body" data-panel></div>
      </section>
    ))}
  </div>
  <div class="hub-veil" aria-hidden="true"><span>Drop to open the right tool</span></div>
  <div class="drag-glow" data-drag-glow aria-hidden="true"></div>
  <div class="snack" data-snack aria-hidden="true">
    <svg viewBox="0 0 64 64" data-kind="donut">
      <g stroke="#17181a" stroke-width="2.2" stroke-linejoin="round" fill-rule="evenodd">
        <path fill="#dfa35a" d="M4 32a28 28 0 1 0 56 0a28 28 0 1 0-56 0ZM24 32a8 8 0 1 0 16 0a8 8 0 1 0-16 0Z" />
        <path fill="#f27fa6" d="M32 9C44 9 54 16 55 27C56 33 52 34 52 38C52 44 47 46 42 50C37 54 28 55 22 51C16 48 11 43 10 36C9 30 12 29 11 24C12 15 21 9 32 9ZM22 32a10 10 0 1 0 20 0a10 10 0 1 0-20 0Z" />
      </g>
      <g stroke-width="2.6" stroke-linecap="round">
        <path stroke="#fff" d="M20 18l4 2M41 40l3 3M15 35l1 4" />
        <path stroke="#ffd43b" d="M33 15l4-1M45 25l2 4M26 46l4 1" />
        <path stroke="#4dabf7" d="M24 25l-2 3M47 34l-3 2M36 47l3-2" />
        <path stroke="#69db7c" d="M40 19l3 2M14 28l3-1" />
      </g>
    </svg>
    <svg viewBox="0 0 64 64" data-kind="pretzel">
      <g fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path stroke="#17181a" stroke-width="10.5" d="M32 21C27 9 8 9 7 26C6 40 18 50 32 50C46 50 58 40 57 26C56 9 37 9 32 21C30 31 22 37 17 43M32 21C34 31 42 37 47 43" />
        <path stroke="#a8561f" stroke-width="6.5" d="M32 21C27 9 8 9 7 26C6 40 18 50 32 50C46 50 58 40 57 26C56 9 37 9 32 21C30 31 22 37 17 43M32 21C34 31 42 37 47 43" />
      </g>
      <path stroke="#fff" stroke-width="2" stroke-linecap="round" d="M12 22l1 1M20 13l1 0M43 13l1 1M52 22l0 1M9 33l1 0M55 34l0 1M24 49l1 0M40 49l1 0M29 31l1 1M36 30l0 1" />
    </svg>
    <svg viewBox="0 0 64 64" data-kind="beer">
      <g stroke-linecap="round" stroke-linejoin="round">
        <path fill="none" stroke="#17181a" stroke-width="9" d="M48 25h4q6 0 6 6v8q0 7-7 7h-3" />
        <path fill="none" stroke="#e6eef2" stroke-width="5" d="M48 25h4q6 0 6 6v8q0 7-7 7h-3" />
        <rect x="11" y="17" width="38" height="42" rx="5" fill="#f2a91c" stroke="#17181a" stroke-width="2.2" />
        <g fill="#fff" opacity="0.35"><ellipse cx="20" cy="33" rx="3" ry="5" /><ellipse cx="30" cy="33" rx="3" ry="5" /><ellipse cx="40" cy="33" rx="3" ry="5" /><ellipse cx="20" cy="48" rx="3" ry="5" /><ellipse cx="30" cy="48" rx="3" ry="5" /><ellipse cx="40" cy="48" rx="3" ry="5" /></g>
        <path fill="#fff" stroke="#17181a" stroke-width="2.2" d="M9 20q0-7 7-7q2-6 9-5q4-5 10-1q6-3 10 3q7 0 7 7q0 5-5 5q-1 4-5 2q-3 3-7 0H14q-5 0-5-4Z" />
      </g>
    </svg>
  </div>
  <p class="out-toast" data-out-toast role="status" aria-live="polite" hidden></p>

  <dialog class="picker settings-dialog" data-settings-dialog aria-labelledby="settings-title">
    <div class="picker-head">
      <h2 id="settings-title">Settings</h2>
      <button class="icon-btn" type="button" data-dialog-close aria-label="Close"><Icon name="xmark" /></button>
    </div>
    <div class="dialog-body">
      <p class="muted">Saved in this browser only. Documents and upload consent are never saved.</p>
      <SettingsForm />
    </div>
  </dialog>

  <dialog class="picker outputs" data-outputs aria-labelledby="outputs-title">
    <div class="picker-head">
      <h2 id="outputs-title">Outputs <span class="muted out-total" data-out-total></span></h2>
      <button class="icon-btn" type="button" data-dialog-close aria-label="Close"><Icon name="xmark" /></button>
    </div>
    <ul class="out-list" data-out-list aria-label="Created files"></ul>
    <p class="muted out-empty" data-out-empty>Files you create in any tool are collected here until you leave or reload this page. Nothing is uploaded.</p>
    <div class="out-acts">
      <button class="btn" type="button" data-out-clear><Icon name="trash" />Remove all</button>
      <button class="btn btn-primary" type="button" data-out-all><Icon name="download" />Download all</button>
    </div>
  </dialog>
  <template data-out-icons><span data-i="download"><Icon name="download" /></span><span data-i="trash"><Icon name="trash" /></span></template>
</div>
</Base>

<style is:global>
  /* Home only. Neutral surfaces; --accent only on the primary button, focus and hover. */
  main.wide { width: 100%; padding: 0; }
  .home { position: relative; }
  .home .tile {
    display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 12px; flex: none;
    color: var(--muted); background: var(--surface-2);
  }
  .topbar {
    position: absolute; top: 0.5rem; right: 0.6rem; z-index: 5; display: flex; align-items: center;
  }
  .home:not([data-at='centre']) .topbar { display: none; }
  .tb-btn {
    position: relative; display: inline-flex; align-items: center; gap: 0.4rem; flex: none; height: 34px; padding: 0 0.55rem; border-radius: 9px;
    border: 0; background: none; color: var(--muted); font: inherit; font-size: 0.9rem; font-weight: 600; white-space: nowrap; cursor: pointer;
  }
  .tb-btn:hover, .tb-btn:focus-visible { background: var(--app-hover); color: var(--fg); }
  .topbar .icon svg { width: 18px; height: 18px; }
  .tb-acts { display: flex; align-items: center; gap: 0.1rem; flex: none; margin-left: auto; }
  @media (max-width: 860px) { .tb-label { display: none; } }
  .out-count {
    min-width: 1.25rem; height: 1.25rem; padding: 0 0.35rem; border-radius: 999px; background: var(--accent); color: var(--accent-fg);
    font-size: 0.72rem; font-weight: 700; line-height: 1.25rem; text-align: center; font-variant-numeric: tabular-nums;
  }
  .out-count.pulse { animation: out-pulse 0.5s ease-out; }
  @keyframes out-pulse { 40% { transform: scale(1.35); } }
  @media (prefers-reduced-motion: reduce) { .out-count.pulse { animation: none; } }

  /* Hub: screens stacked in one full-viewport stage; only the active one is visible.
     clip, not hidden: focus moving into a tool frame must not scroll the stage. */
  .hub { position: relative; isolation: isolate; overflow: clip; height: 100dvh; }
  .hub:focus { outline: none; }
  .screen { position: absolute; inset: 0; overflow: clip; background: var(--bg); visibility: hidden; }
  .screen[data-active], .screen.leaving { visibility: visible; }
  .screen[data-active] { z-index: 1; }

  /* Start screen */
  /* Cells much wider than a label, so each one lands anywhere in its cell (not in visible columns) without overlapping. */
  .extension-field { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); grid-auto-rows: minmax(4rem, 1fr); padding: 0.5rem; overflow: hidden; pointer-events: none; user-select: none; color: var(--fg); opacity: 0.14; mask-image: linear-gradient(90deg, #000, rgb(0 0 0 / 0.12) 28%, rgb(0 0 0 / 0.12) 72%, #000); }
  .extension-slot { position: relative; min-width: 0; }
  .extension-field span { position: absolute; left: calc(10px + (100% - 86px) * var(--x)); top: calc(12px + (100% - 36px) * var(--y)); white-space: nowrap; line-height: 1; font-family: var(--mono); animation: extension-drift var(--speed) ease-in-out var(--delay) infinite alternate; animation-play-state: paused; }
  .screen-centre[data-active] .extension-field span { animation-play-state: running; }
  .screen-centre .cell-scroll { z-index: 1; padding-top: 4.5rem; }
  @keyframes extension-drift {
    from { transform: translate3d(-3px, 3px, 0) rotate(var(--tilt)); }
    to { transform: translate3d(3px, -3px, 0) rotate(calc(var(--tilt) + 4deg)); }
  }
  @media (prefers-reduced-motion: reduce) { .extension-field span { animation: none; } }
  .cell-scroll {
    position: absolute; inset: 0; overflow-y: auto; overscroll-behavior: contain;
    display: flex; flex-direction: column; padding: 2.5rem clamp(1.25rem, 8vw, 6rem) 3.5rem; scrollbar-width: thin;
  }
  /* The hero fills the first screen; the tool cards follow below the fold. */
  .cell-inner { width: min(100%, 46rem); margin: 0 auto; text-align: center; }
  /* Exactly one viewport below the scroller's 4.5rem top padding, so the tool cards start fully below the fold. */
  .centre-inner { display: flex; flex-direction: column; justify-content: center; min-height: calc(100dvh - 4.5rem); }
  .centre-inner h1 { font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.1; letter-spacing: -0.03em; margin: 0 auto 1.4rem; max-width: 22ch; }
  .eye-word { white-space: nowrap; }
  .word-eyes { width: 1.15em; height: 0.8em; vertical-align: -0.06em; transform-box: fill-box; transform-origin: center; animation: eye-blink 9s infinite; }
  @keyframes eye-blink {
    0%, 43%, 46%, 96%, 100% { transform: scaleY(1); }
    44.5%, 97.5% { transform: scaleY(0.08); }
  }
  .eye-pupils { animation: eye-wander 17s ease-in-out infinite; }
  .home[data-dragging] .eye-pupils { animation: none; }
  @keyframes eye-wander {
    0%, 16%, 100% { transform: translate(1px, 1px); }
    28%, 44% { transform: translate(-2px, -1px); }
    56%, 70% { transform: translate(2px, -1px); }
    82%, 92% { transform: translate(-1px, 2px); }
  }
  @media (prefers-reduced-motion: reduce) { .word-eyes, .eye-pupils { animation: none; } }
  .jump { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.55rem; margin-bottom: 1.25rem; }
  .jump-chip {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.55rem 1.05rem 0.55rem 0.8rem;
    border-radius: 999px; border: 1px solid var(--border); background: var(--surface); box-shadow: var(--shadow);
    color: var(--fg); font-size: 0.98rem; font-weight: 600; text-decoration: none;
    transition: border-color 0.1s, transform 0.1s ease-out;
  }
  .jump-chip:hover, .jump-chip:focus-visible { border-color: color-mix(in srgb, var(--cat) 55%, var(--border)); transform: translateY(-1px); }
  .jump-chip:active { transform: scale(0.97); }
  .jump-chip .icon svg { width: 18px; height: 18px; color: var(--cat); }
  .drop-instruction { position: relative; align-self: center; margin: 0.25rem 0 0.6rem; padding-right: 3.2rem; color: var(--fg); font-family: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive; font-size: clamp(1.5rem, 4vw, 2.1rem); font-weight: 700; line-height: 1.2; transform: rotate(-3deg); }
  .drop-arrow { position: absolute; right: 0; top: 55%; width: 3rem; height: 2.4rem; color: var(--accent); }
  .home .hero-drop {
    min-height: clamp(19rem, 38vh, 23rem); align-content: center; gap: 0.8rem;
    padding: 8rem clamp(1.25rem, 5vw, 3rem) 6rem; border: 0; border-radius: 30% 30% 50% 50%;
    background: none; color: #fff;
  }
  .home .hero-drop:is(:hover, .over, :focus-within) { background: none; }
  .mouth-shape { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--fg); pointer-events: none; transform-origin: 50% 20%; animation: mouth-breathe 6s ease-in-out infinite; transition: transform 0.18s ease-out; }
  .home[data-dragging] .mouth-shape { animation: none; }
  .hero-drop:is(:hover, .over, :focus-within) .mouth-shape { color: var(--accent); }
  .hero-drop > span { position: relative; pointer-events: none; }
  .home:is([data-dragging], [data-eating]) .hero-drop > span { visibility: hidden; }
  .hero-drop > input { z-index: 1; }
  .hero-drop .drop-hint { color: #f1d6dc; }
  @keyframes mouth-breathe { 50% { transform: scaleY(1.025) rotate(-0.3deg); } }
  /* The dragged file, drawn as a snack under the pointer on the start screen (positioned by followDrag and feed). */
  .snack { position: fixed; left: 0; top: 0; z-index: 60; pointer-events: none; visibility: hidden; }
  .snack[data-on] { visibility: visible; }
  .snack svg { display: none; width: 88px; height: 88px; translate: -50% -50%; filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.35)); animation: snack-wobble 0.7s ease-in-out infinite alternate; }
  .snack[data-kind='donut'] [data-kind='donut'], .snack[data-kind='pretzel'] [data-kind='pretzel'], .snack[data-kind='beer'] [data-kind='beer'] { display: block; }
  @keyframes snack-wobble { from { rotate: -6deg; } to { rotate: 6deg; } }
  @media (prefers-reduced-motion: reduce) {
    .mouth-shape { animation: none; transition: none; }
  }
  .hero-drop:has(input:focus-visible) { outline: 3px solid var(--accent); outline-offset: 3px; }
  .drop-btn { pointer-events: none; font-size: 1.02rem; padding: 0.7rem 1.4rem; border-radius: 12px; }
  .drop-btn .icon svg { width: 20px; height: 20px; }
  .cell-inner .status { min-height: 0; margin: 0.5rem 0 0; }
  .centre-actions { display: flex; justify-content: center; gap: 0.5rem; margin-top: 1rem; }
  .all-tools { border-radius: 999px; }
  .all-tools .icon svg { width: 18px; height: 18px; color: var(--muted); }

  /* Tool cards: one per category, each listing what its app can do. */
  .cats { width: min(100%, 74rem); margin: 3rem auto 0; }
  .cats h2 { margin: 0 0 1.25rem; font-size: clamp(1.4rem, 3vw, 1.9rem); letter-spacing: -0.02em; text-align: center; }
  .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr)); gap: 1rem; }
  .cat-card { display: flex; flex-direction: column; border: 1px solid var(--border); border-top: 3px solid var(--cat); border-radius: 18px; background: var(--surface); box-shadow: var(--shadow); overflow: hidden; }
  .cc-head { display: flex; align-items: center; gap: 0.8rem; padding: 1rem 1rem 0.9rem; border-bottom: 1px solid var(--border); color: var(--fg); text-decoration: none; }
  .cc-head:hover, .cc-head:focus-visible { background: var(--surface-2); }
  .cc-head:focus-visible { outline-offset: -3px; }
  .cc-head .tile { color: var(--cat); background: color-mix(in srgb, var(--cat) 14%, transparent); }
  .cc-head .tile svg { width: 22px; height: 22px; }
  .cc-title { display: grid; flex: 1; min-width: 0; line-height: 1.35; }
  .cc-title strong { font-size: 1.08rem; }
  .cc-title small { color: var(--muted); font-size: 0.85rem; }
  .cc-go svg { width: 18px; height: 18px; color: var(--muted); transition: transform 0.12s, color 0.12s; }
  .cc-head:hover .cc-go svg { color: var(--cat); transform: translateX(2px); }
  .cc-tools { list-style: none; margin: 0; padding: 0.4rem; }
  .cc-tools a { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0.6rem; border-radius: 10px; color: var(--fg); text-decoration: none; }
  .cc-tools a:hover, .cc-tools a:focus-visible { background: var(--surface-2); }
  .cc-tools a:focus-visible { outline-offset: -2px; }
  .cc-text { display: grid; flex: 1; min-width: 0; line-height: 1.35; text-align: left; }
  .cc-text strong { font-size: 0.92rem; font-weight: 600; }
  .cc-text small { color: var(--muted); font-size: 0.8rem; }
  .cats-legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 2rem; margin: 1.5rem 0 0; font-size: 0.85rem; color: var(--muted); }
  .cats-legend div { display: flex; align-items: center; gap: 0.5rem; }
  .cats-legend dt { display: flex; align-items: center; gap: 0.35rem; font-weight: 600; color: var(--fg); }
  .cats-legend .icon svg { width: 16px; height: 16px; color: var(--muted); }
  .cats-legend dd { margin: 0; }
  .cats-more { margin: 0.75rem 0 0; text-align: center; font-size: 0.85rem; }
  .cats-more a { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--muted); }
  .cats-more a:hover { color: var(--fg); }
  .cats-more .icon svg { width: 16px; height: 16px; }

  /* Category screens: the app fills the screen below the header. */
  .cat-body { position: absolute; inset: 0; overflow: clip; }
  .tool-frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: var(--bg); color-scheme: normal; }

  /* Dialogs: all tools, settings, outputs */
  dialog.picker { width: min(94vw, 40rem); max-width: none; max-height: min(86dvh, 46rem); padding: 0; overflow: hidden; }
  dialog.picker[open] { display: flex; flex-direction: column; animation: picker-in 0.16s ease-out; }
  @keyframes picker-in { from { opacity: 0; transform: translateY(6px) scale(0.99); } }
  .picker-head { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1rem 0 1.25rem; }
  .picker-head h2 { margin: 0; }

  .dialog-body { overflow-y: auto; overscroll-behavior: contain; padding: 0.25rem 1.25rem 1.25rem; }
  .dialog-body > .muted { margin: 0.25rem 0 1rem; font-size: 0.88rem; }
  /* The global `dialog form` rule lays out button rows; the settings form is a regular form. */
  .settings-dialog form.settings-form { display: grid; justify-content: stretch; margin: 0; }

  .out-total { font-size: 0.9rem; font-weight: 500; }
  .out-list { list-style: none; margin: 0.75rem 0 0; padding: 0 0.6rem; overflow-y: auto; overscroll-behavior: contain; flex: 1; }
  .out-list:empty { display: none; }
  .out-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.4rem 0.4rem 0.4rem 0.6rem; border-radius: 10px; }
  .out-row:hover { background: var(--surface-2); }
  .out-text { display: grid; flex: 1; min-width: 0; line-height: 1.35; }
  .out-text strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
  .out-text small { color: var(--muted); font-variant-numeric: tabular-nums; }
  .out-row .icon-btn { display: grid; place-items: center; text-decoration: none; }
  .out-row .icon svg { width: 18px; height: 18px; }
  .out-empty { margin: 0; padding: 1rem 1.25rem 0.5rem; font-size: 0.9rem; }
  .out-list:not(:empty) + .out-empty { display: none; }
  .out-acts { display: flex; justify-content: flex-end; gap: 0.5rem; padding: 0.9rem 1.25rem 1rem; border-top: 1px solid var(--border); margin-top: 0.75rem; }

  .out-toast {
    position: fixed; z-index: 50; bottom: 1.25rem; left: 50%; translate: -50% 0; max-width: min(90vw, 28rem); margin: 0;
    padding: 0.55rem 1rem; border-radius: 999px; background: var(--fg); color: var(--bg); box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
    font-size: 0.88rem; font-weight: 550; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; pointer-events: none;
    animation: picker-in 0.16s ease-out;
  }

  /* Shown while dragging files over a category screen (the start screen has its own drop zone). */
  .hub-veil {
    position: absolute; inset: 0.75rem; z-index: 4; pointer-events: none;
    display: grid; place-items: center; border: 2px dashed var(--accent); border-radius: 24px;
    background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: blur(4px);
    font-size: 1.4rem; font-weight: 650; opacity: 0; transition: opacity 0.12s;
  }
  .home[data-dragging]:not([data-at='centre']) .hub-veil { opacity: 1; }

  /* Spotlight under the cursor while files are dragged (positioned by followDrag). */
  .drag-glow {
    position: fixed; left: 0; top: 0; z-index: 60; width: 0; height: 0; pointer-events: none;
    opacity: 0; transition: opacity 0.2s;
  }
  .drag-glow[data-on] { opacity: 1; }
  .drag-glow::before, .drag-glow::after { content: ''; position: absolute; border-radius: 50%; translate: -50% -50%; }
  .drag-glow::before { width: 320px; height: 320px; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 28%, transparent), transparent 65%); }
  .drag-glow::after { width: 56px; height: 56px; border: 2px solid var(--accent); box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 55%, transparent); }
  @media (prefers-reduced-motion: no-preference) {
    .drag-glow::after { animation: drag-ring 1.2s ease-out infinite; }
  }
  @keyframes drag-ring { from { scale: 0.6; opacity: 1; } to { scale: 1.8; opacity: 0; } }
</style>

<script>
  import { zip } from 'fflate';
  import { el, formatBytes, sniff } from '../lib/tool';
  import { categories, tools } from '../tools';

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  // ---------- Dialogs ----------
  const settings = $<HTMLDialogElement>('[data-settings-dialog]');
  const outputs = $<HTMLDialogElement>('[data-outputs]');
  const dialogs = [settings, outputs];
  const centreScroll = $('.screen-centre .cell-scroll');

  function open(d: HTMLDialogElement) {
    for (const other of dialogs) if (other !== d) other.close();
    if (!d.open) d.showModal();
  }
  $('[data-all-tools]').addEventListener('click', () => $('#all-tools').scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth' }));
  for (const b of document.querySelectorAll('[data-settings-open]')) b.addEventListener('click', () => open(settings));
  for (const b of document.querySelectorAll('[data-outputs-open]')) b.addEventListener('click', () => open(outputs));
  for (const d of dialogs) {
    d.querySelector('[data-dialog-close]')!.addEventListener('click', () => d.close());
    // The dialogs have no padding, so a click on the element itself is a click on the backdrop.
    d.addEventListener('click', (e) => e.target === d && d.close());
  }

  // ---------- Outputs: every file any app creates, in memory until the page is left ----------
  type Output = { id: number; name: string; blob: Blob; url: string; source: string; time: Date };
  const outList = $('[data-out-list]');
  const outIcons = $<HTMLTemplateElement>('[data-out-icons]').content;
  const outIcon = (n: string) => outIcons.querySelector(`[data-i="${n}"]`)!.firstElementChild!.cloneNode(true);
  const toast = $('[data-out-toast]');
  let items: Output[] = [];
  let nextId = 1;
  let toastTimer = 0;

  function renderOutputs() {
    const total = items.reduce((n, o) => n + o.blob.size, 0);
    for (const c of document.querySelectorAll<HTMLElement>('[data-out-count]')) {
      c.hidden = !items.length;
      c.textContent = String(items.length);
    }
    for (const r of frames.values()) r.el.contentWindow?.postMessage({ type: 'tools:outputs', count: items.length }, location.origin);
    $('[data-out-total]').textContent = items.length ? `· ${items.length} · ${formatBytes(total)}` : '';
    $<HTMLButtonElement>('[data-out-all]').disabled = $<HTMLButtonElement>('[data-out-clear]').disabled = !items.length;
    outList.replaceChildren(
      ...items.map((o) => {
        const remove = el('button', { type: 'button', className: 'icon-btn', ariaLabel: `Remove ${o.name}`, title: 'Remove' }, outIcon('trash'));
        remove.onclick = () => removeOutputs([o]);
        const time = o.time.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        return el(
          'li',
          { className: 'out-row' },
          el('span', { className: 'out-text' }, el('strong', { textContent: o.name, title: o.name }), el('small', { textContent: `${formatBytes(o.blob.size)} · ${o.source} · ${time}` })),
          el('a', { className: 'icon-btn', href: o.url, download: o.name, ariaLabel: `Download ${o.name}`, title: 'Download' }, outIcon('download')),
          remove,
        );
      }),
    );
  }
  function removeOutputs(list: Output[]) {
    list.forEach((o) => URL.revokeObjectURL(o.url));
    items = items.filter((o) => !list.includes(o));
    renderOutputs();
  }
  function addOutput(blob: Blob, name: string, source: string) {
    items.unshift({ id: nextId++, name, blob, url: URL.createObjectURL(blob), source, time: new Date() });
    renderOutputs();
    for (const c of document.querySelectorAll<HTMLElement>('[data-out-count]')) {
      c.classList.remove('pulse');
      void c.offsetWidth;
      c.classList.add('pulse');
    }
    toast.textContent = `Saved to Outputs: ${name}`;
    toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (toast.hidden = true), 2600);
  }
  /** `a.txt`, `a.txt` → `a.txt`, `a (2).txt`: archive entries must be unique. */
  function uniqueNames(names: string[]) {
    const used = new Set<string>();
    return names.map((n) => {
      let name = n;
      for (let i = 2; used.has(name.toLowerCase()); i++) name = n.replace(/(\.[^./]*)?$/, (ext) => ` (${i})${ext}`);
      used.add(name.toLowerCase());
      return name;
    });
  }
  $('[data-out-clear]').addEventListener('click', () => {
    if (confirm(`Remove all ${items.length} outputs? Download anything you still need first.`)) removeOutputs([...items]);
  });
  $('[data-out-all]').addEventListener('click', async () => {
    if (items.length === 1) return outList.querySelector<HTMLAnchorElement>('a[download]')!.click();
    const btn = $<HTMLButtonElement>('[data-out-all]');
    btn.disabled = true;
    try {
      const names = uniqueNames(items.map((o) => o.name));
      const entries = Object.fromEntries(await Promise.all(items.map(async (o, i) => [names[i], new Uint8Array(await o.blob.arrayBuffer())] as const)));
      // Outputs are mostly compressed already (images, audio, PDFs, archives): store only.
      const data = await new Promise<Uint8Array>((res, rej) => zip(entries, { level: 0 }, (err, out) => (err ? rej(err) : res(out))));
      const url = URL.createObjectURL(new Blob([data as BlobPart], { type: 'application/zip' }));
      el('a', { href: url, download: 'outputs.zip' }).click();
      setTimeout(() => URL.revokeObjectURL(url), 30_000);
    } catch (err) {
      console.error(err);
      alert('Could not build the ZIP. Download the files one by one instead.');
    } finally {
      btn.disabled = !items.length;
    }
  });
  addEventListener('message', (e: MessageEvent) => {
    if (e.origin !== location.origin) return;
    const d = e.data;
    if (d?.type === 'tools:output' && d.blob instanceof Blob) {
      const from = [...frames].find(([, r]) => r.el.contentWindow === e.source)?.[0];
      addOutput(d.blob, String(d.name || 'output'), categories.find((c) => c.id === from)?.label ?? 'Tool');
    } else if (d?.type === 'tools:open') open(d.what === 'settings' ? settings : outputs);
    else if (d?.type === 'tools:go' && screens.has(d.to)) {
      if (d.to === 'centre') go('centre');
      else openTool(d.to, selected.get(d.to));
    }
  });

  // ---------- Hub: screens and app frames ----------
  type Frame = { src: string; el: HTMLIFrameElement; loaded: boolean };
  const home = $('.home');
  const hub = $('[data-hub]');
  const screens = new Map([...hub.querySelectorAll<HTMLElement>('[data-screen]')].map((s) => [s.dataset.screen!, s]));
  let active = 'centre';
  let running: Animation[] = [];
  let leaving: HTMLElement | undefined;
  const frames = new Map<string, Frame>();
  // The tool each category screen shows (decides the app mode); none = the app's default.
  const selected = new Map<string, string>();
  // Files from the last drop, in memory only, and the screen they were routed to.
  let held: { screen: string; files: File[] } | undefined;

  const toolBySlug = (slug: string) => tools.find((t) => t.slug === slug);

  function frameSrc(id: string) {
    const mode = toolBySlug(selected.get(id) ?? '')?.appMode;
    return `${screens.get(id)!.dataset.app}?${mode ? `mode=${encodeURIComponent(mode)}&` : ''}embed`;
  }
  /** `#pdf` or `#pdf/split` (a tool slug's last segment) → screen and tool. */
  function fromHash(): { screen: string; slug?: string } {
    const [screen, key] = location.hash.slice(1).split('/');
    if (!screen || screen === 'centre' || !screens.has(screen)) return { screen: 'centre' };
    return { screen, slug: key ? tools.find((t) => t.category === screen && t.slug.split('/')[1] === key)?.slug : undefined };
  }
  function hashFor(id: string) {
    if (id === 'centre') return '';
    const tool = toolBySlug(selected.get(id) ?? '');
    return tool?.appMode ? `#${id}/${tool.slug.split('/')[1]}` : `#${id}`;
  }
  /** Keep the URL shareable without adding history entries for mode changes. */
  function syncUrl() {
    const want = hashFor(active);
    if (location.hash !== want) history.replaceState(history.state, '', want || location.pathname + location.search);
  }

  function setActive(id: string) {
    active = id;
    home.dataset.at = id;
    for (const [key, s] of screens) {
      s.inert = key !== id;
      s.toggleAttribute('data-active', key === id);
    }
    ensureFrame(id);
    syncUrl();
  }

  function settle() {
    running.forEach((a) => a.cancel());
    running = [];
    leaving?.classList.remove('leaving');
    leaving = undefined;
  }

  /** Show `to` with a short cross-fade. */
  function navigate(to: string) {
    if (to === active) return;
    const from = screens.get(active)!;
    const target = screens.get(to)!;
    settle();
    setActive(to);
    if (reduceMotion.matches) return;
    leaving = from;
    from.classList.add('leaving');
    const opts: KeyframeAnimationOptions = { duration: 220, easing: 'cubic-bezier(0.33, 1, 0.68, 1)' };
    running = [
      from.animate([{ opacity: 1 }, { opacity: 0 }], opts),
      target.animate([{ opacity: 0, transform: 'scale(0.985)' }, { opacity: 1, transform: 'none' }], opts),
    ];
    running[0].onfinish = () => leaving === from && settle();
  }

  /** Navigate and, when focus is inside the hub (or a frame), carry it along so it isn't lost in an inert screen. */
  function go(to: string) {
    const focusInside = hub.contains(document.activeElement) && document.activeElement !== hub;
    navigate(to);
    if (focusInside) (to === 'centre' ? hub : frames.get(to)?.el ?? hub).focus({ preventScroll: true });
  }

  /** Create the app frame for a screen in its selected mode, unless it already shows exactly that. */
  function ensureFrame(id: string) {
    if (id === 'centre') return;
    const src = frameSrc(id);
    if (frames.get(id)?.src === src) return;
    frames.get(id)?.el.remove();
    const title = categories.find((c) => c.id === id)!.label;
    const rec: Frame = { src, loaded: false, el: el('iframe', { src, title: `${title} tools`, className: 'tool-frame' }) };
    frames.set(id, rec);
    rec.el.addEventListener('load', () => {
      rec.loaded = true;
      onFrameLoad(id, rec);
    });
    screens.get(id)!.querySelector('[data-panel]')!.append(rec.el);
  }

  /** Open a screen with a tool's app mode, handing over dropped files. `push`: one history entry (drops only). */
  function openTool(id: string, slug?: string, push = false) {
    if (slug && toolBySlug(slug)?.appMode) selected.set(id, slug);
    else selected.delete(id);
    const rec = frames.get(id);
    if (rec?.src === frameSrc(id)) {
      if (rec.loaded) inject(id, rec);
    } else ensureFrame(id);
    if (push) history.pushState({ drop: true }, '', hashFor(id) || location.pathname + location.search);
    if (active !== id) go(id);
    else syncUrl();
  }

  // ---------- App frames ----------
  const accepts = (accept: string, f: File) =>
    !accept ||
    accept.split(',').some((a) => {
      const t = a.trim().toLowerCase();
      return t.startsWith('.') ? f.name.toLowerCase().endsWith(t) : t.endsWith('/*') ? f.type.startsWith(t.slice(0, -1)) : f.type === t;
    });

  /** Put the held files into the app's file input, if they belong to this screen and the input takes them. */
  function inject(id: string, rec: Frame) {
    const win = rec.el.contentWindow as (Window & typeof globalThis) | null;
    const doc = rec.el.contentDocument;
    if (!held || held.screen !== id || !win || !doc) return;
    // Apps and tool pages take files through [data-input]; text tools through [data-file].
    const target = doc.querySelector<HTMLInputElement>('[data-input], [data-file]');
    if (!target) return;
    const list = held.files.filter((f) => accepts(target.accept, f));
    if (!list.length) return;
    const dt = new win.DataTransfer();
    // Rebuild each File in the frame's realm so arrayBuffer() returns that realm's ArrayBuffer;
    // libraries' `instanceof ArrayBuffer` checks fail otherwise (e.g. pdf-lib).
    (target.multiple ? list : list.slice(0, 1)).forEach((f) => dt.items.add(new win.File([f], f.name, { type: f.type, lastModified: f.lastModified })));
    target.files = dt.files;
    target.dispatchEvent(new win.Event('change'));
  }

  const syncTheme = (doc: Document) => {
    const theme = document.documentElement.dataset.theme;
    if (theme) doc.documentElement.dataset.theme = theme;
    else delete doc.documentElement.dataset.theme;
  };
  new MutationObserver(() => frames.forEach((r) => r.loaded && r.el.contentDocument && syncTheme(r.el.contentDocument))).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });

  function onFrameLoad(id: string, rec: Frame) {
    const doc = rec.el.contentDocument;
    if (!doc) return;
    syncTheme(doc);
    inject(id, rec);
    rec.el.contentWindow?.postMessage({ type: 'tools:outputs', count: items.length }, location.origin);
    doc.addEventListener('keydown', (e) => onShortcut(e, doc));
    // Site links (privacy, settings, standalone pages) leave the hub instead of navigating inside the frame.
    doc.addEventListener('click', (e) => {
      const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href]');
      if (!a || e.defaultPrevented || a.download || a.getAttribute('href')!.startsWith('#') || a.protocol === 'blob:' || e.ctrlKey || e.metaKey || e.shiftKey) return;
      e.preventDefault();
      location.href = a.href;
    });
    // Files dropped outside the app's own drop zone are routed like drops on the hub (and never open in the frame).
    doc.addEventListener('dragover', (e) => hasFiles(e) && e.preventDefault());
    // Capture phase: apps may stop the event in their own drop zones; the glow follows the cursor regardless.
    doc.addEventListener('dragover', (e) => hasFiles(e) && followDrag(e, rec.el), true);
    doc.addEventListener('drop', () => glow.removeAttribute('data-on'), true);
    doc.addEventListener('drop', (e) => {
      if (!hasFiles(e) || e.defaultPrevented) return;
      e.preventDefault();
      void handle([...e.dataTransfer!.files]);
    });
  }

  // Prefetch a category's app when the pointer or focus reaches its badge.
  for (const type of ['pointerover', 'focusin'] as const) {
    hub.addEventListener(type, (e) => {
      const a = (e.target as Element).closest?.<HTMLElement>('[data-go]');
      if (a?.dataset.go) ensureFrame(a.dataset.go);
    });
  }

  // ---------- Keyboard: Esc back to the start (hub document and every app frame) ----------
  const BUSY = 'input, textarea, select, [contenteditable]:not([contenteditable="false"]), [role="application"], canvas[tabindex]';

  function onShortcut(e: KeyboardEvent, doc: Document = document) {
    if (e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey || e.isComposing) return;
    if (dialogs.some((d) => d.open) || doc.querySelector('dialog[open]')) return;
    if ((e.target as Element).closest?.(BUSY)) return;
    if (e.key === 'Escape' && active !== 'centre') {
      e.preventDefault();
      go('centre');
    }
  }
  document.addEventListener('keydown', (e) => onShortcut(e));

  // Category cards and badges, tool rows and the brand switch screens instead of navigating.
  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const target = e.target as Element;
    if (dialogs.some((d) => d.contains(target))) return;
    const tool = target.closest<HTMLAnchorElement>('a[data-open-slug]');
    if (tool) {
      e.preventDefault();
      return openTool(tool.dataset.openScreen!, tool.dataset.openSlug!);
    }
    const control = target.closest<HTMLElement>('[data-go]');
    const a = target.closest<HTMLAnchorElement>('a[href]');
    const id = control?.dataset.go ?? (a && a.pathname === location.pathname && a.search === location.search ? a.hash.slice(1) || 'centre' : undefined);
    if (!id || !screens.has(id)) return;
    e.preventDefault();
    if (id === 'centre') {
      if (active === 'centre') centreScroll.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      go(id);
    } else openTool(id, selected.get(id));
  });

  // ---------- Drops: route files to the matching app and mode ----------
  // Files are handed over in memory only: nothing is persisted or uploaded.
  type Kind = 'image' | 'pdf' | 'audio' | 'gpx' | 'json' | 'js' | 'markdown' | 'text' | 'archive' | 'other';
  const drop = $('[data-hero-drop]');
  const input = $<HTMLInputElement>('[data-hero-input]');
  const status = $('[data-drop-status]');
  const AUDIO_EXT = /\.(m4a|aac|mp3|wav|ogg|oga|opus|flac|weba)$/i;
  const ARCHIVE_EXT = /\.(zip|7z|rar|tar|tgz|gz|xz|txz|bz2|tbz2?|iso|cab)$/i;
  const TEXT_EXT = /\.(txt|csv|tsv|log|xml|html?|css|scss|ts|tsx|jsx|ya?ml|toml|ini|env|sh|py|rb|go|rs|java|c|h|cpp|sql|svg)$/i;
  // ISO-BMFF brands that carry audio; excludes HEIC/AVIF (also "ftyp").
  const AUDIO_BRAND = /^(M4A |M4B |M4P |mp4[12]|isom|iso[2-6]|dash|3gp)/;

  async function kindOf(f: File): Promise<Kind> {
    const t = await sniff(f);
    if (t === 'jpeg' || t === 'png' || t === 'webp') return 'image';
    // SVG has no magic bytes; the editor re-checks the content before rasterizing.
    if (f.type === 'image/svg+xml' || /\.svg$/i.test(f.name)) return 'image';
    if (t === 'pdf') return t;
    if (f.type === 'application/gpx+xml' || /\.gpx$/i.test(f.name)) return 'gpx';
    if (t === 'zip' || t === 'gzip' || ARCHIVE_EXT.test(f.name)) return 'archive';
    const b = new Uint8Array(await f.slice(0, 12).arrayBuffer());
    const s = (o: number, str: string) => [...str].every((c, i) => b[o + i] === c.charCodeAt(0));
    const ascii = String.fromCharCode(...b.subarray(8, 12));
    if (s(0, 'ID3') || s(0, 'OggS') || s(0, 'fLaC') || (s(0, 'RIFF') && s(8, 'WAVE')) || (s(4, 'ftyp') && AUDIO_BRAND.test(ascii))) return 'audio';
    if (b[0] === 0xff && (b[1] & 0xe0) === 0xe0) return 'audio'; // MPEG/ADTS frame sync
    if (f.type.startsWith('audio/') || AUDIO_EXT.test(f.name)) return 'audio';
    if (f.type === 'application/json' || /\.json$/i.test(f.name)) return 'json';
    if (/^(text|application)\/javascript$/.test(f.type) || /\.[mc]?js$/i.test(f.name)) return 'js';
    if (/\.(md|markdown)$/i.test(f.name)) return 'markdown';
    if (f.type.startsWith('text/') || TEXT_EXT.test(f.name)) return 'text';
    return 'other';
  }

  const TEXTUAL: Kind[] = ['json', 'js', 'markdown', 'text'];

  /** Drop → app + mode, as one history entry (Back returns to where the files were dropped). */
  async function handle(list: File[]) {
    if (!list.length) return;
    dialogs.forEach((d) => d.close());
    status.textContent = '';
    let kinds: Kind[];
    try {
      kinds = await Promise.all(list.map(kindOf));
    } catch {
      status.textContent = 'Could not read that file.';
      return;
    }
    const kind = kinds.every((k) => k === kinds[0]) ? kinds[0] : kinds.every((k) => TEXTUAL.includes(k)) ? 'text' : 'other';
    const single = list.length === 1;
    const [screen, slug] =
      kind === 'image' ? ['images', 'images/editor']
      : kind === 'pdf' ? ['pdf', single ? 'pdf/organize' : 'pdf/merge']
      : kind === 'audio' ? ['audio', 'audio/convert']
      : kind === 'json' ? ['text', 'text/json']
      : kind === 'js' ? ['text', 'text/js-minify']
      : kind === 'markdown' ? ['text', 'text/markdown']
      : kind === 'text' ? ['text', undefined]
      : kind === 'gpx' ? ['gpx', single ? 'gpx/edit' : 'gpx/merge']
      : kind === 'archive' ? ['files', 'files/extract']
      : ['files', undefined];
    held = { screen, files: list };
    openTool(screen, slug, true);
  }

  // On the start screen the mouth eats what it is fed: a dropped snack falls in, the mouth shuts, the tool fades in.
  const snack = $('[data-snack]');
  async function feed(list: File[], at?: { x: number; y: number }) {
    if (!list.length) return;
    if (active === 'centre' && !reduceMotion.matches) {
      // Set before the fall so the button and hint stay hidden from release until the tool shows.
      home.toggleAttribute('data-eating', true);
      if (at) {
        const m = mouthShape.getBoundingClientRect();
        const x = m.left + m.width / 2, y = m.top + m.height * 0.45;
        snack.toggleAttribute('data-on', true);
        await snack.animate([
          { transform: `translate(${at.x}px, ${at.y}px)` },
          { transform: `translate(${at.x + (x - at.x) * 0.2}px, ${Math.min(at.y, y) - 40}px) rotate(-30deg)`, offset: 0.3 },
          { transform: `translate(${x}px, ${y}px) rotate(160deg) scale(0.3)`, opacity: 0.5 },
        ], { duration: 550, easing: 'ease-in' }).finished;
        snack.removeAttribute('data-on');
      }
      // Stays shut through the cross-fade to the tool, then reopens for the next visit.
      const shut = mouthShape.animate([{ transform: 'none' }, { transform: 'scaleY(0.12)' }], { duration: 220, easing: 'cubic-bezier(0.5, 0, 0.75, 0)', fill: 'forwards' });
      await shut.finished;
      setTimeout(() => {
        shut.cancel();
        home.removeAttribute('data-eating');
      }, 400);
    }
    await handle(list);
  }

  input.addEventListener('change', () => {
    void feed([...(input.files ?? [])]);
    input.value = '';
  });
  // Accept drops anywhere on the hub so a near miss doesn't open the file in the browser.
  const hasFiles = (e: DragEvent) => !!e.dataTransfer?.types.includes('Files');
  const eyes = document.querySelector<SVGSVGElement>('.word-eyes')!;
  const pupils = eyes.querySelector<SVGGElement>('.eye-pupils')!;
  const mouthShape = drop.querySelector<SVGSVGElement>('.mouth-shape')!;
  const SNACKS = ['donut', 'pretzel', 'beer'];
  const setDragging = (on: boolean) => {
    // A fresh drag gets a random snack.
    if (on && !home.hasAttribute('data-dragging')) snack.dataset.kind = SNACKS[Math.floor(Math.random() * SNACKS.length)];
    drop.classList.toggle('over', on);
    home.toggleAttribute('data-dragging', on);
    if (!on) {
      pupils.removeAttribute('transform');
      mouthShape.style.removeProperty('transform');
      snack.removeAttribute('data-on');
    }
  };
  // A soft spotlight (a snack on the start screen) follows the cursor while files are dragged over the hub or any app frame.
  // Browsers repeat dragover at least every ~350 ms while the pointer is over the page, so silence means the drag
  // left or was cancelled; drops hide it at once.
  const glow = $('[data-drag-glow]');
  let glowTimer = 0;
  function followDrag(e: DragEvent, frame?: HTMLIFrameElement) {
    const r = frame?.getBoundingClientRect();
    const snacking = active === 'centre' && !reduceMotion.matches;
    glow.style.transform = `translate(${e.clientX + (r?.left ?? 0)}px, ${e.clientY + (r?.top ?? 0)}px)`;
    glow.style.setProperty('--accent', active === 'centre' ? '' : `var(--c-${active})`);
    glow.toggleAttribute('data-on', !snacking);
    snack.toggleAttribute('data-on', snacking);
    if (snacking) {
      snack.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
      const eyeBox = eyes.getBoundingClientRect();
      const dx = e.clientX - (eyeBox.left + eyeBox.width / 2);
      const dy = e.clientY - (eyeBox.top + eyeBox.height / 2);
      const distance = Math.hypot(dx, dy, 70);
      pupils.setAttribute('transform', `translate(${2.5 * dx / distance} ${2.5 * dy / distance})`);
      const mouth = drop.getBoundingClientRect();
      const mouthX = e.clientX - (mouth.left + mouth.width / 2);
      const mouthY = e.clientY - (mouth.top + mouth.height / 2);
      const reach = Math.hypot(mouthX, mouthY, 150);
      const over = e.clientX >= mouth.left && e.clientX <= mouth.right && e.clientY >= mouth.top && e.clientY <= mouth.bottom;
      mouthShape.style.transform = `translate(${8 * mouthX / reach}px, ${6 * mouthY / reach}px) rotate(${2 * mouthX / reach}deg) scaleY(${over ? 1.2 : 1.08})`;
    }
    clearTimeout(glowTimer);
    glowTimer = window.setTimeout(() => {
      glow.removeAttribute('data-on');
      setDragging(false);
    }, 600);
  }
  document.addEventListener('dragover', (e) => {
    if (!hasFiles(e)) return;
    e.preventDefault();
    setDragging(true);
    followDrag(e);
  });
  document.addEventListener('drop', () => {
    glow.removeAttribute('data-on');
    setDragging(false);
  }, true);
  document.addEventListener('dragleave', (e) => {
    if (!e.relatedTarget) setDragging(false);
  });
  document.addEventListener('drop', (e) => {
    if (!hasFiles(e)) return;
    e.preventDefault();
    void feed([...e.dataTransfer!.files], { x: e.clientX, y: e.clientY });
  });
  document.addEventListener('paste', (e) => {
    const pasted = [...(e.clipboardData?.files ?? [])];
    if (!pasted.length || (e.target as Element).closest?.('input, textarea')) return;
    e.preventDefault();
    void feed(pasted);
  });

  // ---------- History ----------
  // Back/forward (and #links typed into the address bar) move the hub; drops are the only pushed entries.
  function applyHash() {
    const { screen, slug } = fromHash();
    if (screen !== 'centre') {
      if (slug) selected.set(screen, slug);
      else selected.delete(screen);
    }
    if (screen !== active) navigate(screen);
    else ensureFrame(screen);
  }
  addEventListener('popstate', applyHash);
  // A reload keeps history.state but not the in-memory files.
  if (history.state) history.replaceState(null, '');
  {
    const { screen, slug } = fromHash();
    if (slug) selected.set(screen, slug);
    setActive(screen);
  }
  renderOutputs();
  // Outputs live in memory only: warn before they are lost.
  addEventListener('beforeunload', (e) => {
    if (items.length) e.preventDefault();
  });
</script>
