---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ImageEditor from '../../components/ImageEditor.astro';
import ModeBadge from '../../components/ModeBadge.astro';
import { href, toolBySlug } from '../../tools';

const tool = toolBySlug('images/editor');
---
<Base title={`${tool.title} · Tools`} description={tool.summary}>
  <div class="tool-shell" data-wide>
  <div class="crumbs"><a href={href()}>All tools</a> / <a href={href() + '#images'}>Images</a></div>
  <div class="tool-head">
    <h1>{tool.title}</h1>
    <ModeBadge mode={tool.mode} />
  </div>
  <p class="tool-summary">{tool.summary}</p>
  <div class="privacy-note privacy-local" role="note">
    <Icon name="lock" />
    <p><strong>Your files stay on this device by default.</strong> Editing happens in your browser. Only <strong>Remove background</strong> (marked with the cloud icon) uploads the image, and only after you confirm each time. <a href={href('privacy')}>How we check</a></p>
  </div>

  <ImageEditor />
  </div>
</Base>

<style is:global>
  /* Embedded in the home hub: the editor is the whole frame, edge to edge. */
  :root[data-embed] main#main:has(.image-editor) { width: 100%; padding: 0; }
  :root[data-embed] .tool-shell:has(.image-editor) > :not(.image-editor) { display: none; }
  :root[data-embed] .image-editor { display: flex; flex-direction: column; width: 100%; height: 100dvh; margin: 0; border: 0; border-radius: 0; box-shadow: none; }
  :root[data-embed] .ie-body { flex: 1; min-height: 0; height: auto; }
  @media (max-width: 820px) { :root[data-embed] .image-editor { height: auto; min-height: 100dvh; } }
</style>

<script>
  import { initImageEditor } from '../../lib/editor';

  initImageEditor();
</script>
