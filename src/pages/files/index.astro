---
// Files & text app: an editor-style workspace for JSON, JavaScript, ZIP and gzip. Behaviour: src/lib/files-app.ts.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ModeBadge from '../../components/ModeBadge.astro';
import ProgressDial from '../../components/ProgressDial.astro';
import { categories, href } from '../../tools';

const cat = categories.find((c) => c.id === 'files')!;
// Cloned into client-built rows (explorer, tray, tabs, output).
const rowIcons = ['doc', 'braces', 'code', 'files', 'images', 'pdf', 'edit', 'download', 'trash', 'xmark', 'warning', 'check', 'compare'] as const;
---
<Base title={`${cat.label} · Tools`} description={cat.blurb}>
  <div class="tool-shell" data-wide>
    <div class="crumbs"><a href={href()}>All tools</a> / <a href={href() + '#files'}>{cat.label}</a></div>
    <div class="tool-head">
      <h1>{cat.label}</h1>
      <ModeBadge mode="local" />
    </div>
    <p class="tool-summary">{cat.blurb}</p>
    <div class="privacy-note privacy-local" role="note">
      <Icon name="lock" />
      <p><strong>Runs in your browser; nothing is uploaded.</strong> Formatting, minifying and compression all happen on this device. <a href={href('privacy')}>How we check</a></p>
    </div>

    <section class="fx" data-fx aria-label="Files and text">
      <header class="fx-top">
        <span class="fx-title"><Icon name="files" /><span>Files &amp; text</span></span>
        <ModeBadge mode="local" />
        <div class="segmented fx-modes" role="radiogroup" aria-label="Tool">
          <label><input type="radio" name="tool" value="json" checked /><span>JSON</span></label>
          <label><input type="radio" name="tool" value="js" /><span>JavaScript</span></label>
          <label><input type="radio" name="tool" value="zip" /><span>ZIP</span></label>
          <label><input type="radio" name="tool" value="gzip" /><span>Gzip</span></label>
          <label><input type="radio" name="tool" value="compare" /><span>Compare</span></label>
        </div>
        <div class="fx-top-actions">
          <button class="fx-btn" type="button" data-new title="New text document"><Icon name="new-file" /><span>New</span></button>
          <button class="fx-btn" type="button" data-open title="Open files"><Icon name="folder" /><span>Open</span></button>
          <button class="fx-btn" type="button" data-paste title="Paste text from the clipboard"><Icon name="paste" /><span>Paste</span></button>
          <button class="fx-ib fx-side-toggle" type="button" data-toggle-explorer aria-expanded="true" aria-controls="fx-explorer" aria-label="Explorer" title="Show or hide the Explorer"><Icon name="sidebar" /></button>
        </div>
        <input type="file" multiple data-input hidden />
      </header>

      <div class="fx-tools">
        <div class="fx-tool" data-panel="json" role="group" aria-label="JSON">
          <span class="fx-label" id="fx-indent">Indent</span>
          <div class="segmented fx-seg" role="radiogroup" aria-labelledby="fx-indent">
            <label><input type="radio" name="indent" value="2" checked /><span>2</span></label>
            <label><input type="radio" name="indent" value="4" /><span>4</span></label>
            <label><input type="radio" name="indent" value="tab" /><span>Tab</span></label>
          </div>
          <span class="fx-grow"></span>
          <button class="fx-btn" type="button" data-act="validate"><Icon name="check" /><span>Validate</span></button>
          <button class="fx-btn" type="button" data-act="minify-json">Minify</button>
          <button class="fx-btn fx-primary" type="button" data-act="format" title="Format JSON (Ctrl/Cmd+Shift+F)"><Icon name="braces" /><span>Format</span></button>
        </div>
        <div class="fx-tool" data-panel="js" role="group" aria-label="JavaScript" hidden>
          <label class="fx-check"><input type="checkbox" name="mangle" checked /> Mangle names</label>
          <label class="fx-check"><input type="checkbox" name="keepConsole" /> Keep console</label>
          <label class="fx-check"><input type="checkbox" name="module" /> ES module</label>
          <span class="fx-grow"></span>
          <button class="fx-btn fx-primary" type="button" data-act="minify-js"><Icon name="code" /><span>Minify</span></button>
        </div>
        <div class="fx-tool" data-panel="compare" role="group" aria-label="Compare" hidden>
          <label class="fx-field"><span class="fx-label">Left</span><select name="cmpA"></select></label>
          <label class="fx-field"><span class="fx-label">Right</span><select name="cmpB"></select></label>
          <label class="fx-check"><input type="checkbox" name="ignoreWs" /> Ignore whitespace</label>
          <label class="fx-check"><input type="checkbox" name="normJson" /> Normalize JSON</label>
          <span class="fx-grow"></span>
          <button class="fx-btn" type="button" data-act="compare-clip"><Icon name="paste" /><span>Compare with clipboard</span></button>
          <button class="fx-btn fx-primary" type="button" data-act="compare"><Icon name="compare" /><span>Compare</span></button>
        </div>
        <div class="fx-tool" data-panel="archive" role="group" aria-label="Archive" hidden>
          <span class="fx-note fx-wrap">Collect files in the Archive tray under the Explorer to make a ZIP, 7z or gzip. Drop an archive there to extract it: ZIP, 7z, RAR, tar, gzip, xz, bz2, ISO, CAB.</span>
          <span class="fx-grow"></span>
          <button class="fx-btn" type="button" data-tray-add>Add selected to archive</button>
          <button class="fx-btn fx-primary" type="button" data-tray-focus>Go to Archive</button>
        </div>
      </div>

      <div class="fx-body">
        <div class="fx-main">
          <div class="fx-tabbar">
            <div class="fx-tabs" role="tablist" aria-label="Open documents" data-tabs></div>
            <div class="fx-doc-actions">
              <div class="segmented fx-seg fx-md-modes" role="radiogroup" aria-label="Markdown view" data-md-modes hidden>
                <label><input type="radio" name="mdView" value="edit" checked /><span>Editor</span></label>
                <label><input type="radio" name="mdView" value="split" /><span>Split</span></label>
                <label><input type="radio" name="mdView" value="preview" /><span>Preview</span></label>
              </div>
              <button class="fx-ib" type="button" data-md-html aria-label="Download as HTML" title="Download as HTML" hidden><Icon name="code" /></button>
              <button class="fx-ib" type="button" data-copy aria-label="Copy text" title="Copy text"><Icon name="copy" /></button>
              <button class="fx-ib" type="button" data-download aria-label="Download" title="Download (Ctrl/Cmd+S)"><Icon name="download" /></button>
              <button class="fx-ib" type="button" data-close aria-label="Close tab" title="Close tab (Alt+W)"><Icon name="xmark" /></button>
            </div>
          </div>

          <div class="fx-editor" id="fx-editor" role="tabpanel" data-editor>
            <div class="fx-code" data-code hidden>
              <div class="fx-curline" data-curline aria-hidden="true"></div>
              <div class="fx-gutter" aria-hidden="true"><div data-gutter></div></div>
              <div class="fx-ta">
                <pre class="fx-hl" aria-hidden="true"><code data-hl></code></pre>
                <textarea data-text spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off" aria-label="Document text" aria-describedby="fx-keys"></textarea>
              </div>
            </div>
            <article class="fx-md" data-md tabindex="0" aria-label="Markdown preview" hidden></article>
            <section class="fx-diff" data-diff hidden aria-label="Comparison">
              <div class="fx-diff-head">
                <span class="fx-diff-names" data-diff-names></span>
                <span class="fx-diff-sum" data-diff-sum></span>
                <span class="fx-grow"></span>
                <span class="fx-note" data-diff-pos></span>
                <button class="fx-ib" type="button" data-diff-prev aria-label="Previous change (P or Alt+Up)" title="Previous change (P)"><Icon name="arrow-up" /></button>
                <button class="fx-ib" type="button" data-diff-next aria-label="Next change (N or Alt+Down)" title="Next change (N)"><Icon name="arrow-down" /></button>
              </div>
              <p class="fx-diff-notice" data-diff-notice hidden></p>
              <div class="fx-diff-body" data-diff-body tabindex="0" role="region" aria-label="Differences. N and P move between changes."></div>
            </section>
            <div class="fx-hex" data-hex hidden tabindex="0" role="region" aria-label="File preview">
              <dl class="fx-info" data-info></dl>
              <button class="btn fx-hex-tray" type="button" data-hex-tray hidden><Icon name="files" /><span></span></button>
              <pre data-hexdump></pre>
            </div>
            <div class="fx-empty" data-empty-state>
              <div class="fx-ghost-doc">
                <div class="fx-ghost-gutter" aria-hidden="true">{Array.from({ length: 14 }, (_, i) => <span>{i + 1}</span>)}</div>
                <div class="fx-ghost-lines">
                  <input class="fx-ghost-input" type="text" data-start-typing placeholder="Start typing…" aria-label="Start a new document" autocomplete="off" spellcheck="false" />
                  <div class="fx-ghost-text" aria-hidden="true">
                    <span><i style="width: 38%"></i></span>
                    <span><i style="width: 12%"></i><i style="width: 31%"></i></span>
                    <span class="in"><i style="width: 24%"></i><i style="width: 18%"></i></span>
                    <span class="in2"><i style="width: 44%"></i></span>
                    <span class="in"><i style="width: 9%"></i></span>
                    <span></span>
                    <span><i style="width: 27%"></i><i style="width: 14%"></i></span>
                    <span class="in"><i style="width: 36%"></i></span>
                    <span><i style="width: 6%"></i></span>
                  </div>
                </div>
              </div>
              <div class="fx-dropzone">
                <svg class="fx-drop-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M14 30H11a7 7 0 0 1-1-13.9A11 11 0 0 1 31.4 13 9 9 0 1 1 36 30h-2" /><path d="M24 22v16M18 28l6-6 6 6" /></svg>
                <p class="fx-empty-title">Drop files here or choose files</p>
                <div class="fx-empty-actions">
                  <button class="btn btn-primary" type="button" data-open><Icon name="upload" />Choose files</button>
                  <button class="btn" type="button" data-paste><Icon name="paste" />Paste from clipboard</button>
                </div>
                <p class="fx-empty-hint">Text up to 50 MB · JavaScript up to 10 MB · archives: ZIP, 7z, gzip; extracts 7z, RAR, tar, xz, bz2 and more · up to 500 MB.</p>
                <p class="fx-empty-hint" id="fx-keys">Tab inserts two spaces; press Esc, then Tab, to leave the editor. Ctrl/Cmd+S downloads, Ctrl/Cmd+Shift+F formats JSON, Alt+W closes the tab.</p>
              </div>
            </div>
          </div>

          <section class="fx-panel" aria-labelledby="fx-out-title">
            <div class="pane-resizer fx-resize-out" role="separator" aria-orientation="horizontal" aria-label="Resize Output panel" aria-controls="fx-out" tabindex="0" data-resize-out hidden></div>
            <div class="fx-panel-head">
              <button class="fx-panel-toggle" type="button" aria-expanded="false" aria-controls="fx-out" data-out-toggle>
                <span class="fx-chev" aria-hidden="true"></span><span id="fx-out-title">Output</span><span class="fx-badge" data-problems hidden></span>
              </button>
              <button class="fx-ib" type="button" data-out-clear aria-label="Clear output" title="Clear output"><Icon name="trash" /></button>
            </div>
            <ol class="fx-out" id="fx-out" data-out hidden></ol>
          </section>
        </div>

        <aside class="fx-explorer" id="fx-explorer" aria-label="Explorer">
          <div class="pane-resizer fx-resize-side" role="separator" aria-orientation="vertical" aria-label="Resize Explorer" aria-controls="fx-explorer" tabindex="0" data-resize-side title="Drag or use arrow keys to resize; double-click to reset"></div>
          <div class="fx-pane-head">
            <input type="checkbox" data-select-all aria-label="Select all files" />
            <span class="fx-pane-title">Explorer</span>
            <span class="fx-note" data-count></span>
          </div>
          <ul class="fx-files" data-files aria-label="Files"></ul>
          <p class="fx-files-empty" data-files-empty>No files yet. Open, drop or paste files.</p>
          <div class="fx-selbar" data-selbar hidden>
            <span data-sel-count></span>
            <button class="fx-btn" type="button" data-tray-add>Add to archive</button>
            <button class="fx-btn" type="button" data-sel-compare hidden>Compare</button>
            <button class="fx-ib" type="button" data-sel-clear aria-label="Clear selection" title="Clear selection"><Icon name="xmark" /></button>
          </div>

          <section class="fx-tray" data-tray tabindex="-1" aria-labelledby="fx-tray-title" aria-describedby="fx-tray-help">
            <div class="fx-tray-head">
              <Icon name="files" />
              <h2 class="fx-pane-title" id="fx-tray-title">Archive</h2>
              <span class="fx-note" data-tray-count></span>
              <button class="fx-ib" type="button" data-tray-clear aria-label="Empty the archive tray" title="Empty the tray"><Icon name="trash" /></button>
            </div>
            <div class="fx-tray-drop" data-tray-drop>
              <ul class="fx-tray-list" data-tray-list aria-label="Files in the archive tray"></ul>
              <p class="fx-tray-empty" id="fx-tray-help">Drop files here, or drag them from the list (keyboard: tick files, then Add to archive). Makes ZIP, 7z or gzip; extracts ZIP, 7z, RAR, tar, gzip, xz, bz2, ISO, CAB.</p>
            </div>
            <div class="fx-tray-opts">
              <div class="segmented fx-seg fx-fmt" role="radiogroup" aria-label="Archive format">
                <label><input type="radio" name="fmt" value="zip" checked /><span>ZIP</span></label>
                <label><input type="radio" name="fmt" value="7z" /><span>7z</span></label>
                <label title="Compresses a single file"><input type="radio" name="fmt" value="gz" /><span>gzip</span></label>
              </div>
              <label class="fx-tray-name" data-fmt-name><span class="fx-label">Name</span><input type="text" name="zipName" value="archive" autocomplete="off" spellcheck="false" /><span class="fx-note" data-ext>.zip</span></label>
              <div class="segmented fx-seg fx-level" role="radiogroup" aria-label="Compression" data-levels="zip">
                <label><input type="radio" name="level" value="0" /><span>Store</span></label>
                <label><input type="radio" name="level" value="6" checked /><span>Balanced</span></label>
                <label><input type="radio" name="level" value="9" /><span>Smallest</span></label>
              </div>
              <div class="segmented fx-seg fx-level" role="radiogroup" aria-label="Compression" data-levels="7z" hidden>
                <label><input type="radio" name="level7" value="0" /><span>Store</span></label>
                <label><input type="radio" name="level7" value="1" /><span>Fast</span></label>
                <label><input type="radio" name="level7" value="5" checked /><span>Normal</span></label>
                <label><input type="radio" name="level7" value="9" /><span>Ultra</span></label>
              </div>
              <label class="fx-tray-name" data-fmt-pass hidden><span class="fx-label">Password</span><input type="password" name="zipPass" autocomplete="new-password" placeholder="Optional" aria-describedby="fx-pass-note" /></label>
              <p class="fx-tray-note" id="fx-pass-note" data-fmt-pass hidden>With a password, contents and file names are encrypted (AES-256). It is not stored anywhere.</p>
            </div>
            <div class="fx-tray-acts">
              <button class="fx-btn" type="button" data-act="create">Create ZIP</button>
              <button class="fx-btn" type="button" data-act="extract" hidden>Extract</button>
            </div>
            <div class="fx-tray-busy" data-tray-busy hidden>
              <ProgressDial data-dial />
              <p data-busy-text></p>
              <button class="btn" type="button" data-cancel>Cancel</button>
            </div>
          </section>

          <dialog class="fx-pw" data-pw-dialog aria-labelledby="fx-pw-title">
            <form method="dialog">
              <h2 id="fx-pw-title"><Icon name="lock" /> Password needed</h2>
              <p data-pw-text></p>
              <label class="fx-pw-field"><span>Password</span><input type="password" name="pw" autocomplete="off" required /></label>
              <p class="fx-pw-error" data-pw-error role="alert" hidden></p>
              <div class="fx-pw-acts">
                <button class="btn" type="button" value="cancel" data-pw-cancel>Cancel</button>
                <button class="btn btn-primary" value="ok">Extract</button>
              </div>
            </form>
          </dialog>
        </aside>
      </div>

      <footer class="fx-status">
        <span class="fx-msg" data-msg role="status" aria-live="polite"></span>
        <progress data-progress max="1" hidden aria-label="Progress"></progress>
        <span class="fx-grow"></span>
        <span data-sb-pos></span>
        <span data-sb-size></span>
        <span data-sb-enc>UTF-8</span>
        <button class="fx-sb-btn" type="button" data-sb-json hidden></button>
        <span data-sb-hl></span>
        <select class="fx-sb-select" data-sb-syntax aria-label="Language" title="Language for highlighting" hidden></select>
        <span data-sb-lang></span>
      </footer>

      <template data-icons>
        {rowIcons.map((n) => <span data-i={n}><Icon name={n} /></span>)}
      </template>
    </section>
  </div>
</Base>

<style is:global>
  .fx {
    --fx-w: min(100vw - 2rem, 1280px);
    --fx-line: 20px;
    /* Archive tray: a calm step darker than the Explorer around it. */
    --fx-tray: color-mix(in srgb, var(--fg) 3.5%, var(--app-side));
    --fx-hover: var(--app-hover);
    --fx-sel: var(--app-selected);
    --fx-add-bg: light-dark(#e7f5ec, #13281b);
    --fx-add-mark: light-dark(#b4e5c3, #1f5433);
    --fx-add-fg: light-dark(#0f6b2f, #6fdc8c);
    --fx-del-bg: light-dark(#fdeeed, #2e1717);
    --fx-del-mark: light-dark(#f6c2bd, #6b2626);
    --fx-del-fg: light-dark(#b42318, #ff8a80);
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    width: var(--fx-w);
    height: clamp(560px, calc(100dvh - 140px), 920px);
    margin: 1.5rem calc((100% - var(--fx-w)) / 2) 0;
    background: var(--surface);
    border: 1px solid var(--app-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    font-size: 0.875rem;
    position: relative;
  }
  .fx .icon svg { width: 17px; height: 17px; }
  .fx.fx-over::after { content: ''; position: absolute; inset: 0; z-index: 30; pointer-events: none; border: 3px solid var(--accent); border-radius: inherit; background: color-mix(in srgb, var(--accent) 7%, transparent); }

  /* Buttons */
  .fx-btn, .fx-ib, .fx-sb-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem; flex: none;
    border: 1px solid transparent; border-radius: 7px; background: transparent; color: var(--fg);
    font: inherit; font-weight: 600; cursor: pointer; white-space: nowrap;
  }
  .fx-btn { height: 30px; padding: 0 0.65rem; }
  .fx-ib { width: 30px; height: 30px; color: var(--muted); }
  .fx-btn:hover:not(:disabled), .fx-ib:hover:not(:disabled) { background: var(--fx-hover); color: var(--fg); }
  .fx-btn:disabled, .fx-ib:disabled { opacity: 0.4; cursor: default; }
  .fx-primary { background: var(--accent); color: var(--accent-fg); }
  .fx-primary:hover:not(:disabled) { background: color-mix(in srgb, var(--accent) 88%, var(--fg)); color: var(--accent-fg); }
  .fx :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-radius: 6px; }

  /* Top bar and tool row */
  .fx-top { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.6rem 0.4rem 0.75rem; background: var(--app-bar); border-bottom: 1px solid var(--app-line); flex-wrap: wrap; }
  .fx-title { display: inline-flex; align-items: center; gap: 0.45rem; font-weight: 700; font-size: 0.95rem; letter-spacing: -0.01em; }
  .fx-title .icon { color: var(--accent); }
  .fx-top .mode { margin-right: 0.5rem; }
  .fx-modes { padding: 2px; border-radius: 9px; }
  .fx .segmented span { padding: 0.2rem 0.65rem; border-radius: 7px; font-size: 0.84rem; }
  .fx-top-actions { display: flex; align-items: center; gap: 0.15rem; margin-left: auto; }
  /* The Explorer sits on the right: mirror the sidebar glyph. */
  .fx-side-toggle { margin-left: 0.25rem; }
  .fx-side-toggle .icon { transform: scaleX(-1); }
  .fx-side-toggle[aria-expanded='true'] { background: var(--fx-hover); color: var(--fg); }
  .fx-tools { border-bottom: 1px solid var(--app-line); background: var(--app-bar); }
  .fx-tool { display: flex; align-items: center; gap: 0.45rem 0.6rem; padding: 0.4rem 0.6rem 0.4rem 0.75rem; min-height: 44px; flex-wrap: wrap; }
  .fx-tool[hidden] { display: none; }
  .fx-label { color: var(--muted); font-size: 0.75rem; font-weight: 650; text-transform: uppercase; letter-spacing: 0.06em; }
  .fx-grow { flex: 1; }
  .fx-note { color: var(--muted); font-size: 0.82rem; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fx-note.fx-wrap { white-space: normal; flex: 1 1 18rem; }
  .fx-check { display: inline-flex; align-items: center; gap: 0.35rem; }
  .fx-check input, .fx-pane-head input, .fx-row input { accent-color: var(--accent); margin: 0; }

  /* Editor (left) + Explorer (right) */
  .fx-body { display: grid; grid-template-columns: minmax(0, 1fr) var(--fx-sw, 280px); min-height: 0; position: relative; }
  .fx:has([data-toggle-explorer][aria-expanded='false']) .fx-body { grid-template-columns: minmax(0, 1fr); }
  .fx-explorer { position: relative; display: flex; flex-direction: column; min-height: 0; min-width: 0; background: var(--app-side); border-left: 1px solid var(--app-line); }

  /* Shared .pane-resizer handles, positioned on the pane edges here. */
  .fx .fx-resize-side { position: absolute; top: 0; bottom: 0; left: -3px; margin: 0; }
  .fx-panel { position: relative; }
  .fx .fx-resize-out { position: absolute; left: 0; right: 0; top: -3px; margin: 0; }
  .fx-field { display: inline-flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .fx-field select { max-width: 12rem; height: 30px; padding: 0 0.4rem; border-radius: 7px; font-size: 0.84rem; }
  .fx-explorer[hidden] { display: none; }
  .fx-pane-head { display: flex; align-items: center; gap: 0.5rem; padding: 0.55rem 0.75rem 0.4rem; }
  .fx-pane-title { margin: 0; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .fx-pane-head .fx-note { margin-left: auto; font-size: 0.75rem; }
  .fx-files { position: relative; list-style: none; margin: 0; padding: 0 0.35rem 0.35rem; overflow-y: auto; flex: 1; min-height: 3rem; }
  .fx-files:empty { display: none; }
  .fx-files-empty { flex: 1; margin: 0; padding: 0.4rem 0.75rem; color: var(--muted); font-size: 0.8rem; }
  .fx-row { display: flex; align-items: center; gap: 0.15rem; padding-left: 0.4rem; border-radius: 6px; }
  .fx-row:hover { background: var(--fx-hover); }
  .fx-row[data-active] { background: var(--fx-sel); }
  .fx-row.fx-dragging { opacity: 0.5; }
  .fx-open { display: flex; align-items: center; gap: 0.45rem; flex: 1; min-width: 0; height: 28px; padding: 0 0.3rem; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .fx-open .icon, .fx-tray-row > .icon { color: var(--muted); }
  .fx-row[data-kind='json'] .fx-open .icon { color: light-dark(#a16207, #f2c14e); }
  .fx-row[data-kind='js'] .fx-open .icon { color: light-dark(#0f766e, #4fd1c5); }
  .fx-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fx-dir { color: var(--muted); }
  .fx-size { color: var(--muted); font-size: 0.75rem; font-variant-numeric: tabular-nums; }
  .fx-acts { display: none; }
  .fx-row:is(:hover, :focus-within) .fx-acts { display: flex; }
  .fx-row:is(:hover, :focus-within) .fx-size { display: none; }
  .fx-acts .fx-ib, .fx-tray-row .fx-ib { width: 24px; height: 24px; }
  .fx-acts .fx-ib .icon svg, .fx-tray-row .fx-ib .icon svg { width: 15px; height: 15px; }
  .fx-rename { flex: 1; min-width: 0; height: 26px; padding: 0 0.4rem; border-radius: 5px; font-size: 0.85rem; }
  .fx-selbar { display: flex; align-items: center; gap: 0.35rem; margin: 0 0.35rem 0.4rem; padding: 0.2rem 0.2rem 0.2rem 0.6rem; border-radius: 8px; background: var(--fx-sel); font-size: 0.8rem; }
  .fx-selbar > span { margin-right: auto; color: var(--muted); }
  .fx-selbar .fx-btn { height: 26px; padding: 0 0.55rem; background: var(--surface); border-color: var(--border); }

  /* Archive tray: bottom of the Explorer. */
  .fx-tray { position: relative; display: flex; flex-direction: column; gap: 0.5rem; flex: none; max-height: 62%; padding: 0.5rem 0.6rem 0.65rem; background: var(--fx-tray); border-top: 1px solid var(--app-line); transition: box-shadow 0.25s; }
  .fx-tray:focus { outline: none; }
  .fx-tray:focus-visible, .fx-tray[data-hl] { box-shadow: inset 0 0 0 2px var(--accent); }
  .fx-tray-head { display: flex; flex: none; align-items: center; gap: 0.45rem; }
  .fx-tray-head > .icon { color: var(--muted); }
  .fx-tray-head .fx-note { margin-left: auto; font-size: 0.75rem; }
  .fx-tray-head .fx-ib { width: 26px; height: 26px; }
  .fx-tray-drop { display: flex; flex-direction: column; min-height: 4.5rem; overflow-y: auto; border: 1.5px dashed color-mix(in srgb, var(--muted) 40%, transparent); border-radius: 9px; background: color-mix(in srgb, var(--surface) 55%, transparent); transition: border-color 0.12s, background-color 0.12s; }
  .fx-tray.over .fx-tray-drop { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 9%, var(--surface)); }
  .fx-tray-list { list-style: none; margin: 0; padding: 0.25rem; }
  .fx-tray-list:empty { display: none; }
  .fx-tray-row { display: flex; align-items: center; gap: 0.4rem; height: 28px; padding-left: 0.35rem; border-radius: 6px; }
  .fx-tray-row:hover { background: var(--fx-hover); }
  .fx-tray-empty { margin: auto; padding: 0.6rem 0.75rem; color: var(--muted); font-size: 0.78rem; text-align: center; }
  .fx-tray-list:not(:empty) + .fx-tray-empty { display: none; }
  .fx-tray-opts { display: grid; flex: none; gap: 0.4rem; }
  .fx-tray-name { display: flex; align-items: center; gap: 0.4rem; }
  .fx-tray-name input { flex: 1; min-width: 0; height: 28px; padding: 0 0.45rem; border-radius: 7px; font-size: 0.84rem; }
  .fx-tray-name .fx-label { width: 3.2rem; }
  .fx .fx-level { display: flex; }
  .fx .fx-level label { flex: 1; text-align: center; }
  .fx .fx-level span { padding: 0.18rem 0.3rem; font-size: 0.8rem; }
  .fx-tray-acts { display: flex; flex: none; flex-wrap: wrap; gap: 0.35rem; }
  .fx-tray-acts .fx-btn { flex: 1; border-color: var(--border); background: var(--surface); }
  .fx-tray-acts .fx-btn.fx-primary { background: var(--accent); border-color: var(--accent); }
  .fx-tray-acts .fx-btn[hidden] { display: none; }
  .fx-tray-busy { position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.75rem; text-align: center; background: color-mix(in srgb, var(--fx-tray) 88%, transparent); backdrop-filter: blur(2px); }
  .fx-tray-busy[hidden] { display: none; }
  .fx .fx-fmt { display: flex; }
  .fx .fx-fmt label { flex: 1; text-align: center; }
  .fx-fmt input:disabled + span { opacity: 0.4; }
  .fx-tray-note { margin: 0; color: var(--muted); font-size: 0.75rem; }
  .fx-pw form { display: grid; gap: 0.75rem; justify-content: stretch; margin: 0; }
  .fx-pw h2 { margin: 0; }
  .fx-pw p { margin: 0; overflow-wrap: anywhere; }
  .fx-pw-field { display: grid; gap: 0.3rem; font-weight: 600; font-size: 0.9rem; }
  .fx-pw-error { color: var(--error); font-size: 0.88rem; }
  .fx-pw-acts { display: flex; gap: 0.5rem; justify-content: flex-end; }
  .fx-tray-busy p { margin: 0; font-weight: 600; font-size: 0.85rem; }
  .fx-tray-busy .btn { padding: 0.35rem 0.9rem; font-size: 0.85rem; }

  .fx-main { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr) auto; min-width: 0; min-height: 0; }
  .fx-tabbar { display: flex; align-items: stretch; background: var(--app-bar); border-bottom: 1px solid var(--app-line); min-height: 36px; }
  .fx-tabs { position: relative; display: flex; flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: thin; }
  .fx-tab {
    display: inline-flex; align-items: center; gap: 0.4rem; flex: none; max-width: 15rem; padding: 0 0.4rem 0 0.75rem;
    border: 0; border-right: 1px solid var(--app-line); background: transparent; color: var(--muted); font: inherit; font-size: 0.84rem; cursor: pointer;
    box-shadow: inset 0 2px 0 transparent;
  }
  .fx-tab[aria-selected='true'] { background: var(--surface); color: var(--fg); box-shadow: inset 0 2px 0 var(--accent); }
  .fx-tab:focus-visible { outline-offset: -2px; }
  .fx-tab-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fx-tab-x { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 5px; opacity: 0.6; }
  .fx-tab-x:hover { opacity: 1; background: var(--fx-hover); }
  .fx-tab-x .icon svg { width: 14px; height: 14px; }
  .fx-doc-actions { display: flex; align-items: center; gap: 0.1rem; padding: 0 0.35rem; }

  .fx-editor { position: relative; min-height: 0; background: var(--surface); }
  .fx-code { position: absolute; inset: 0; display: flex; overflow: hidden; }
  .fx-code[hidden], .fx-hex[hidden], .fx-empty[hidden] { display: none; }
  .fx-gutter {
    flex: none; width: var(--fx-gw, 5ch); overflow: hidden; padding-right: 0.9ch; text-align: right; user-select: none;
    font: 13px/var(--fx-line) var(--mono); color: color-mix(in srgb, var(--muted) 70%, transparent); border-right: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    box-sizing: content-box;
  }
  .fx-gutter > div { white-space: pre; padding-top: 8px; will-change: transform; }
  .fx-curline { position: absolute; left: 0; right: 0; height: var(--fx-line); top: 8px; background: color-mix(in srgb, var(--fg) 4.5%, transparent); pointer-events: none; }
  /* Highlight overlay: the textarea (transparent text, visible caret) sits exactly over a highlighted <pre>. */
  .fx-ta { position: relative; flex: 1; min-width: 0; }
  .fx-hl, .fx-code textarea {
    margin: 0; padding: 8px 12px 8px 10px; border: 0; border-radius: 0;
    font: 13px/var(--fx-line) var(--mono); letter-spacing: 0; font-variant-ligatures: none; tab-size: 4;
    white-space: pre; overflow-wrap: normal;
  }
  .fx-hl { position: absolute; inset: 0; overflow: hidden; pointer-events: none; color: var(--fg); }
  .fx-hl code { display: block; font: inherit; will-change: transform; }
  .fx-code:not([data-hl-on]) .fx-hl { display: none; }
  .fx-code textarea { position: absolute; inset: 0; width: 100%; height: 100%; min-height: 0; resize: none; background: transparent; color: var(--fg); overflow: auto; }
  .fx-code[data-hl-on] textarea { color: transparent; caret-color: var(--fg); }
  .fx-code[data-hl-on] textarea::selection { color: transparent; background: color-mix(in srgb, var(--accent) 26%, transparent); }
  .fx-code textarea:focus-visible { outline: 1px solid color-mix(in srgb, var(--accent) 70%, transparent); outline-offset: -1px; border-radius: 0; }

  /* Syntax colours (GitHub-like, ≥ 4.5:1 on --surface in both themes). */
  .fx {
    --hl-keyword: light-dark(#8250df, #d2a8ff); --hl-string: light-dark(#0a3069, #a5d6ff); --hl-number: light-dark(#0550ae, #79c0ff);
    --hl-comment: light-dark(#5f6770, #8b949e); --hl-title: light-dark(#6639ba, #d2a8ff); --hl-attr: light-dark(#0550ae, #79c0ff);
    --hl-builtin: light-dark(#953800, #ffa657); --hl-tag: light-dark(#116329, #7ee787); --hl-meta: light-dark(#5f6770, #8b949e);
  }
  .hljs-keyword, .hljs-doctag, .hljs-template-tag { color: var(--hl-keyword); }
  .hljs-string, .hljs-regexp, .hljs-template-variable, .hljs-link { color: var(--hl-string); }
  .hljs-number, .hljs-literal, .hljs-attr, .hljs-attribute, .hljs-property, .hljs-selector-attr, .hljs-selector-pseudo, .hljs-section { color: var(--hl-number); }
  .hljs-comment, .hljs-quote, .hljs-meta, .hljs-code { color: var(--hl-comment); }
  .hljs-title, .hljs-title.function_, .hljs-title.class_ { color: var(--hl-title); }
  .hljs-built_in, .hljs-type, .hljs-variable, .hljs-params, .hljs-bullet, .hljs-symbol, .hljs-subst { color: var(--hl-builtin); }
  .hljs-tag, .hljs-name, .hljs-selector-tag, .hljs-selector-class, .hljs-selector-id, .hljs-addition { color: var(--hl-tag); }
  .hljs-deletion { color: var(--error); }
  .hljs-section, .hljs-strong { font-weight: 700; }
  .hljs-emphasis { font-style: italic; }

  /* Markdown preview (Preview or Split view) */
  .fx-md { position: absolute; inset: 0; overflow: auto; padding: 1.25rem 2rem 3rem; background: var(--surface); font: 15px/1.65 var(--font); overflow-wrap: anywhere; }
  .fx-md[hidden] { display: none; }
  .fx-md:focus-visible { outline: 1px solid color-mix(in srgb, var(--accent) 70%, transparent); outline-offset: -1px; border-radius: 0; }
  .fx-editor[data-md-view='split'] .fx-code { right: 50%; }
  .fx-editor[data-md-view='split'] .fx-md { left: 50%; border-left: 1px solid var(--app-line); }
  .fx-md > :first-child { margin-top: 0; }
  .fx-md h1, .fx-md h2, .fx-md h3 { margin: 1.4em 0 0.5em; line-height: 1.25; }
  .fx-md h1 { font-size: 1.7rem; padding-bottom: 0.3em; border-bottom: 1px solid var(--app-line); }
  .fx-md h2 { font-size: 1.35rem; padding-bottom: 0.25em; border-bottom: 1px solid var(--app-line); }
  .fx-md h3 { font-size: 1.12rem; }
  .fx-md p, .fx-md ul, .fx-md ol, .fx-md table, .fx-md pre, .fx-md blockquote { margin: 0 0 1em; }
  .fx-md code { font: 0.88em var(--mono); padding: 0.1em 0.35em; border-radius: 5px; background: var(--surface-2); }
  .fx-md pre { padding: 0.8rem 1rem; overflow: auto; border-radius: 9px; background: var(--surface-2); }
  .fx-md pre code { padding: 0; background: none; font-size: 0.85rem; line-height: 1.55; }
  .fx-md blockquote { padding-left: 1rem; border-left: 3px solid var(--app-line); color: var(--muted); }
  .fx-md table { border-collapse: collapse; display: block; overflow-x: auto; }
  .fx-md th, .fx-md td { padding: 0.35rem 0.7rem; border: 1px solid var(--app-line); }
  .fx-md th { background: var(--surface-2); text-align: left; }
  .fx-md li:has(> input[type='checkbox']) { list-style: none; margin-left: -1.3em; }
  .fx-md input[type='checkbox'] { margin: 0 0.45em 0 0; accent-color: var(--accent); vertical-align: -0.1em; }
  .fx-md hr { border: 0; border-top: 1px solid var(--app-line); margin: 1.5em 0; }
  .fx-md .md-img-off { color: var(--muted); font-style: italic; }
  .fx-md-modes { padding: 2px; border-radius: 8px; margin-right: 0.25rem; }
  .fx .fx-md-modes span { padding: 0.1rem 0.55rem; font-size: 0.78rem; }

  /* Comparison view */
  .fx-diff { position: absolute; inset: 0; display: flex; flex-direction: column; }
  .fx-diff[hidden] { display: none; }
  .fx-diff-head { display: flex; align-items: center; flex-wrap: wrap; gap: 0.3rem 0.75rem; min-height: 38px; padding: 0.2rem 0.4rem 0.2rem 0.75rem; border-bottom: 1px solid var(--app-line); }
  .fx-diff-names { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
  .fx-diff-sum { font-variant-numeric: tabular-nums; color: var(--muted); font-size: 0.82rem; white-space: nowrap; }
  .fx-sum-add { color: var(--fx-add-fg); font-weight: 700; }
  .fx-sum-del { color: var(--fx-del-fg); font-weight: 700; }
  .fx-diff-notice { margin: 0; padding: 0.4rem 0.75rem; background: var(--cloud-bg); color: color-mix(in srgb, var(--cloud) 60%, var(--fg)); font-size: 0.8rem; }
  .fx-diff-body { position: relative; flex: 1; min-height: 0; overflow: auto; padding-bottom: 1rem; font: 12.5px/1.6 var(--mono); }
  .fx-diff-body:focus-visible { outline: 1px solid color-mix(in srgb, var(--accent) 70%, transparent); outline-offset: -1px; border-radius: 0; }
  .fx-dl { display: grid; grid-template-columns: var(--fx-dn) 1.6em minmax(0, 1fr) var(--fx-dn) 1.6em minmax(0, 1fr); }
  .fx-diff[data-unified] .fx-dl { grid-template-columns: var(--fx-dn) var(--fx-dn) 1.6em minmax(0, 1fr); }
  .fx-dl > span { min-width: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  .fx-dn { padding-right: 0.5ch; text-align: right; color: color-mix(in srgb, var(--muted) 75%, transparent); user-select: none; }
  .fx-dm { text-align: center; font-weight: 700; user-select: none; }
  .fx-dt { padding-right: 0.75rem; }
  .fx-diff:not([data-unified]) .fx-dn:nth-child(4) { border-left: 1px solid var(--app-line); }
  .fx-dl [data-s='del'] { background: var(--fx-del-bg); }
  .fx-dl [data-s='add'] { background: var(--fx-add-bg); }
  .fx-dm[data-s='del'] { color: var(--fx-del-fg); }
  .fx-dm[data-s='add'] { color: var(--fx-add-fg); }
  .fx-dl[data-s='del'] > * { background: var(--fx-del-bg); }
  .fx-dl[data-s='add'] > * { background: var(--fx-add-bg); }
  .fx-dl [data-s='none'] { background: repeating-linear-gradient(135deg, transparent 0 5px, color-mix(in srgb, var(--border) 55%, transparent) 5px 6px); }
  .fx-dt[data-s='del'] mark { background: var(--fx-del-mark); color: inherit; border-radius: 2px; }
  .fx-dt[data-s='add'] mark { background: var(--fx-add-mark); color: inherit; border-radius: 2px; }
  .fx-dl[data-cur] > :first-child { box-shadow: inset 3px 0 0 var(--accent); }
  .fx-fold { display: block; width: 100%; padding: 0.2rem 0.75rem; border: 0; border-block: 1px dashed var(--app-line); background: var(--app-stage); color: var(--muted); font: inherit; text-align: left; cursor: pointer; }
  .fx-fold:hover { color: var(--fg); }
  .fx-diff-same { margin: 0; padding: 1rem 0.75rem; color: var(--local); font-family: var(--font); }

  .fx-hex { position: absolute; inset: 0; overflow: auto; padding: 1rem 1.25rem; }
  .fx-info { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; margin: 0 0 1rem; }
  .fx-info dt { color: var(--muted); }
  .fx-info dd { margin: 0; font-weight: 600; word-break: break-all; }
  .fx-hex-tray { margin: 0 0 1rem; padding: 0.4rem 0.85rem; font-size: 0.88rem; }
  .fx-hex pre { margin: 0; font: 12.5px/1.6 var(--mono); color: var(--muted); }

  /* Empty state: a faint document whose first line is a real input, fading into the drop area. */
  .fx-empty { position: absolute; inset: 0; display: flex; flex-direction: column; overflow: auto; }
  .fx-ghost-doc {
    display: flex; flex: none; height: calc(14 * var(--fx-line) + 8px); padding-top: 8px; overflow: hidden;
    font: 13px/var(--fx-line) var(--mono);
    -webkit-mask-image: linear-gradient(to bottom, #000 0 18%, transparent 100%); mask-image: linear-gradient(to bottom, #000 0 18%, transparent 100%);
  }
  .fx-ghost-gutter { flex: none; width: 4ch; padding-right: 0.9ch; box-sizing: content-box; text-align: right; user-select: none; color: color-mix(in srgb, var(--muted) 70%, transparent); border-right: 1px solid color-mix(in srgb, var(--border) 60%, transparent); }
  .fx-ghost-gutter span { display: block; height: var(--fx-line); }
  .fx-ghost-lines { flex: 1; min-width: 0; }
  .fx .fx-ghost-input {
    display: block; width: 100%; height: var(--fx-line); margin: 0; padding: 0 12px 0 10px; border: 0; border-radius: 0;
    font: inherit; color: var(--fg); background: color-mix(in srgb, var(--fg) 4.5%, transparent); outline: none;
  }
  .fx-ghost-input::placeholder { color: var(--muted); opacity: 1; }
  .fx .fx-ghost-input:focus-visible { outline: none; box-shadow: inset 2px 0 0 var(--accent); }
  .fx-ghost-text { padding: 0 12px 0 10px; }
  .fx-ghost-text span { display: flex; gap: 1ch; align-items: center; height: var(--fx-line); }
  .fx-ghost-text .in { padding-left: 2ch; }
  .fx-ghost-text .in2 { padding-left: 4ch; }
  .fx-ghost-text i { display: block; height: 7px; border-radius: 4px; background: color-mix(in srgb, var(--muted) 24%, transparent); }
  .fx-dropzone {
    position: relative; flex: 1 0 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.65rem;
    margin: -4.5rem 1.5rem 1.5rem; padding: 1.5rem 1rem; text-align: center;
    border: 1.5px dashed color-mix(in srgb, var(--muted) 35%, transparent); border-radius: 14px; transition: border-color 0.15s, background-color 0.15s;
  }
  .fx.fx-over .fx-dropzone { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .fx-drop-icon { width: 44px; height: 44px; fill: none; stroke: color-mix(in srgb, var(--muted) 80%, transparent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .fx-empty-title { margin: 0; font-size: 1.05rem; font-weight: 650; }
  .fx-empty-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; }
  .fx-empty-actions .btn { padding: 0.5rem 0.95rem; font-size: 0.9rem; }
  .fx-empty-hint { margin: 0; max-width: 54ch; color: var(--muted); font-size: 0.8rem; }

  /* Output panel */
  .fx-panel { border-top: 1px solid var(--app-line); background: var(--surface); }
  .fx-panel-head { display: flex; align-items: center; padding: 0 0.35rem 0 0.25rem; height: 32px; }
  .fx-panel-toggle { display: inline-flex; align-items: center; gap: 0.45rem; height: 26px; padding: 0 0.4rem; border: 0; border-radius: 6px; background: none; color: var(--muted); font: inherit; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; margin-right: auto; }
  .fx-panel-toggle:hover { color: var(--fg); }
  .fx-chev { width: 7px; height: 7px; border: solid currentColor; border-width: 0 1.5px 1.5px 0; transform: rotate(-45deg); transition: transform 0.12s; }
  [aria-expanded='true'] > .fx-chev { transform: rotate(45deg); }
  .fx-badge { min-width: 18px; padding: 0 5px; border-radius: 9px; background: var(--error); color: var(--surface); font-size: 0.7rem; letter-spacing: 0; line-height: 18px; text-align: center; }
  .fx-out { list-style: none; margin: 0; padding: 0 0.75rem 0.5rem; height: var(--fx-out-h, 132px); overflow-y: auto; font: 12.5px/1.5 var(--mono); }
  .fx-out li { display: flex; gap: 0.5rem; align-items: flex-start; padding: 0.15rem 0; }
  .fx-out .icon { margin-top: 2px; color: var(--muted); }
  .fx-out .icon svg { width: 15px; height: 15px; }
  .fx-out [data-kind='error'] .icon, .fx-out [data-kind='error'] .fx-out-text { color: var(--error); }
  .fx-out [data-kind='warn'] .icon { color: var(--cloud); }
  .fx-out [data-kind='ok'] .icon { color: var(--local); }
  .fx-out-text { flex: 1; min-width: 0; white-space: pre-wrap; word-break: break-word; }
  .fx-out-jump { flex: none; border: 0; background: none; padding: 0; color: var(--accent); font: inherit; text-decoration: underline; cursor: pointer; }

  /* Status bar */
  .fx-status { display: flex; align-items: center; gap: 0.25rem 1rem; padding: 0 0.75rem; min-height: 26px; background: var(--app-bar); border-top: 1px solid var(--app-line); color: var(--muted); font-size: 0.76rem; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; }
  .fx-status > span:empty { display: none; }
  .fx-msg { overflow: hidden; text-overflow: ellipsis; min-width: 0; flex: 0 1 auto; }
  .fx-msg[data-kind='error'] { color: var(--error); }
  .fx-msg[data-kind='ok'] { color: var(--local); }
  .fx-status progress { width: 110px; height: 6px; accent-color: var(--accent); }
  .fx-sb-btn { height: 20px; padding: 0 0.35rem; color: inherit; font-weight: 500; border-radius: 4px; }
  .fx-sb-btn:hover { background: var(--fx-hover); color: var(--fg); }
  .fx-sb-btn[data-state='valid'] { color: var(--local); }
  .fx-sb-btn[data-state='invalid'] { color: var(--error); }
