---
// Files app: a file list for many files and folders with sorting, manual order, bulk rename, archives and extraction.
// Behaviour: src/lib/files-app.ts.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import AppBar from '../../components/AppBar.astro';
import ModeBadge from '../../components/ModeBadge.astro';
import ProgressDial from '../../components/ProgressDial.astro';
import { categories, href } from '../../tools';

const cat = categories.find((c) => c.id === 'files')!;
// Cloned into client-built rows.
const rowIcons = ['doc', 'braces', 'code', 'files', 'images', 'pdf', 'audio', 'download', 'xmark', 'reverse'] as const;
const vars = ['name', 'ext', 'id', 'date', 'today', 'size'].map((v) => `{${v}}`);
---
<Base title={`${cat.label} · Tools`} description={cat.blurb}>
  <div class="tool-shell" data-wide>
    <div class="crumbs"><a href={href()}>All tools</a> / <a href={href() + '#files'}>{cat.label}</a></div>
    <div class="tool-head">
      <h1>{cat.label}</h1>
      <ModeBadge mode="local" />
    </div>
    <p class="tool-summary">{cat.blurb}</p>
    <div class="privacy-note privacy-local" role="note">
      <Icon name="lock" />
      <p><strong>Runs in your browser; nothing is uploaded.</strong> Renaming, compression and extraction all happen on this device. <a href={href('privacy')}>How we check</a></p>
    </div>

    <section class="fl" data-fl aria-label="Files">
      <header class="fl-top" data-top>
        <AppBar part="switch" current="files" />
        <div class="fl-acts">
          <button class="fl-btn" type="button" data-open title="Open files"><Icon name="plus" /><span>Open files</span></button>
          <button class="fl-btn" type="button" data-open-folder title="Open a folder with everything in it"><Icon name="folder" /><span>Open folder</span></button>
          <button class="fl-btn" type="button" data-remove disabled title="Remove the selected files from the list"><Icon name="trash" /><span>Remove</span></button>
          <button class="fl-btn" type="button" data-clear disabled title="Remove all files from the list"><Icon name="xmark" /><span>Clear all</span></button>
          <label class="fl-sort"><span class="fl-label">Sort</span>
            <select data-sort>
              <option value="manual">Manual order</option>
              <option value="name">Name A→Z</option>
              <option value="name-desc">Name Z→A</option>
              <option value="size">Size, smallest first</option>
              <option value="size-desc">Size, largest first</option>
              <option value="type">Type</option>
              <option value="date">Modified, oldest first</option>
              <option value="date-desc">Modified, newest first</option>
            </select>
          </label>
          <span class="fl-grow"></span>
          <button class="fl-btn" type="button" data-download-all disabled title="Download every file as one ZIP"><Icon name="download" /><span>Download all</span></button>
          <button class="fl-btn" type="button" data-toggle-inspector aria-expanded="false" aria-controls="fl-inspector" title="Show or hide Rename and Archive"><Icon name="sidebar" /><span>Rename &amp; archive</span></button>
          <AppBar part="actions" />
        </div>
        <input type="file" multiple data-input hidden />
        <input type="file" data-folder-input hidden />
      </header>

      <div class="fl-body" data-body>
        <div class="fl-main">
          <div class="fl-scroll" data-scroll>
            <table class="fl-table" data-table hidden>
              <caption class="visually-hidden">Files in archive and numbering order</caption>
              <thead>
                <tr>
                  <th class="fl-c-check" scope="col"><input type="checkbox" data-select-all aria-label="Select all files" /></th>
                  <th class="fl-c-grip" scope="col"><span class="visually-hidden">Order</span></th>
                  <th class="fl-c-name" scope="col">Name</th>
                  <th class="fl-c-new" scope="col">New name</th>
                  <th class="fl-c-type" scope="col">Type</th>
                  <th class="fl-c-size" scope="col">Size</th>
                  <th class="fl-c-date" scope="col">Modified</th>
                  <th class="fl-c-acts" scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
              </thead>
              <tbody data-rows></tbody>
            </table>
            <p class="visually-hidden" id="fl-order-help">Drag to reorder, or press Alt+Up or Alt+Down. The order sets {'{id}'} numbers and the order in archives.</p>
            <div class="fl-empty" data-empty>
              <svg class="fl-drop-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M14 30H11a7 7 0 0 1-1-13.9A11 11 0 0 1 31.4 13 9 9 0 1 1 36 30h-2" /><path d="M24 22v16M18 28l6-6 6 6" /></svg>
              <p class="fl-empty-title">Drop files or folders anywhere</p>
              <div class="fl-empty-actions">
                <button class="btn btn-primary" type="button" data-open><Icon name="upload" />Choose files</button>
                <button class="btn" type="button" data-open-folder><Icon name="folder" />Choose a folder</button>
              </div>
              <p class="fl-empty-hint">Sort, reorder and bulk rename · make ZIP, 7z or gzip · extract ZIP, 7z, RAR, tar, gzip, xz, bz2, ISO and CAB · archives up to 500 MB.</p>
            </div>
          </div>
          <footer class="fl-status">
            <span data-count></span>
            <span class="fl-msg" data-msg role="status" aria-live="polite"></span>
          </footer>
        </div>

        <aside class="fl-inspector" id="fl-inspector" data-inspector aria-label="Rename and archive" hidden>
          <div class="fl-tabs" role="tablist" aria-label="Panel">
            <button class="fl-tab" type="button" role="tab" id="fl-tab-rename" data-panel-btn="rename" aria-selected="false" aria-controls="fl-panel-rename"><Icon name="edit" />Rename</button>
            <button class="fl-tab" type="button" role="tab" id="fl-tab-archive" data-panel-btn="archive" aria-selected="false" aria-controls="fl-panel-archive"><Icon name="files" />Archive</button>
            <button class="fl-ib" type="button" data-close-panel aria-label="Hide panel" title="Hide panel"><Icon name="xmark" /></button>
          </div>
          <form class="fl-panel" id="fl-panel-rename" role="tabpanel" data-panel="rename" data-rename aria-labelledby="fl-tab-rename" autocomplete="off" hidden>
            <p class="fl-scope" data-scope></p>
            <label class="fl-field"><span class="fl-label">Template</span><input type="text" name="template" value="{name}" spellcheck="false" aria-describedby="fl-vars-help" /></label>
            <div class="fl-vars" role="group" aria-label="Insert a variable into the template">
              {vars.map((v) => <button class="fl-chip" type="button" data-var={v}>{v}</button>)}
            </div>
            <p class="fl-help" id="fl-vars-help">{'{name}'} old name · {'{ext}'} extension · {'{id}'} position number · {'{date}'} modified (YYYY-MM-DD) · {'{today}'} · {'{size}'}</p>
            <div class="fl-pair">
              <label class="fl-field"><span class="fl-label">{'{id}'} starts at</span><input type="number" name="start" min="0" step="1" value="1" inputmode="numeric" /></label>
              <label class="fl-field"><span class="fl-label">Digits</span><input type="number" name="pad" min="1" max="9" step="1" value="1" inputmode="numeric" title="Zero-padding width: 3 gives 001" /></label>
            </div>
            <div class="fl-pair">
              <label class="fl-field"><span class="fl-label">Case</span>
                <select name="case">
                  <option value="keep">Keep</option>
                  <option value="lower">lowercase</option>
                  <option value="upper">UPPERCASE</option>
                  <option value="title">Title Case</option>
                </select>
              </label>
              <label class="fl-field"><span class="fl-label">Spaces</span>
                <select name="spaces">
                  <option value="keep">Keep</option>
                  <option value="dash">Replace with -</option>
                  <option value="underscore">Replace with _</option>
                  <option value="remove">Remove</option>
                </select>
              </label>
            </div>
            <fieldset class="fl-set">
              <legend class="fl-label">Find and replace</legend>
              <label class="fl-field"><span class="visually-hidden">Find</span><input type="text" name="find" placeholder="Find" spellcheck="false" /></label>
              <label class="fl-field"><span class="visually-hidden">Replace with</span><input type="text" name="replace" placeholder="Replace with" spellcheck="false" /></label>
              <label class="fl-check"><input type="checkbox" name="regex" /> Regular expression</label>
            </fieldset>
            <label class="fl-check"><input type="checkbox" name="strip" /> Strip special characters</label>
            <label class="fl-check"><input type="checkbox" name="keepExt" checked /> Keep extension</label>
            <label class="fl-check fl-indent"><input type="checkbox" name="lowerExt" /> Lowercase extension</label>
            <p class="fl-error" data-rename-error role="alert" hidden></p>
            <p class="fl-summary" data-rename-summary aria-live="polite"></p>
            <div class="fl-panel-acts">
              <button class="fl-btn fl-ghost" type="button" data-undo disabled><Icon name="undo" /><span>Undo last rename</span></button>
              <button class="fl-btn fl-primary" type="submit" data-apply disabled>Apply</button>
            </div>
          </form>

          <form class="fl-panel" id="fl-panel-archive" role="tabpanel" data-panel="archive" data-archive aria-labelledby="fl-tab-archive" autocomplete="off" hidden>
            <p class="fl-scope" data-scope></p>
            <div class="segmented fl-seg" role="radiogroup" aria-label="Archive format">
              <label><input type="radio" name="fmt" value="zip" checked /><span>ZIP</span></label>
              <label><input type="radio" name="fmt" value="7z" /><span>7z</span></label>
              <label title="Compresses a single file"><input type="radio" name="fmt" value="gz" /><span>gzip</span></label>
            </div>
            <label class="fl-field" data-fmt-name><span class="fl-label">Name</span><span class="fl-name-in"><input type="text" name="zipName" value="archive" spellcheck="false" /><span class="fl-help" data-ext>.zip</span></span></label>
            <div class="segmented fl-seg" role="radiogroup" aria-label="Compression" data-levels="zip">
              <label><input type="radio" name="level" value="0" /><span>Store</span></label>
              <label><input type="radio" name="level" value="6" checked /><span>Balanced</span></label>
              <label><input type="radio" name="level" value="9" /><span>Smallest</span></label>
            </div>
            <div class="segmented fl-seg" role="radiogroup" aria-label="Compression" data-levels="7z" hidden>
              <label><input type="radio" name="level7" value="0" /><span>Store</span></label>
              <label><input type="radio" name="level7" value="1" /><span>Fast</span></label>
              <label><input type="radio" name="level7" value="5" checked /><span>Normal</span></label>
              <label><input type="radio" name="level7" value="9" /><span>Ultra</span></label>
            </div>
            <label class="fl-field" data-fmt-pass><span class="fl-label">Password</span><input type="password" name="zipPass" autocomplete="new-password" placeholder="Optional" aria-describedby="fl-pass-note" /></label>
            <p class="fl-help" id="fl-pass-note" data-fmt-pass>With a password, contents are encrypted with AES-256 (in 7z also the file names). It is not stored anywhere.</p>
            <p class="fl-help">Uses the names, folders and order shown in the list.</p>
            <div class="fl-panel-acts">
              <button class="fl-btn fl-primary" type="submit" data-create>Create ZIP</button>
            </div>
            <h3 class="fl-label fl-sub">Extract</h3>
            <p class="fl-help">Unpacks ZIP, 7z, RAR, tar, gzip, xz, bz2, ISO and CAB archives into the list, each in a folder named after it.</p>
            <div class="fl-panel-acts">
              <button class="fl-btn" type="button" data-extract disabled>Extract archives</button>
            </div>
          </form>
        </aside>
      </div>

      <div class="fl-busy" data-busy hidden>
        <ProgressDial data-dial />
        <p data-busy-text></p>
        <button class="btn" type="button" data-cancel>Cancel</button>
      </div>

      <dialog class="fl-dlg" data-pw-dialog aria-labelledby="fl-pw-title">
        <form method="dialog">
          <h2 id="fl-pw-title"><Icon name="lock" /> Password needed</h2>
          <p data-pw-text></p>
          <label class="fl-dlg-field"><span>Password</span><input type="password" name="pw" autocomplete="off" required /></label>
          <p class="fl-dlg-error" data-pw-error role="alert" hidden></p>
          <div class="fl-dlg-acts">
            <button class="btn" type="button" value="cancel" data-pw-cancel>Cancel</button>
            <button class="btn btn-primary" value="ok">Extract</button>
          </div>
        </form>
      </dialog>

      <dialog class="fl-dlg" data-confirm aria-labelledby="fl-confirm-title" aria-describedby="fl-confirm-text">
        <form method="dialog">
          <h2 id="fl-confirm-title"><Icon name="trash" /> Remove files</h2>
          <p id="fl-confirm-text" data-confirm-text></p>
          <div class="fl-dlg-acts">
            <button class="btn" value="cancel">Cancel</button>
            <button class="btn btn-primary" value="ok" data-confirm-ok>Remove</button>
          </div>
        </form>
      </dialog>

      <template data-icons>
        {rowIcons.map((n) => <span data-i={n}><Icon name={n} /></span>)}
      </template>
    </section>
  </div>
</Base>

<style is:global>
  .fl {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    width: min(100vw - 2rem, 1280px);
    height: clamp(560px, calc(100dvh - 140px), 920px);
    margin: 1.5rem calc((100% - min(100vw - 2rem, 1280px)) / 2) 0;
    background: var(--surface);
    border: 1px solid var(--app-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    font-size: 0.875rem;
    position: relative;
  }
  .fl .icon svg { width: 17px; height: 17px; }
  .fl :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-radius: 6px; }
  /* Dragging files over any part of the app: the whole surface is the drop target. */
  .fl.fl-over::after { content: 'Drop to add'; position: absolute; inset: 0; z-index: 30; display: grid; place-items: center; pointer-events: none; border: 3px solid var(--accent); border-radius: inherit; background: color-mix(in srgb, var(--accent) 9%, transparent); color: var(--accent); font-size: 1.1rem; font-weight: 700; }

  /* Buttons */
  .fl-btn, .fl-ib {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem; flex: none;
    border: 1px solid transparent; border-radius: 7px; background: transparent; color: var(--fg);
    font: inherit; font-weight: 600; cursor: pointer; white-space: nowrap;
  }
  .fl-btn { height: 30px; padding: 0 0.65rem; }
  .fl-ib { width: 28px; height: 28px; padding: 0; color: var(--muted); }
  .fl-btn:hover:not(:disabled), .fl-ib:hover:not(:disabled) { background: var(--app-hover); color: var(--fg); }
  .fl-btn:disabled, .fl-ib:disabled { opacity: 0.4; cursor: default; }
  .fl-btn[aria-expanded='true'] { background: var(--app-selected); color: var(--accent); }
  /* The sidebar never collapses on wide screens; its toggle and close button exist for the narrow-screen drawer. */
  @media (min-width: 761px) { [data-toggle-inspector], .fl-tabs [data-close-panel] { display: none; } }
  .fl-primary { background: var(--accent); color: var(--accent-fg); }
  .fl-primary:hover:not(:disabled) { background: color-mix(in srgb, var(--accent) 88%, var(--fg)); color: var(--accent-fg); }
  .fl-ghost { color: var(--muted); }
  .fl-label { color: var(--muted); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .fl-grow { flex: 1; }

  /* Top bar */
  .fl-top { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.6rem 0.4rem 0.75rem; background: var(--app-bar); border-bottom: 1px solid var(--app-line); flex-wrap: wrap; }
  .fl-acts { display: flex; align-items: center; gap: 0.15rem; flex: 1; min-width: 0; flex-wrap: wrap; margin-left: 0.5rem; }
  .fl-sort { display: inline-flex; align-items: center; gap: 0.4rem; margin-left: 0.4rem; }
  .fl select, .fl input[type='text'], .fl input[type='number'], .fl input[type='password'] { height: 30px; padding: 0 0.45rem; border-radius: 7px; font-size: 0.84rem; min-width: 0; }

  /* List + inspector */
  .fl-body { display: grid; grid-template-columns: minmax(0, 1fr) auto; min-height: 0; position: relative; }
  .fl-main { display: grid; grid-template-rows: minmax(0, 1fr) auto; min-width: 0; min-height: 0; }
  .fl-scroll { position: relative; overflow: auto; min-height: 0; }
  .fl-table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .fl-table th { position: sticky; top: 0; z-index: 2; height: 32px; padding: 0 0.5rem; background: var(--app-bar); border-bottom: 1px solid var(--app-line); color: var(--muted); font-size: 0.72rem; font-weight: 700; text-align: left; text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap; }
  .fl-table td { height: 34px; padding: 0 0.5rem; border-bottom: 1px solid color-mix(in srgb, var(--app-line) 60%, transparent); white-space: nowrap; }
  .fl-table input[type='checkbox'] { accent-color: var(--accent); margin: 0; vertical-align: middle; }
  .fl-table tbody { user-select: none; }
  .fl-table tbody tr { cursor: default; }
  .fl-table tbody tr:hover { background: var(--app-hover); }
  .fl-table tbody tr[data-selected] { background: var(--app-selected); }
  .fl-table tr.fl-dragging { position: relative; z-index: 1; background: var(--surface); box-shadow: 0 6px 20px rgb(0 0 0 / 0.18); outline: 2px solid var(--accent); outline-offset: -2px; }
  .fl-c-check, .fl-c-grip { width: 1px; }
  .fl .fl-c-check { padding-right: 0; }
  .fl .fl-c-grip { padding: 0; }
  .fl-grip { cursor: grab; touch-action: none; }
  .fl-dragging .fl-grip { cursor: grabbing; }
  .fl-c-name { max-width: 0; width: 45%; }
  .fl-name { display: flex; align-items: center; gap: 0.45rem; min-width: 0; }
  .fl-name .icon { flex: none; color: var(--muted); }
  tr[data-kind='images'] .fl-name .icon { color: light-dark(#0f766e, #4fd1c5); }
  tr[data-kind='pdf'] .fl-name .icon { color: light-dark(#b42318, #ff8a80); }
  tr[data-kind='audio'] .fl-name .icon { color: light-dark(#7c3aed, #c4b5fd); }
  tr[data-kind='files'] .fl-name .icon { color: light-dark(#a16207, #f2c14e); }
  .fl-nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .fl-dir { color: var(--muted); }
  .fl-c-new { display: none; max-width: 0; width: 30%; overflow: hidden; text-overflow: ellipsis; }
  .fl-problem { font-size: 0.75rem; text-decoration: none; display: inline-block; }
  .fl[data-renaming] .fl-c-new { display: table-cell; }
  .fl-c-new[data-state='same'], .fl-c-new[data-state='off'] { color: var(--muted); }
  .fl-c-new[data-state='changed'] { color: var(--accent); font-weight: 600; }
  .fl-c-new[data-state='error'] { color: var(--error); font-weight: 600; text-decoration: wavy underline; }
  .fl-c-type, .fl-c-date { color: var(--muted); }
  .fl-c-size { color: var(--muted); text-align: right; }
  .fl-table th.fl-c-size { text-align: right; }
  .fl-c-acts { width: 1px; text-align: right; }
  .fl-c-acts .fl-ib { opacity: 0; }
  .fl-table tr:is(:hover, :focus-within) .fl-c-acts .fl-ib { opacity: 1; }
  .fl-c-acts .icon svg, .fl-grip .icon svg { width: 15px; height: 15px; }

  /* Empty state: the whole list area is the drop zone. */
  .fl-empty { position: absolute; inset: 0.75rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.8rem; padding: 1.5rem; text-align: center; border: 2px dashed color-mix(in srgb, var(--muted) 35%, transparent); border-radius: 14px; background: color-mix(in srgb, var(--app-stage) 35%, var(--surface)); transition: border-color 0.15s, background-color 0.15s; }
  .fl.fl-over .fl-empty { border-color: var(--accent); }
  .fl-drop-icon { width: 52px; height: 52px; fill: none; stroke: color-mix(in srgb, var(--muted) 80%, transparent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .fl-empty-title { margin: 0; font-size: 1.15rem; font-weight: 650; }
  .fl-empty-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; }
  .fl-empty-actions .btn { padding: 0.5rem 1rem; font-size: 0.9rem; }
  .fl-empty-hint { margin: 0; max-width: 54ch; color: var(--muted); font-size: 0.8rem; }

  .fl-status { display: flex; align-items: center; gap: 1rem; min-height: 28px; padding: 0 0.75rem; background: var(--app-bar); border-top: 1px solid var(--app-line); color: var(--muted); font-size: 0.78rem; font-variant-numeric: tabular-nums; }
  .fl-msg { margin-left: auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fl-msg[data-kind='error'] { color: var(--error); }
  .fl-msg[data-kind='ok'] { color: var(--local); }

  /* Inspector: rename or archive panel on the right. */
  .fl-inspector { width: 310px; min-height: 0; overflow-y: auto; background: var(--app-side); border-left: 1px solid var(--app-line); }
  /* Panel tabs at the top of the sidebar, below the app's top bar. */
  .fl-tabs { position: sticky; top: 0; z-index: 1; display: flex; align-items: center; gap: 0.2rem; padding: 0.45rem 0.5rem; background: var(--app-side); border-bottom: 1px solid var(--app-line); }
  .fl-tab {
    display: inline-flex; align-items: center; gap: 0.4rem; height: 30px; padding: 0 0.7rem; border: 0; border-radius: 8px;
    background: none; color: var(--muted); font: inherit; font-size: 0.86rem; font-weight: 600; cursor: pointer;
  }
  .fl-tab:hover { background: var(--app-hover); color: var(--fg); }
  .fl-tab[aria-selected='true'] { background: var(--app-selected); color: var(--fg); }
  .fl-tab[aria-selected='true'] .icon { color: var(--accent); }
  .fl-tabs .fl-ib { margin-left: auto; }
  .fl-panel { display: flex; flex-direction: column; gap: 0.6rem; padding: 0.75rem 0.75rem 1rem; }
  .fl-scope { margin: 0; color: var(--muted); font-size: 0.8rem; }
  .fl-field { display: grid; gap: 0.25rem; min-width: 0; }
  .fl-field input, .fl-field select { width: 100%; }
  .fl-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .fl-vars { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .fl-chip { padding: 0.15rem 0.45rem; border: 1px solid var(--app-line); border-radius: 6px; background: var(--surface); color: var(--fg); font: 0.78rem var(--mono); cursor: pointer; }
  .fl-chip:hover { border-color: var(--accent); color: var(--accent); }
  .fl-help { margin: 0; color: var(--muted); font-size: 0.76rem; }
  .fl-set { display: grid; gap: 0.4rem; margin: 0; padding: 0.5rem 0.6rem 0.6rem; border: 1px solid var(--app-line); border-radius: 9px; }
  .fl-set legend { padding: 0 0.25rem; }
  .fl-check { display: inline-flex; align-items: center; gap: 0.4rem; }
  .fl-check input { accent-color: var(--accent); margin: 0; }
  .fl-indent { padding-left: 1.4rem; }
  .fl-check:has(input:disabled) { opacity: 0.5; }
