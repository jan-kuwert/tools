---
// PDF category app: one combined document built from PDFs and images (reorder, rotate, delete, split, export).
// Behaviour: src/lib/pdf-app.ts.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import AppBar from '../../components/AppBar.astro';
import ModeBadge from '../../components/ModeBadge.astro';
import ProgressDial from '../../components/ProgressDial.astro';
import { categories, href, toolBySlug } from '../../tools';

const category = categories.find((c) => c.id === 'pdf')!;
const limits = `${toolBySlug('pdf/merge').limits} · ${toolBySlug('pdf/from-images').limits}`;
const accept = 'application/pdf,.pdf,image/jpeg,image/png';
// Fanned paper pages behind the empty state: [x, y, rotation°], left stack then right stack.
const sheets = [[70, 210, -14], [120, 190, -6], [175, 180, 3], [905, 175, 8], [955, 230, -4]];
---
<Base title="PDF · Tools" description={category.blurb}>
  <div class="tool-shell" data-wide>
    <div class="crumbs"><a href={href()}>All tools</a> / <a href={href() + '#pdf'}>PDF</a></div>
    <div class="tool-head">
      <h1>PDF</h1>
      <ModeBadge mode="local" />
    </div>
    <p class="tool-summary">{category.blurb}</p>
    <div class="privacy-note privacy-local" role="note">
      <Icon name="lock" />
      <p><strong>Runs in your browser; nothing is uploaded.</strong> <a href={href('privacy')}>How we check</a></p>
    </div>

    <section class="pdf-app" data-pdf-app data-empty aria-label="PDF">
      <header class="pa-tb">
        <AppBar part="switch" current="pdf" />
        <button class="pa-tool" type="button" data-open title="Open or add PDFs and images"><Icon name="plus" /><span class="pa-tool-label">Add</span></button>
        <div class="pa-viewseg" role="radiogroup" aria-label="View">
          <label title="Pages: read continuously (G)"><input type="radio" name="pa-view" value="pages" checked /><span><Icon name="pdf" /><span class="pa-tool-label">Pages</span></span></label>
          <label title="Grid: overview of all pages (G)"><input type="radio" name="pa-view" value="grid" /><span><Icon name="grid" /><span class="pa-tool-label">Grid</span></span></label>
        </div>
        <label class="pa-group pa-cardsize" data-grid-only title="Card size (Ctrl/Cmd+wheel or pinch in the grid)">
          <Icon name="zoom-out" /><input type="range" min="96" max="360" step="8" value="168" data-card-size aria-label="Card size" /><Icon name="zoom-in" />
        </label>
        <div class="pa-group" data-pages-only>
          <button class="pa-tool" type="button" data-zoom-out aria-label="Zoom out" title="Zoom out"><Icon name="zoom-out" /></button>
          <select class="pa-select" data-zoom aria-label="Zoom">
            <option value="width">Fit width</option>
            <option value="page">Fit page</option>
            {[25, 50, 75, 100, 125, 150, 200, 300, 400].map((z) => <option value={z / 100}>{z}%</option>)}
          </select>
          <button class="pa-tool" type="button" data-zoom-in aria-label="Zoom in" title="Zoom in"><Icon name="zoom-in" /></button>
        </div>
        <div class="pa-group pa-pageno">
          <input type="number" min="1" value="1" inputmode="numeric" data-page aria-label="Page number" />
          <span>/ <span data-page-count>0</span></span>
        </div>
        <div class="pa-end">
          <button class="pa-tool" type="button" data-close-all disabled aria-label="Close all files" title="Close all files"><Icon name="xmark" /></button>
          <AppBar part="actions" />
        </div>
      </header>

      <div class="pa-msg" data-msg hidden>
        <p data-msg-text role="status" aria-live="polite"></p>
        <button class="pa-tool" type="button" data-msg-close aria-label="Dismiss message"><Icon name="xmark" /></button>
      </div>

      <div class="pa-body">
        <aside class="pa-side" aria-label="Files and pages">
          <div class="pa-thumbs" data-side>
            <div class="pa-legend">
              <ul class="pa-legend-files" data-legend aria-label="Files"></ul>
              <p class="pa-legend-bar"><span data-legend-note></span><button class="pa-link" type="button" data-group>Group by file</button></p>
            </div>
            <ol class="pa-list" data-thumbs role="listbox" aria-multiselectable="true" aria-label="Pages, in output order"></ol>
            <p class="pa-hint">Drag to reorder. Arrows move, Shift extends, Ctrl/Cmd+arrows then Space picks several, Alt+arrows reorder, R rotates, Delete deletes, G switches view, Ctrl/Cmd+S exports.</p>
          </div>
        </aside>
        <div class="pane-resizer" data-resize="left" role="separator" aria-orientation="vertical" tabindex="0" aria-label="Resize page sidebar"></div>

        <div class="pa-main">
          <div class="pa-view" data-view tabindex="0" aria-label="Page view">
            <div class="pa-pages" data-pages></div>
          </div>
          <div class="pa-grid" data-grid aria-label="Page overview">
            <ol class="pa-cards" data-cards role="listbox" aria-multiselectable="true" aria-label="Pages, in output order"></ol>
          </div>
          <label class="pa-empty" data-empty-state>
            <svg class="pa-bg-art" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
              <defs>
                <radialGradient id="pa-g-a"><stop offset="0" class="s-a" /><stop offset="1" class="s-a" stop-opacity="0" /></radialGradient>
                <radialGradient id="pa-g-b"><stop offset="0" class="s-b" /><stop offset="1" class="s-b" stop-opacity="0" /></radialGradient>
                <pattern id="pa-dots" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="12" cy="12" r="1.3" /></pattern>
                <radialGradient id="pa-fade" r="0.6"><stop offset="0.25" stop-color="#000" /><stop offset="1" stop-color="#fff" /></radialGradient>
                <mask id="pa-edge"><rect width="1200" height="600" fill="url(#pa-fade)" /></mask>
              </defs>
              <g class="g-aurora">
                <ellipse class="g-blob b1" cx="220" cy="470" rx="440" ry="300" fill="url(#pa-g-a)" />
                <ellipse class="g-blob b2" cx="1000" cy="130" rx="420" ry="300" fill="url(#pa-g-b)" />
              </g>
              <rect class="g-dots" width="1200" height="600" fill="url(#pa-dots)" mask="url(#pa-edge)" />
              {sheets.map(([x, y, r], i) => (
                <g transform={`translate(${x} ${y}) rotate(${r})`}>
                  <rect class="g-paper" width="170" height="220" rx="8" />
                  <path class="g-fold" d="M134 0h28a8 8 0 0 1 8 8v28z" />
                  <rect class="g-head" x="20" y="26" width="86" height="11" rx="5.5" />
                  {i === sheets.length - 1 && <path class="g-mark" d="M20 105h96" />}
                  <path class="g-lines" d="M20 60h130M20 76h130M20 92h104M20 108h130M20 124h118M20 140h76M20 168h130M20 184h96" />
                </g>
              ))}
            </svg>
            <span class="pa-empty-title">Drop PDFs or images, or choose files</span>
            <span class="btn btn-primary"><Icon name="upload" />Choose files</span>
            <span class="pa-empty-hint">PDFs and JPEG or PNG images all become pages of one document. You can also paste from the clipboard.</span>
            <input class="visually-hidden" type="file" accept={accept} multiple data-input />
          </label>
          <div class="pa-busy" data-busy hidden>
            <ProgressDial data-dial />
            <p data-busy-text role="status" aria-live="polite"></p>
            <button class="btn" type="button" data-busy-cancel>Cancel</button>
          </div>
          <section class="pa-results" data-results hidden aria-labelledby="pa-results-title">
            <header>
              <h2 id="pa-results-title" data-results-title>Result</h2>
              <button class="pa-tool" type="button" data-results-close aria-label="Close results" title="Close"><Icon name="xmark" /></button>
            </header>
            <ul data-result-list></ul>
          </section>
        </div>
        <div class="pane-resizer" data-resize="right" role="separator" aria-orientation="vertical" tabindex="0" aria-label="Resize options panel"></div>

        <aside class="pa-insp" aria-label="Options">
          <div class="pa-insp-scroll">
            <section aria-labelledby="pa-pages-title">
              <h2 id="pa-pages-title">Pages</h2>
              <p class="pa-order-info" data-order-info></p>
              <p class="pa-note" data-sel-info></p>
              <div class="pa-actions">
                <button class="btn" type="button" data-act="rotate-left"><Icon name="rotate-left" />Rotate left</button>
                <button class="btn" type="button" data-act="rotate-right"><Icon name="rotate-right" />Rotate right</button>
                <button class="btn" type="button" data-act="up"><Icon name="arrow-up" />Move up</button>
                <button class="btn" type="button" data-act="down"><Icon name="arrow-down" />Move down</button>
                <button class="btn" type="button" data-act="delete"><Icon name="trash" /><span data-label>Delete</span></button>
                <button class="btn" type="button" data-act="select-all"><Icon name="grid" />Select all</button>
                <button class="btn" type="button" data-act="reverse"><Icon name="reverse" />Reverse</button>
                <button class="btn" type="button" data-act="reset"><Icon name="restart" />Reset all</button>
              </div>
              <p class="pa-note">Every PDF and image you add joins this one page order; drag pages to mix files. Deleted pages are left out of Export and Split.</p>
            </section>

            <section class="pa-split" data-split aria-labelledby="pa-split-title">
              <h2 id="pa-split-title">Split</h2>
              <form class="pa-form" data-split-form>
                <fieldset>
                  <legend class="visually-hidden">Split into</legend>
                  <div class="segmented pa-seg">
                    <label><input type="radio" name="split" value="each" checked /><span>Every page</span></label>
                    <label><input type="radio" name="split" value="ranges" /><span>By ranges</span></label>
                    <label><input type="radio" name="split" value="extract" /><span>Extract</span></label>
                  </div>
                </fieldset>
                <label class="field" data-ranges-field hidden>
                  <span>Pages</span>
                  <input type="text" name="ranges" placeholder="e.g. 1-3, 5, 8-" autocomplete="off" aria-describedby="pa-split-info" />
                </label>
                <button class="btn" type="button" data-use-selection hidden>Use selected pages</button>
                <p class="pa-note" id="pa-split-info" data-split-info aria-live="polite"></p>
                <button class="btn" type="submit" data-split-run disabled><Icon name="scissor" />Split</button>
              </form>
            </section>

            <section class="pa-imgopts" aria-labelledby="pa-img-title">
              <h2 id="pa-img-title">Image pages</h2>
              <p class="pa-note" data-img-info></p>
              <form class="pa-form" data-img-form>
                <fieldset>
                  <legend>Page size</legend>
                  <div class="segmented pa-seg">
                    <label><input type="radio" name="size" value="a4" checked /><span>A4</span></label>
                    <label><input type="radio" name="size" value="letter" /><span>Letter</span></label>
                    <label><input type="radio" name="size" value="fit" /><span>Fit image</span></label>
                  </div>
                </fieldset>
                <fieldset>
                  <legend>Orientation</legend>
                  <div class="segmented pa-seg">
                    <label><input type="radio" name="orientation" value="auto" checked /><span>Auto</span></label>
                    <label><input type="radio" name="orientation" value="portrait" /><span>Portrait</span></label>
                    <label><input type="radio" name="orientation" value="landscape" /><span>Landscape</span></label>
                  </div>
                </fieldset>
                <fieldset>
                  <legend>Margin</legend>
                  <div class="segmented pa-seg">
                    <label><input type="radio" name="margin" value="0" checked /><span>None</span></label>
                    <label><input type="radio" name="margin" value="18" /><span>Small</span></label>
                    <label><input type="radio" name="margin" value="54" /><span>Large</span></label>
                  </div>
                </fieldset>
              </form>
            </section>

            <p class="warn-box" data-sig hidden>A PDF here is digitally signed. Signatures will not be valid in the new copy.</p>
            <p class="pa-limits">{limits}</p>
            <p class="visually-hidden" data-announce aria-live="polite"></p>
          </div>

          <section class="pa-export" aria-labelledby="pa-export-title">
            <h2 id="pa-export-title">Export</h2>
            <form class="pa-form" data-export-form>
              <fieldset>
                <legend class="visually-hidden">Compression</legend>
                <div class="segmented pa-seg">
                  <label title="Written by the PDF library as is"><input type="radio" name="quality" value="standard" checked /><span>Standard</span></label>
                  <label title="Lossless optimization; smaller when possible"><input type="radio" name="quality" value="optimized" /><span>Optimized</span></label>
                  <label title="Pages redrawn as JPEG images; much smaller for scans and photos"><input type="radio" name="quality" value="lossy" /><span>Lossy</span></label>
                </div>
              </fieldset>
              <fieldset class="pa-lossy">
                <legend>Image quality</legend>
                <div class="segmented pa-seg">
                  <label title="72 dpi, smallest file"><input type="radio" name="preset" value="low" /><span>Low</span></label>
                  <label title="110 dpi"><input type="radio" name="preset" value="medium" checked /><span>Medium</span></label>
                  <label title="150 dpi, sharpest"><input type="radio" name="preset" value="high" /><span>High</span></label>
                </div>
              </fieldset>
              <fieldset>
                <legend class="visually-hidden">Color</legend>
                <div class="segmented pa-seg">
                  <label><input type="radio" name="color" value="color" checked /><span>Color</span></label>
                  <label title="Grayscale pages"><input type="radio" name="color" value="gray" /><span>Black & white</span></label>
                </div>
              </fieldset>
              <p class="pa-note">Optimized: lossless, used only when smaller. Lossy and Black & white redraw each page as an image, so text can no longer be selected or searched.</p>
              <label class="field">
                <span>File name</span>
                <input type="text" name="filename" autocomplete="off" spellcheck="false" />
              </label>
              <dl class="pa-out" data-out aria-label="What will be exported">
                <dt>Pages</dt><dd data-out-pages></dd>
                <dt>Files</dt><dd data-out-files></dd>
                <dt>Page size</dt><dd data-out-size></dd>
                <dt data-out-rot>Rotated</dt><dd data-out-rot></dd>
                <dt>File size</dt><dd data-out-bytes aria-live="polite"></dd>
              </dl>
              <button class="btn btn-primary" type="submit" data-export disabled><Icon name="download" />Export PDF</button>
              <p class="pa-note" data-export-info aria-live="polite"></p>
            </form>
          </section>
        </aside>
      </div>

      <template data-icons>
        <Icon name="arrow-up" class="i-up" />
        <Icon name="arrow-down" class="i-down" />
        <Icon name="xmark" class="i-close" />
        <Icon name="download" class="i-download" />
        <Icon name="open" class="i-open" />
        <Icon name="rotate-left" class="i-rotate-left" />
        <Icon name="rotate-right" class="i-rotate-right" />
        <Icon name="trash" class="i-trash" />
        <Icon name="restart" class="i-restore" />
      </template>
    </section>
  </div>
</Base>

<style is:global>
  .pdf-app {
    --pa-w: min(100vw - 2rem, 1440px);
    --pa-left: 220px;
    --pa-right: 300px;
    --paper-shadow: 0 1px 2px rgb(0 0 0 / 0.16), 0 4px 16px rgb(0 0 0 / 0.1);
    /* Source-file markers: muted hues, white text in light theme and near-black in dark (all ≥ 5:1). */
    --fm-0: light-dark(#2f62a8, #86aef0);
    --fm-1: light-dark(#a8452e, #f0977e);
    --fm-2: light-dark(#2b7a5c, #6fcca6);
    --fm-3: light-dark(#7a4fa3, #c3a0ec);
    --fm-4: light-dark(#8a5d10, #e2b35c);
    --fm-5: light-dark(#a83a6b, #f093bd);
    --fm-6: light-dark(#4d7224, #a3cd72);
    --fm-7: light-dark(#4f5f75, #a9b7ca);
    --fm-ink: light-dark(#ffffff, #111214);
    position: relative;
    display: flex;
    flex-direction: column;
    width: var(--pa-w);
    height: clamp(600px, calc(100dvh - 120px), 1000px);
    margin: 1.5rem calc((100% - var(--pa-w)) / 2) 0;
    background: var(--app-bg);
    border: 1px solid var(--app-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .pdf-app .icon svg { width: 18px; height: 18px; }
  .pdf-app h2 { margin: 0; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }

  /* Toolbar */
  .pa-tb { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.6rem; padding: 0.45rem 0.6rem; background: var(--app-bar); border-bottom: 1px solid var(--app-line); }
  .pa-group { display: flex; align-items: center; gap: 0.1rem; }
  .pa-tool {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; min-width: 34px; height: 34px; padding: 0 0.5rem;
    border: 0; border-radius: 8px; background: transparent; color: var(--fg); font: inherit; font-size: 0.86rem; font-weight: 600; cursor: pointer; white-space: nowrap;
  }
  .pa-tool:hover:not(:disabled) { background: var(--app-hover); }
  .pa-tool:disabled { opacity: 0.4; cursor: default; }
  .pa-select, .pa-pageno input { height: 34px; padding: 0 0.45rem; border-radius: 8px; font-size: 0.86rem; font-variant-numeric: tabular-nums; }
  .pa-pageno { gap: 0.4rem; font-size: 0.86rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .pa-pageno input { width: 4.2rem; text-align: right; }
  .pa-end { display: flex; align-items: center; gap: 0.4rem; margin-left: auto; }
  .pa-end .btn { padding: 0.4rem 0.9rem; font-size: 0.88rem; }
  .pdf-app[data-view='grid'] [data-pages-only], .pdf-app:not([data-view='grid']) [data-grid-only] { display: none; }
  .pa-viewseg { display: flex; padding: 2px; gap: 2px; border-radius: 9px; background: var(--app-hover); }
  .pa-viewseg label { position: relative; }
  .pa-viewseg input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .pa-viewseg label > span { display: flex; align-items: center; gap: 0.35rem; height: 30px; padding: 0 0.6rem; border-radius: 7px; color: var(--muted); font-size: 0.86rem; font-weight: 600; }
  .pa-viewseg input:checked + span { background: var(--app-bar); color: var(--fg); box-shadow: 0 1px 3px rgb(0 0 0 / 0.14); }
  .pa-viewseg input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 1px; }
  .pa-cardsize { gap: 0.35rem; color: var(--muted); }
  .pa-cardsize input { width: 7.5rem; }

  .pa-msg { display: flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.6rem 0.35rem 1rem; border-bottom: 1px solid var(--app-line); background: var(--app-bar); font-size: 0.88rem; }
  .pa-msg p { flex: 1; margin: 0; white-space: pre-line; }
  .pa-msg[data-kind='error'] { background: color-mix(in srgb, var(--error) 10%, var(--surface)); color: var(--error); }
  .pa-msg[data-kind='error'] .pa-tool { color: inherit; }

  .pa-body { flex: 1; display: grid; grid-template-columns: var(--pa-left) 0 minmax(0, 1fr) 0 var(--pa-right); min-height: 0; }
  /* No files: the page sidebar folds away; every pane keeps its own grid track. */
  .pdf-app[data-empty] .pa-body { grid-template-columns: 0 0 minmax(0, 1fr) 0 var(--pa-right); }
  .pdf-app[data-empty] :is(.pa-side, [data-resize='left']) { visibility: hidden; overflow: hidden; }

  /* Sidebar: file legend, then the page thumbnails in output order. */
  .pa-side { display: flex; flex-direction: column; min-width: 0; min-height: 0; background: var(--app-side); border-right: 1px solid var(--app-line); }
  .pa-thumbs { position: relative; flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0.5rem; }
  .pa-hint { margin: 0.5rem 0.25rem; font-size: 0.75rem; color: var(--muted); }
  .pa-legend { display: grid; gap: 0.15rem; padding-bottom: 0.4rem; margin-bottom: 0.25rem; border-bottom: 1px solid var(--app-line); }
  .pa-legend-files { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
  .pa-legend-bar { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.1rem 0.5rem; margin: 0; padding: 0.15rem 0.25rem 0; font-size: 0.75rem; color: var(--muted); }
  .pdf-app:not([data-mixed]) .pa-legend-bar { display: none; }
  .pa-link { padding: 0; border: 0; background: none; color: var(--accent); font: inherit; font-weight: 600; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
  .pa-src { display: flex; align-items: center; }
  .pa-src .pa-tool { min-width: 26px; height: 26px; padding: 0; color: var(--muted); }
  .pa-src .icon svg { width: 15px; height: 15px; }
  .pa-src-name {
    flex: 1; min-width: 0; display: flex; align-items: center; gap: 0.35rem; padding: 0.25rem; border: 0; border-radius: 6px;
    background: none; color: var(--fg); font: inherit; font-size: 0.8rem; font-weight: 650; text-align: left; cursor: pointer;
  }
  .pa-src-name:hover { background: var(--app-hover); }
  .pa-src-name > span:not(.pa-mark):not(.pa-src-count) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pa-src-name .pa-mark { position: static; flex: none; }
  .pa-src-count { flex: none; margin-left: auto; color: var(--muted); font-weight: 500; font-variant-numeric: tabular-nums; }
  .pa-list { list-style: none; margin: 0; padding: 0.25rem 0; display: grid; gap: 0.25rem; }
  .pa-thumb, .pa-card { position: relative; border: 2px solid transparent; cursor: pointer; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
  .pa-thumb { display: grid; justify-items: center; gap: 0.25rem; padding: 0.45rem 0.5rem 0.3rem; border-radius: 10px; }
  :is(.pa-thumb, .pa-card):hover { background: var(--app-hover); }
  :is(.pa-thumb, .pa-card)[aria-selected='true'] { border-color: color-mix(in srgb, var(--accent) 55%, transparent); background: var(--app-selected); }
  :is(.pa-thumb, .pa-card):focus-visible { outline: 3px solid var(--accent); outline-offset: 0; }
  .pa-lifted { opacity: 0.35; }
  .pa-dragging, .pa-dragging * { cursor: grabbing !important; }
  .pa-insert { position: absolute; z-index: 3; border-radius: 2px; background: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 25%, transparent); pointer-events: none; }
  .pa-ghost {
    position: fixed; top: 0; left: 0; z-index: 50; padding: 0.3rem 0.65rem; border-radius: 999px; pointer-events: none;
    background: var(--fg); color: var(--bg); font-size: 0.8rem; font-weight: 650; white-space: nowrap; box-shadow: 0 6px 18px rgb(0 0 0 / 0.25);
  }
  /* Square box sized by the sidebar / grid column: a page rotated by 90° still fits, so rotating never shifts the list.
     The art fills the box absolutely and centres with flex (not grid: an auto grid row would size to the
     canvas), so the children's 100% limits resolve against the box and the hi-DPI canvas scales down. */
  .pa-thumb-box, .pa-card-box { position: relative; display: block; width: 100%; aspect-ratio: 1; }
  .pa-art { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; transition: transform 0.2s; }
