  const display = $('.dk-display');
  const screenMsg = $('[data-screen-msg]');
  const sourceOut = $('[data-source]');
  const outReadout = $('[data-readout=out]');
  const tracks = $('[data-tracks]');
  const trackList = $('[data-track-list]');
  const editSet = $<HTMLFieldSetElement>('[data-edit]');
  const multiNote = $('[data-multi-note]');
  const planOut = $('[data-plan]');
  const estOut = $('[data-est]');
  const runBtn = $<HTMLButtonElement>('[data-run]');
  const runLabel = $('[data-run-label]');
  const cancelBtn = $<HTMLButtonElement>('[data-cancel]');
  const dial = $('[data-progress]');
  const status = $('[data-status]');
  const tray = $('[data-tray]');
  const trayList = $('[data-tray-list]');
  const icon = (name: string) => document.querySelector<HTMLTemplateElement>(`template[data-icon=${name}]`)!.content.firstElementChild!.cloneNode(true);

  const probes = new WeakMap<File, Promise<AudioInfo>>();
  const probe = (f: File) => {
    if (!probes.has(f)) probes.set(f, probeAudio(f));
