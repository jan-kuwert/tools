---
// Audio editor/converter as one console: display (waveform), transport, edit, local output, cloud export, output tray.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ModeBadge from '../../components/ModeBadge.astro';
import ProgressDial from '../../components/ProgressDial.astro';
import { href, toolBySlug } from '../../tools';

const tool = toolBySlug('audio/convert');
const configured = Boolean(import.meta.env.PUBLIC_API_URL);
const accept = 'audio/*,.m4a,.aac,.mp3,.wav,.ogg,.oga,.opus,.flac,.webm';

// Fader detents from bottom to top: [value, engraved label].
const localFaders = [
  { id: 'mp3', label: 'MP3 bitrate', cap: 'Bitrate', value: 0, steps: [['match', 'Match'], ['96', '96'], ['128', '128'], ['160', '160'], ['192', '192'], ['256', '256'], ['320', '320']] },
  { id: 'ogg', label: 'OGG quality', cap: 'Quality', value: 0, steps: [['match', 'Match'], ['3', 'Q3'], ['5', 'Q5'], ['8', 'Q8']] },
];
const cloudFader = { id: 'cloud', label: 'Cloud bitrate', cap: 'Bitrate', value: 4, steps: ['64', '96', '128', '160', '192', '256', '320'].map((k) => [k, k]) };

// Faint, deterministic waveform behind the empty display.
const ghost = Array.from({ length: 180 }, (_, i) => {
  const env = 0.25 + 0.6 * Math.abs(Math.sin(i * 0.045 + 0.6) * Math.sin(i * 0.013 + 1.9));
  const noise = (Math.abs(Math.sin(i * 12.9898) * 43758.5453) % 1) * 0.45 + 0.55;
  const a = Math.min(0.95, env * noise) * 44;
  return `M${i * 2 + 1} ${(50 - a).toFixed(1)}V${(50 + a).toFixed(1)}`;
}).join('');
---
<Base title={`${tool.title} · Tools`} description={tool.summary}>
  <div class="tool-shell" data-wide>
    <div class="crumbs"><a href={href()}>All tools</a> / <a href={href() + '#audio'}>Audio</a></div>
    <div class="tool-head">
      <h1>{tool.title}</h1>
      <ModeBadge mode={tool.mode} />
    </div>
    <div class="privacy-note privacy-local" role="note">
      <Icon name="lock" />
      <p><strong>Stays on this device.</strong> Only the optional <strong>cloud export</strong> uploads the original file, and it asks first every time. <a href={href('privacy')}>How we check</a></p>
    </div>

    <section class="deck" data-deck data-empty aria-label="Audio editor">
      <div class="dk-display" data-screen-state="empty">
        <div class="dk-head">
          <h2 class="dk-title"><Icon name="audio" />Audio</h2>
          <span class="lamps" aria-hidden="true">
            <span class="lamp" data-on><i></i>Local</span>
            <span class="lamp" data-led="play"><i></i>Play</span>
            <span class="lamp lamp-amber" data-led="cloud"><i></i>Cloud</span>
          </span>
          <span class="dk-source" data-source></span>
        </div>

        <div class="screen">
          <dl class="readouts">
            <div><dt>Start</dt><dd class="seg" data-readout="start">-:--.---</dd></div>
            <div><dt>End</dt><dd class="seg" data-readout="end">-:--.---</dd></div>
            <div><dt>Sel</dt><dd class="seg" data-readout="sel">-:--.---</dd></div>
            <div><dt>Out</dt><dd class="seg" data-readout="out">-:--.---</dd></div>
            <div><dt>Pos</dt><dd class="seg" data-readout="pos">-:--.---</dd></div>
          </dl>
          <div class="sil-bar" data-silence hidden>
            <p class="sil-text" data-silence-text></p>
            <div class="sil-keys">
              <button class="soft" type="button" data-sil="both">Trim</button>
              <button class="soft" type="button" data-sil="start">Start only</button>
              <button class="soft" type="button" data-sil="end">End only</button>
              <button class="soft" type="button" data-sil="ignore">Ignore</button>
            </div>
          </div>
          <div class="wave-scroll" data-scroll>
            <div class="wave-track" data-track>
              <canvas role="img" aria-label="Waveform with time ruler. Drag to select a range."></canvas>
              <div class="wave-dim" data-dim="start"></div>
              <div class="wave-dim" data-dim="end"></div>
              <div class="wave-playhead" data-playhead hidden></div>
              <div class="wave-handle" data-handle="start" role="slider" tabindex="0" aria-label="Selection start" aria-describedby="dk-hint"></div>
              <div class="wave-handle" data-handle="end" role="slider" tabindex="0" aria-label="Selection end" aria-describedby="dk-hint"></div>
            </div>
          </div>
          <label class="screen-empty">
            <svg class="screen-ghost" viewBox="0 0 360 100" preserveAspectRatio="none" aria-hidden="true"><path d={ghost} /></svg>
            <span class="screen-title">Drop audio or choose a file</span>
            <span class="btn btn-primary"><Icon name="upload" />Choose files</span>
            <span class="screen-hint">{tool.limits}. You can also paste from the clipboard.</span>
            <input class="visually-hidden" type="file" accept={accept} multiple data-input />
          </label>
          <p class="screen-msg" data-screen-msg role="status"></p>
        </div>

        <div class="transport" role="group" aria-label="Transport">
          <button class="key" type="button" data-play-all disabled><Icon name="skip-prev" /><span>From start</span></button>
          <button class="key" type="button" data-play disabled><Icon name="play" /><span>Play selection</span></button>
          <button class="key" type="button" data-pause disabled><Icon name="pause" /><span>Pause</span></button>
          <span class="transport-zoom">
            <span class="cap" aria-hidden="true">Zoom</span>
            <button class="key key-sq" type="button" data-zoom="out" aria-label="Zoom out" title="Zoom out" disabled><Icon name="zoom-out" /></button>
            <button class="key key-sq" type="button" data-zoom="in" aria-label="Zoom in" title="Zoom in" disabled><Icon name="zoom-in" /></button>
          </span>
        </div>

        <div class="tracks" data-tracks hidden>
          <ol class="track-list" data-track-list aria-label="Loaded files"></ol>
          <label class="key key-sm" title="Add more audio files"><Icon name="plus" /><span>Add</span><input class="visually-hidden" type="file" accept={accept} multiple data-add aria-label="Add audio files" /></label>
          <button class="key key-sm" type="button" data-eject title="Remove all files"><Icon name="xmark" /><span>Eject</span></button>
        </div>
      </div>

      <section class="mod mod-edit" aria-labelledby="edit-title">
        <h2 class="mod-title" id="edit-title">Edit</h2>
        <fieldset class="mod-body" data-edit disabled>
          <legend class="visually-hidden">Trim, cut and fades</legend>
          <div class="lcd-fields">
            <label class="lcd-field"><span class="cap">Start</span><input class="lcd" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" placeholder="-:--.---" data-time="start" aria-describedby="dk-time" /></label>
            <label class="lcd-field"><span class="cap">End</span><input class="lcd" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" placeholder="-:--.---" data-time="end" aria-describedby="dk-time" /></label>
          </div>
          <div class="edit-row">
            {[['in', 'Fade in'], ['out', 'Fade out']].map(([id, label]) => (
              <div class="knob-unit">
                <div class="knob" role="slider" tabindex="0" data-knob={id} aria-label={label} aria-valuemin="0" aria-valuemax="5" aria-valuenow="0" aria-valuetext="0.0 seconds" aria-describedby="dk-knob"><span class="knob-cap"></span></div>
                <output class="lcd lcd-xs" data-knob-out={id} aria-hidden="true">0.0 s</output>
                <span class="cap" aria-hidden="true">{label}</span>
              </div>
            ))}
            <div class="toggle">
              <span class="cap" id="dk-mode">Selection</span>
              <div class="toggle-row" role="radiogroup" aria-labelledby="dk-mode">
                <label><input type="radio" name="edit" value="keep" checked /><span>Keep</span></label>
                <span class="toggle-slot" data-toggle-lever aria-hidden="true"><span class="toggle-lever"></span></span>
                <label><input type="radio" name="edit" value="remove" /><span>Remove</span></label>
              </div>
            </div>
          </div>
          <div class="sil-row">
            <button class="key key-sm" type="button" data-detect>Detect silence</button>
            <fieldset class="pbs pbs-mini">
              <legend class="cap">Threshold</legend>
              {[-40, -50, -60].map((db) => <label class="pb"><input type="radio" name="sil-db" value={db} checked={db === -50} aria-label={`−${-db} dBFS`} /><span>−{-db} dB</span></label>)}
            </fieldset>
          </div>
          <p class="mod-note" id="dk-time">Times as m:ss.mmm (e.g. 0:01.500) or seconds.</p>
          <p class="mod-note" id="dk-hint">On the display, drag to select or drag a handle. On a handle, ←/→ move 10 ms, Shift+←/→ 1 s. Space plays or pauses.</p>
          <p class="visually-hidden" id="dk-knob">Arrow keys change by 0.1 s, Shift or Page Up/Down by 1 s. Drag up or down.</p>
          <p class="mod-note mod-warn" data-multi-note hidden>Trim, cut and fades work when a single file is loaded. With several files, Convert processes each file in full.</p>
        </fieldset>
      </section>

      <section class="mod mod-out" aria-labelledby="out-title">
        <header class="mod-head">
          <h2 class="mod-title" id="out-title">Output</h2>
          <span class="lamp" data-on aria-hidden="true"><i></i>On device</span>
        </header>
        <fieldset class="pbs">
          <legend class="visually-hidden">Output format</legend>
          <label class="pb"><input type="radio" name="format" value="mp3" checked /><span>MP3</span></label>
          <label class="pb"><input type="radio" name="format" value="wav" /><span>WAV</span></label>
          <label class="pb"><input type="radio" name="format" value="ogg" /><span>OGG</span></label>
        </fieldset>
        <div class="out-grid">
          <div class="fader-bay">
            {localFaders.map((f) => (
              <div class="fader" data-fader={f.id} data-for={f.id} hidden={f.id !== 'mp3'}>
                <div class="fader-body">
                  <ol class="fader-scale" aria-hidden="true">{f.steps.map(([v, label]) => <li data-v={v}>{label}</li>)}</ol>
                  <input class="fader-input" type="range" min="0" max={f.steps.length - 1} step="1" value={f.value} aria-label={f.label} />
                </div>
                <span class="cap" aria-hidden="true">{f.cap}</span>
              </div>
            ))}
            <p class="fader-none" data-for="wav" hidden>16-bit PCM<br />no loss<br />large files</p>
          </div>
          <div class="out-side">
            <dl class="lcd lcd-info">
              <div><dt>Out</dt><dd data-plan>–</dd></div>
              <div><dt>Size</dt><dd data-est>–</dd></div>
            </dl>
            <button class="key key-go" type="button" data-run disabled><span class="go-lamp" aria-hidden="true"></span><span data-run-label>Convert</span></button>
            <button class="key" type="button" data-cancel hidden>Cancel</button>
            <div class="status-row">
              <ProgressDial data-progress />
              <p class="status" data-status role="status" aria-live="polite"></p>
            </div>
          </div>
        </div>
        <p class="mod-note">Keeps the source sample rate. Match picks a bitrate close to the source’s, so lossy files don’t grow. Tags and cover art are not copied.</p>
      </section>

      <section class="mod mod-cloud" data-cloud aria-labelledby="cloud-title">
        <header class="mod-head">
          <Icon name="cloud" />
          <h2 class="mod-title" id="cloud-title">Cloud export</h2>
          <span class="lamp lamp-amber" data-led="cloud" aria-hidden="true"><i></i>Upload</span>
        </header>
        <p class="mod-note mod-lead">Uploads the original file to our EU server (Belgium) for M4A, FLAC or Opus. Tags and cover art are kept, your selection and fades are applied there, nothing is stored. Asks every time.</p>
        {!configured && <p class="warn-box" role="note">The cloud service is not configured for this site, so cloud export is unavailable. Nothing will be uploaded.</p>}
        <fieldset class="pbs pbs-amber" disabled={!configured}>
          <legend class="visually-hidden">Cloud format</legend>
          <label class="pb"><input type="radio" name="cloud-format" value="m4a" checked /><span>M4A</span></label>
          <label class="pb"><input type="radio" name="cloud-format" value="flac" /><span>FLAC</span></label>
          <label class="pb"><input type="radio" name="cloud-format" value="opus" /><span>Opus</span></label>
          <label class="pb"><input type="radio" name="cloud-format" value="mp3" /><span>MP3 + tags</span></label>
        </fieldset>
        <div class="out-grid">
          <div class="fader-bay">
            <div class="fader" data-fader={cloudFader.id}>
              <div class="fader-body">
                <ol class="fader-scale" aria-hidden="true">{cloudFader.steps.map(([v, label]) => <li data-v={v}>{label}</li>)}</ol>
                <input class="fader-input" type="range" min="0" max={cloudFader.steps.length - 1} step="1" value={cloudFader.value} aria-label={cloudFader.label} disabled={!configured} />
              </div>
              <span class="cap" aria-hidden="true">{cloudFader.cap}</span>
            </div>
          </div>
          <div class="out-side">
            <p class="lcd lcd-info" data-cloud-plan>–</p>
            <button class="key key-go key-cloud" type="button" data-cloud-run disabled><span class="go-lamp" aria-hidden="true"></span><Icon name="upload" />Export via cloud</button>
            <button class="key" type="button" data-cloud-cancel hidden>Cancel</button>
            <p class="mod-note mod-warn" data-cloud-hint hidden></p>
            <div class="status-row">
              <ProgressDial data-cloud-progress />
              <p class="status" data-cloud-status role="status" aria-live="polite"></p>
            </div>
          </div>
        </div>
      </section>

      <section class="mod tray" data-tray hidden aria-labelledby="tray-title">
        <h2 class="mod-title" id="tray-title">Output tray</h2>
        <ul class="tray-list" data-tray-list></ul>
      </section>
      <p class="visually-hidden" data-announce aria-live="polite"></p>
    </section>

    <dialog data-consent aria-labelledby="consent-title">
      <h2 id="consent-title"><Icon name="cloud" /> Upload to process?</h2>
      <p>This uploads the original audio file for processing in Belgium (EU). Files are not intentionally retained after processing. Operational request metadata (time, size, IP address) may be logged.</p>
      <p class="muted">Your answer is not remembered; we ask every time.</p>
      <form method="dialog">
        <button class="btn" value="cancel">Cancel</button>
        <button class="btn btn-primary" value="upload" autofocus>Upload &amp; process</button>
      </form>
    </dialog>
    <!-- Icons for markup built in the script. -->
    <template data-icon="xmark"><Icon name="xmark" /></template>
    <template data-icon="download"><Icon name="download" /></template>
  </div>
</Base>

<style is:global>
  .deck {
    --deck-w: min(100vw - 2rem, 1320px);
    /* Surfaces follow the shared app tokens; keys, LEDs and the glass display keep the hardware look. */
    --chassis: var(--app-bg);
    --face: var(--app-side);
    --face-hi: var(--app-bar);
    --edge: color-mix(in srgb, var(--app-line) 82%, #000);
    --bevel: light-dark(rgb(255 255 255 / 0.85), rgb(255 255 255 / 0.06));
    --engrave: light-dark(#5a5d63, #9b9ea6);
    /* Light theme: a reflective grey-green LCD with dark ink; dark theme: backlit glass with glowing phosphor. */
    --glass: light-dark(#cfd8c6, #050606);
    --glass-edge: light-dark(#97a28c, #000);
    --glass-shade: light-dark(rgb(40 60 30 / 0.16), rgb(0 0 0 / 0.55));
    --phos: light-dark(#1d3b2b, #74e2b2);
    --phos-dim: color-mix(in srgb, var(--phos) 52%, transparent);
    --phos-glow: light-dark(transparent, color-mix(in srgb, var(--phos) 45%, transparent));
    --led-g: #43d68c;
    --led-a: #ffb23e;
    --key: light-dark(#e9e9e5, #2b2c30);
    --key-hi: light-dark(#fbfbf9, #35363b);
    --key-edge: light-dark(#a9a9a2, #08090a);
    --key-fg: light-dark(#26282c, #dcdde1);
    --key-dark: light-dark(#2b2d31, #3a3c41);
    --key-dark-hi: light-dark(#3d4045, #4a4c52);
    width: var(--deck-w);
    margin: 1.25rem calc((100% - var(--deck-w)) / 2) 0;
    display: grid;
    gap: 10px;
    padding: 10px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 1.1fr);
    grid-template-areas: 'display display display' 'edit out cloud' 'tray tray tray';
    background: var(--chassis);
    border: 1px solid var(--edge);
    border-radius: 14px;
    box-shadow: var(--shadow);
    color: var(--fg);
    -webkit-tap-highlight-color: transparent;
  }
  .deck.over { outline: 3px solid var(--led-g); outline-offset: -3px; }
  .deck .icon svg { width: 16px; height: 16px; }
  .deck .cap { font: 650 0.62rem/1.2 var(--font); letter-spacing: 0.12em; text-transform: uppercase; color: var(--engrave); }

  /* Modules */
  .dk-display, .mod {
    position: relative; min-width: 0; padding: 12px 14px 14px; border-radius: 10px;
    background: linear-gradient(var(--face-hi), var(--face)); border: 1px solid var(--edge);
    box-shadow: inset 0 1px 0 var(--bevel), 0 1px 2px rgb(0 0 0 / 0.16);
  }
  .mod-edit { grid-area: edit; }
  .mod-out { grid-area: out; }
  .mod-cloud { grid-area: cloud; }
  .mod-title { margin: 0 0 10px; font: 700 0.7rem/1 var(--font); letter-spacing: 0.16em; text-transform: uppercase; color: var(--engrave); }
  .mod-head { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 10px; color: var(--engrave); }
  .mod-head .mod-title { margin: 0; }
  .mod-head .lamp { margin-left: auto; }
  .mod-body { display: grid; gap: 12px; margin: 0; padding: 0; border: 0; min-width: 0; }
  .mod-note { margin: 10px 0 0; font-size: 0.76rem; line-height: 1.4; color: var(--muted); }
  .mod-body .mod-note { margin: 0; }
  .mod-warn { color: color-mix(in srgb, var(--cloud) 70%, var(--fg)); }
  .mod-lead { margin: 0 0 10px; }
  .mod .warn-box { margin: 0 0 10px; font-size: 0.8rem; }
  /* Rack unit: an amber edge marks the cloud module. */
  .mod-cloud {
    background: linear-gradient(var(--face-hi), var(--face));
    box-shadow: inset 3px 0 0 color-mix(in srgb, var(--led-a) 75%, transparent), inset 0 1px 0 var(--bevel), 0 1px 2px rgb(0 0 0 / 0.16);
    padding-left: 18px;
  }
  .mod-cloud .mod-head { color: color-mix(in srgb, var(--cloud) 80%, var(--fg)); }

  /* Lamps (LEDs) */
  .lamps { display: flex; gap: 12px; }
  .lamp { --lamp: var(--led-g); display: inline-flex; align-items: center; gap: 5px; font: 650 0.6rem/1 var(--font); letter-spacing: 0.12em; text-transform: uppercase; color: var(--engrave); white-space: nowrap; }
  .lamp i { width: 8px; height: 8px; border-radius: 50%; background: color-mix(in srgb, var(--lamp) 18%, #26282b); box-shadow: inset 0 1px 1px rgb(0 0 0 / 0.55); }
  .lamp[data-on] i { background: var(--lamp); box-shadow: 0 0 7px var(--lamp), inset 0 -1px 1px rgb(0 0 0 / 0.2); }
  .lamp-amber { --lamp: var(--led-a); }
  .lamp-amber[data-on] i { animation: lamp-blink 1s steps(2, jump-none) infinite; }
  @keyframes lamp-blink { 50% { opacity: 0.45; } }

  /* Display */
  .dk-display { grid-area: display; display: flex; flex-direction: column; gap: 10px; }
  .dk-head { display: flex; align-items: center; gap: 14px; min-height: 18px; }
  .dk-title {
    display: inline-flex; align-items: center; gap: 6px; margin: 0; padding: 3px 9px 3px 7px; border: 1px solid var(--engrave); border-radius: 4px;
    font: 800 0.74rem/1 var(--font); letter-spacing: 0.22em; text-transform: uppercase; color: var(--engrave);
    text-shadow: 0 1px 0 var(--bevel);
  }
  .deck .dk-title .icon svg { width: 15px; height: 15px; }
  .dk-source { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 0.74rem/1.2 var(--mono); color: var(--engrave); }
  .screen {
    position: relative; display: flex; flex-direction: column; height: 270px; overflow: hidden; border-radius: 8px;
    background: radial-gradient(130% 120% at 50% 0%, color-mix(in srgb, var(--phos) 7%, var(--glass)), var(--glass) 65%);
    border: 1px solid var(--glass-edge); color: var(--phos);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.04), inset 0 10px 30px var(--glass-shade), 0 1px 0 var(--bevel);
  }
  .screen::after {
    content: ''; position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
    background: repeating-linear-gradient(to bottom, rgb(255 255 255 / 0.028) 0 1px, transparent 1px 3px), linear-gradient(165deg, rgb(255 255 255 / 0.06), transparent 38%);
  }
  .readouts { display: flex; flex-wrap: wrap; gap: 4px 22px; margin: 0; padding: 8px 12px 6px; border-bottom: 1px solid color-mix(in srgb, var(--phos) 14%, transparent); }
  .readouts div { display: flex; align-items: baseline; gap: 7px; }
  .readouts dt { font: 600 0.58rem/1 var(--font); letter-spacing: 0.14em; text-transform: uppercase; color: var(--phos-dim); }
  .seg { position: relative; margin: 0; font: 500 1rem/1.1 var(--mono); font-variant-numeric: tabular-nums; letter-spacing: 0.04em; text-shadow: 0 0 8px var(--phos-glow); }
  .deck[data-empty] .seg { color: var(--phos-dim); text-shadow: none; }
  .wave-scroll { position: relative; flex: 1; min-height: 0; overflow-x: auto; overflow-y: hidden; color: var(--phos-dim); scrollbar-color: var(--phos-dim) transparent; }
  .wave-track { position: relative; height: 100%; min-width: 100%; user-select: none; -webkit-user-select: none; cursor: crosshair; }
  .wave-track canvas { position: sticky; left: 0; display: block; height: 100%; color: var(--phos); filter: drop-shadow(0 0 2px var(--phos-glow)); }
  .wave-dim { position: absolute; top: 18px; bottom: 0; left: 0; right: 0; background: color-mix(in srgb, var(--glass) 66%, transparent); pointer-events: none; }
  .wave-dim[data-dim='start'] { right: auto; }
  .wave-playhead { position: absolute; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: #f4f6f2; box-shadow: 0 0 6px rgb(255 255 255 / 0.6); pointer-events: none; }
  .wave-handle { position: absolute; top: 0; bottom: 0; width: 24px; margin-left: -12px; cursor: ew-resize; touch-action: none; }
  .wave-handle::before { content: ''; position: absolute; top: 18px; bottom: 0; left: 11px; width: 2px; background: var(--led-a); box-shadow: 0 0 6px color-mix(in srgb, var(--led-a) 60%, transparent); }
  .wave-handle::after { content: ''; position: absolute; top: 1px; left: 7px; width: 10px; height: 15px; border-radius: 2px; background: var(--led-a); }
  .wave-handle:focus-visible { outline: none; }
  .wave-handle:focus-visible::after { outline: 3px solid #fff; outline-offset: 2px; }
  .deck[data-empty] .wave-scroll { display: none; }

  .screen-empty {
    position: relative; flex: 1; display: none; flex-direction: column; align-items: center; justify-content: center; gap: 0.7rem;
