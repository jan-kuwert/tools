  };

  const khz = (rate: number) => `${+(rate / 1000).toFixed(3)} kHz`;
  const chans = (n?: number) => (n === 1 ? 'mono' : n === 2 ? 'stereo' : n ? `${n} ch` : '');
  const time = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
  const outLabel = (p: Plan) =>
    p.format === 'wav' ? `WAV · ${khz(p.sampleRate)} · 16-bit` : `${p.format.toUpperCase()} · ${khz(p.sampleRate)} · ${p.format === 'ogg' ? '≈' : ''}${p.kbps} kbps`;
  const outName = (name: string, ext: string, edited: boolean) => name.replace(/\.[^./]*$/, '') + (edited ? '-edit.' : '.') + ext;
  const errorText = (err: unknown) => (err instanceof UserError ? err.message : `Something went wrong: ${(err as Error).message ?? err}`);
  const isAbort = (err: unknown) => err instanceof DOMException && err.name === 'AbortError';

  /** Rotary knob (role=slider): arrows ±0.1, Shift/PageUp/PageDown ±1, Home/End, vertical drag, double-click resets. */
  function knob(node: HTMLElement, onChange: () => void) {
    const max = Number(node.ariaValueMax);
    const out = $(`[data-knob-out=${node.dataset.knob}]`);
    const off = () => editSet.disabled;
    let value = 0;
    const set = (v: number, notify = true) => {
      value = Math.round(Math.min(max, Math.max(0, v)) * 10) / 10;
      node.style.setProperty('--v', String(value / max));
      node.ariaValueNow = String(value);
      node.ariaValueText = `${value.toFixed(1)} seconds`;
      out.textContent = `${value.toFixed(1)} s`;
      if (notify) onChange();
    };
    node.addEventListener('keydown', (e) => {
      const big = e.shiftKey ? 1 : 0.1;
      const next = { ArrowUp: value + big, ArrowRight: value + big, ArrowDown: value - big, ArrowLeft: value - big, PageUp: value + 1, PageDown: value - 1, Home: 0, End: max }[e.key];
      if (next === undefined || off()) return;
      e.preventDefault();
      set(next);
    });
    let drag: { y: number; v: number } | undefined;
    node.addEventListener('pointerdown', (e) => {
      if (off() || e.button !== 0) return;
      e.preventDefault();
      node.focus();
      node.setPointerCapture(e.pointerId);
      drag = { y: e.clientY, v: value };
    });
    // 150 px of travel covers the whole range.
    node.addEventListener('pointermove', (e) => drag && set(drag.v + ((drag.y - e.clientY) / 150) * max));
    node.addEventListener('pointerup', () => (drag = undefined));
    node.addEventListener('pointercancel', () => (drag = undefined));
    node.addEventListener('dblclick', () => !off() && set(0));
    return {
      get value() {
        return value;
      },
      set,
    };
  }

  /** Vertical fader over a native range input (index into the engraved detents); labels are clickable. */
  function fader(id: string, describe: (v: string) => string, onChange: () => void) {
    const root = $(`[data-fader=${id}]`);
    const input = root.querySelector<HTMLInputElement>('input')!;
    const marks = [...root.querySelectorAll<HTMLElement>('li')];
    const sync = () => {
      input.ariaValueText = describe(marks[+input.value].dataset.v!);
      input.title = input.ariaValueText;
      marks.forEach((m, i) => m.toggleAttribute('data-on', i === +input.value));
    };
    input.addEventListener('input', () => {
      sync();
      onChange();
    });
    marks.forEach((m, i) =>
      m.addEventListener('click', () => {
        if (input.disabled) return;
        input.value = String(i);
        input.focus();
        sync();
        onChange();
      }),
    );
    sync();
    return {
      input,
      sync,
      get value() {
        return marks[+input.value].dataset.v!;
      },
    };
  }

  let files: File[] = [];
  let cur = 0;
  // PCM of the file on the display at its source rate, shared by the waveform and local export.
  let decoded: { file: File; rate: number; channels: Float32Array[] } | undefined;
  let job: AbortController | undefined;
  let cloudJob: AbortController | undefined;
  let urls: string[] = [];
  const matched: Record<'mp3' | 'ogg', number | undefined> = { mp3: undefined, ogg: undefined };

  const checked = (name: string) => $<HTMLInputElement>(`[name=${name}]:checked`).value;
  const wave = createWaveform(deck, (committed) => (committed ? refresh() : showLength()));
  const fades = { in: knob($('[data-knob=in]'), refresh), out: knob($('[data-knob=out]'), refresh) };
  const faders = {
    mp3: fader('mp3', (v) => (v === 'match' ? `Match source${matched.mp3 ? ` (${matched.mp3} kbps)` : ''}` : `${v} kbps`), refresh),
    ogg: fader('ogg', (v) => (v === 'match' ? `Match source${matched.ogg ? ` (~${matched.ogg} kbps)` : ''}` : `Quality ${v} (~${VORBIS_KBPS[v]} kbps)`), refresh),
    cloud: fader('cloud', (v) => (cloudFormat() === 'flac' ? 'Lossless, no bitrate' : `${v} kbps`), refresh),
  };

  const settings = () => {
    const format = checked('format') as Format;
    const raw = format === 'wav' ? 'match' : faders[format].value;
    return { format, choice: raw === 'match' ? ('match' as const) : Number(raw) };
  };

  /** The edit for the single loaded file, or undefined when it would not change anything. */
  function currentEdit(): Edit | undefined {
    if (!decoded || files.length !== 1) return;
    const { start, end, duration } = wave.selection;
    const edit = { start, end, remove: checked('edit') === 'remove', fadeIn: fades.in.value, fadeOut: fades.out.value };
    return edit.remove || start > 0 || end < duration || edit.fadeIn || edit.fadeOut ? edit : undefined;
  }

  function showLength() {
    if (!decoded) {
      outReadout.textContent = '-:--.---';
      return;
    }
    const { start, end, duration } = wave.selection;
    const edit = currentEdit();
    outReadout.textContent = formatTime(!edit ? duration : edit.remove ? duration - (end - start) : end - start);
  }

  let renderId = 0;
  async function render() {
    const id = ++renderId;
    const { format, choice } = settings();
    const infos = await Promise.all(files.map(probe));
    if (id !== renderId) return;
    for (const f of ['mp3', 'ogg'] as const) {
      // With one effective bitrate across files, show it on the Match detent.
      const kbps = new Set(infos.map((info) => planOutput(info, f, 'match').kbps));
      matched[f] = kbps.size === 1 ? [...kbps][0] : undefined;
      faders[f].sync();
    }
    const plans = infos.map((info) => planOutput(info, format, choice));
    const edit = currentEdit();
    if (edit && plans[0].bytes) {
      const { start, end, duration } = wave.selection;
      plans[0].bytes *= (edit.remove ? duration - (end - start) : end - start) / duration;
    }
    planOut.textContent = !files.length ? '–' : files.length === 1 ? outLabel(plans[0]) : `${files.length} files · ${format.toUpperCase()}`;
    const known = plans.every((p) => p.bytes);
    estOut.textContent = files.length && known ? `≈${formatBytes(plans.reduce((n, p) => n + p.bytes!, 0))}` : '–';
  }

  const setScreen = (state: 'empty' | 'loading' | 'ready' | 'error', msg = '') => {
    display.dataset.screenState = state;
    screenMsg.textContent = msg;
  };

  function renderTracks() {
    tracks.hidden = !files.length;
    trackList.replaceChildren(
      ...files.map((f, i) => {
        const pick = el(
          'button',
          { type: 'button', className: 'track', title: f.name },
          el('span', { className: 'track-no', textContent: String(i + 1).padStart(2, '0') }),
          el('span', { className: 'track-name', textContent: f.name }),
          el('span', { className: 'track-size', textContent: formatBytes(f.size) }),
        );
        pick.setAttribute('aria-current', String(i === cur));
        pick.onclick = () => {
          if (i === cur) return;
          cur = i;
          renderTracks();
          void loadTrack();
        };
        const remove = el('button', { type: 'button', className: 'track-x', ariaLabel: `Remove ${f.name}`, title: 'Remove' }, icon('xmark'));
        remove.onclick = () => {
          if (i < cur) cur--;
          setFiles(files.filter((_, j) => j !== i));
        };
        return el('li', {}, pick, remove);
      }),
    );
  }

  let loadId = 0;
  async function loadTrack() {
    const id = ++loadId;
    wave.clear();
    silenceJob?.abort();
    hideSilence();
    decoded = undefined;
    const file = files[cur];
    const single = files.length === 1;
    editSet.disabled = true;
    multiNote.hidden = files.length < 2;
    fades.in.set(0, false);
    fades.out.set(0, false);
    $<HTMLInputElement>(`[name=edit][value=${mode === 'cut' ? 'remove' : 'keep'}]`).checked = true;
    sourceOut.textContent = '';
    if (!file) {
      setScreen('empty');
      refresh();
      return;
    }
    setScreen('loading', 'Loading waveform…');
    try {
      const info = await probe(file);
      if (id !== loadId) return;
      const kbps = sourceKbps(info);
      sourceOut.textContent = [file.name, info.format, khz(info.sampleRate), chans(info.channels), kbps && `≈${Math.round(kbps)} kbps`, info.duration && time(info.duration)].filter(Boolean).join(' · ');
      if (info.duration && info.duration > MAX_SECONDS) throw new UserError(TOO_LONG);
      const channels = await decodeAudio(file, info.sampleRate);
      if (id !== loadId) return;
      decoded = { file, rate: info.sampleRate, channels };
      setScreen('ready');
      wave.load(channels, info.sampleRate, single);
      editSet.disabled = !single;
      if (single) afterDecode(file);
    } catch (err) {
      if (id !== loadId) return;
      setScreen('error', `${err instanceof UserError ? err.message : "This file can't be shown as a waveform."} Trimming is unavailable${API_URL && single ? '; cloud export still works.' : '.'}`);
    }
    refresh();
  }

  function setFiles(next: File[]) {
    job?.abort();
    cloudJob?.abort();
    files = next;
    cur = Math.min(cur, Math.max(0, files.length - 1));
    clearResults();
    setStatus('idle');
    deck.toggleAttribute('data-empty', !files.length);
    renderTracks();
    void loadTrack();
  }

  function addFiles(incoming: File[]) {
    const errors: string[] = [];
    const ok = incoming.filter((f) => {
      if (f.size > MAX_FILE) errors.push(`${f.name}: larger than 200 MB.`);
      return f.size <= MAX_FILE;
    });
    if (ok.length) {
      cur = files.length;
      setFiles([...files, ...ok]);
    }
    if (errors.length) setStatus('error', errors.join('\n'));
  }

  const setStatus = (kind: Status, text = '', fraction?: number) => {
    status.dataset.kind = kind;
    status.textContent = text;
    dial.hidden = kind !== 'working';
    setDial(dial, fraction);
  };

  function clearResults() {
    urls.forEach((u) => URL.revokeObjectURL(u));
    urls = [];
    trayList.replaceChildren();
    tray.hidden = true;
  }

  function showResults(items: Result[]) {
    clearResults();
    trayList.replaceChildren(
      ...items.map((r) => {
        const url = URL.createObjectURL(r.blob);
        urls.push(url);
        const pct = Math.round((r.blob.size / r.inputSize - 1) * 100);
        const delta = pct === 0 ? 'same size' : pct < 0 ? `${-pct}% smaller` : `${pct}% larger`;
        return el(
          'li',
          { className: 'tray-item' },
          el('div', {}, el('p', { className: 'tray-name', textContent: r.name }), el('p', { className: 'tray-meta', textContent: `${formatBytes(r.blob.size)} · ${delta}` }), el('p', { className: 'tray-note', textContent: r.note })),
          el('audio', { src: url, controls: true, preload: 'metadata', ariaLabel: `Preview ${r.name}` }),
          el('a', { className: 'key key-dark', href: url, download: r.name, ariaLabel: `Download ${r.name}` }, icon('download'), 'Download'),
        );
      }),
    );
    tray.hidden = false;
    trayList.querySelector<HTMLElement>('a')?.focus();
  }

  async function convertAll(signal: AbortSignal, progress: (text: string, fraction: number) => void): Promise<Result[]> {
    const { format, choice } = settings();
    const edit = currentEdit();
    const results: Result[] = [];
    for (const [i, f] of files.entries()) {
      throwIfAborted(signal);
      const step = (text: string, frac: number) => progress(`${text} ${f.name}`, (i + frac) / files.length);
      step('Decoding', 0);
      const info = await probe(f);
      const plan = planOutput(info, format, choice);
      let channels = decoded?.file === f && decoded.rate === plan.sampleRate ? decoded.channels : await decodeAudio(f, plan.sampleRate);
      const fullSeconds = channels[0].length / plan.sampleRate;
      if (edit) channels = applyEdit(channels, plan.sampleRate, edit);
      throwIfAborted(signal);
      step('Encoding', 0);
      plan.channels = channels.length as 1 | 2;
      const blob =
        format === 'wav' ? encodeWav(channels, plan.sampleRate) : await encodeLossy(channels, plan, format === 'mp3' ? mp3Wasm : oggWasm, signal, (frac) => step('Encoding', frac));
      const seconds = channels[0].length / plan.sampleRate;
      const actual = format === 'ogg' ? `OGG · ${khz(plan.sampleRate)} · ≈${Math.round((blob.size * 8) / seconds / 1000)} kbps` : outLabel(plan);
      results.push({
        name: outName(f.name, format, !!edit),
        blob,
        inputSize: f.size,
        note: [actual + '.', growthReason({ ...info, duration: info.duration ?? fullSeconds }, plan, blob.size, f.size), 'Tags and cover art are not copied.'].filter(Boolean).join(' '),
      });
    }
    return results;
  }

  runBtn.onclick = async () => {
    if (!files.length || job) return;
    wave.stop();
    const controller = (job = new AbortController());
    clearResults();
    runBtn.disabled = true;
    cancelBtn.hidden = false;
    setStatus('working', 'Working…');
    try {
      const results = await convertAll(controller.signal, (text, fraction) => setStatus('working', text, fraction));
      setStatus('done', 'Done. See the output tray.');
      showResults(results);
    } catch (err) {
      if (isAbort(err)) setStatus('idle', 'Cancelled.');
      else {
        console.error(err);
        setStatus('error', errorText(err));
      }
    } finally {
      if (job === controller) job = undefined;
      cancelBtn.hidden = true;
      runBtn.disabled = !files.length;
    }
  };
  cancelBtn.onclick = () => job?.abort();

  // Cloud export: optional, confirmed before every upload, sends the original file plus edit parameters.
  const cloud = $('[data-cloud]');
  const cloudPlan = cloud.querySelector<HTMLElement>('[data-cloud-plan]')!;
  const cloudHint = cloud.querySelector<HTMLElement>('[data-cloud-hint]')!;
  const cloudRun = cloud.querySelector<HTMLButtonElement>('[data-cloud-run]')!;
  const cloudCancel = cloud.querySelector<HTMLButtonElement>('[data-cloud-cancel]')!;
  const cloudDial = cloud.querySelector<HTMLElement>('[data-cloud-progress]')!;
  const cloudStatus = cloud.querySelector<HTMLElement>('[data-cloud-status]')!;
  const cloudLeds = deck.querySelectorAll<HTMLElement>('[data-led=cloud]');
  const CLOUD_LABELS = { m4a: 'M4A (AAC)', flac: 'FLAC', opus: 'Opus', mp3: 'MP3' };
  const CLOUD_ERRORS = {
    413: 'The file is larger than 30 MB, the limit for cloud export.',
    415: 'The server could not decode this file as audio.',
    422: 'The server rejected these settings. The selection may lie outside the audio, or the audio is longer than 60 minutes.',
    504: 'Processing took too long. Try a shorter file or selection.',
  };

  function cloudFormat() {
    return checked('cloud-format') as keyof typeof CLOUD_LABELS;
  }
  function cloudBlocker(): string {
    if (files.length !== 1) return files.length ? 'Cloud export works on one file at a time.' : 'Choose an audio file first.';
    if (files[0].size > MAX_CLOUD) return `This file is ${formatBytes(files[0].size)}, too large for cloud export (up to 30 MB). Local output has no such limit.`;
    const edit = currentEdit();
    if (edit?.remove) return 'Remove selection is only available for local output. Switch the selection to Keep to export via the cloud.';
    if (edit && edit.fadeIn + edit.fadeOut > edit.end - edit.start) return 'Fade in and fade out together are longer than the selection.';
    return '';
  }
  function syncCloud() {
    const format = cloudFormat();
    faders.cloud.input.disabled = !API_URL || format === 'flac';
    faders.cloud.sync();
    cloudPlan.textContent = `${CLOUD_LABELS[format]} · ${format === 'flac' ? 'lossless' : `${faders.cloud.value} kbps`}${format === 'opus' ? ' · 48 kHz' : ''}`;
    const why = API_URL ? cloudBlocker() : '';
    cloudHint.textContent = why;
    cloudHint.hidden = !why;
    cloudRun.disabled = !API_URL || !!why || !!cloudJob;
  }
  const setCloudStatus = (kind: Status, text: string, fraction?: number) => {
    cloudStatus.dataset.kind = kind;
    cloudStatus.textContent = text;
    cloudDial.hidden = kind !== 'working';
    setDial(cloudDial, fraction);
    cloudLeds.forEach((l) => l.toggleAttribute('data-on', kind === 'working'));
  };
  cloudCancel.onclick = () => cloudJob?.abort();

  cloudRun.onclick = async () => {
    const file = files[0];
    if (!file || cloudBlocker() || cloudJob || !(await confirmUpload())) return;
    wave.stop();
    const format = cloudFormat();
    const edit = currentEdit();
    const sec = (s: number) => String(Math.round(s * 1e6) / 1e6);
    const query = new URLSearchParams({ format });
    if (format !== 'flac') query.set('bitrate', faders.cloud.value);
    if (edit) {
      if (edit.start > 0) query.set('start', sec(edit.start));
      // Omit an end at (or within a millisecond of) the decoded end: the server's duration may differ by a few samples.
      if (edit.end < wave.selection.duration - 0.001) query.set('end', sec(edit.end));
      if (edit.fadeIn) query.set('fade_in', sec(edit.fadeIn));
      if (edit.fadeOut) query.set('fade_out', sec(edit.fadeOut));
    }
    const controller = (cloudJob = new AbortController());
    clearResults();
    cloudCancel.hidden = false;
    syncCloud();
    setCloudStatus('working', 'Uploading… 0%', 0);
    try {
      const blob = await uploadForResult(`/v1/audio/convert?${query}`, file.slice(0, file.size, 'application/octet-stream'), {
        signal: controller.signal,
        onUploadProgress: (f) => (f < 1 ? setCloudStatus('working', `Uploading… ${Math.round(f * 100)}%`, f) : setCloudStatus('working', 'Processing on server…')),
        messages: CLOUD_ERRORS,
      });
      setCloudStatus('done', 'Done. See the output tray.');
      const kept = format === 'opus' ? 'Tags kept; Opus files carry no cover art here.' : 'Tags and cover art kept.';
      showResults([{ name: outName(file.name, format, !!edit), blob, inputSize: file.size, note: `${CLOUD_LABELS[format]} · converted on our EU server. ${kept}` }]);
    } catch (err) {
      if (isAbort(err)) setCloudStatus('idle', 'Cancelled.');
      else setCloudStatus('error', errorText(err));
    } finally {
      if (cloudJob === controller) cloudJob = undefined;
      cloudCancel.hidden = true;
      syncCloud();
    }
  };

  function refresh() {
    const { format } = settings();
    deck.querySelectorAll<HTMLElement>('[data-for]').forEach((e) => (e.hidden = e.dataset.for !== format));
    runLabel.textContent = files.length > 1 ? `Convert ${files.length} files` : 'Convert';
    if (!job) runBtn.disabled = !files.length;
    showLength();
    syncCloud();
    void render();
  }

  // Files: the empty display's picker, the Add key, drag and drop anywhere on the console, and paste.
  deck.querySelectorAll<HTMLInputElement>('[data-input], [data-add]').forEach((input) =>
    input.addEventListener('change', () => {
      const picked = [...(input.files ?? [])];
      input.value = '';
      addFiles(picked);
    }),
  );
  deck.addEventListener('dragover', (e) => {
    e.preventDefault();
    deck.classList.add('over');
  });
  deck.addEventListener('dragleave', (e) => {
    if (!deck.contains(e.relatedTarget as Node | null)) deck.classList.remove('over');
  });
  deck.addEventListener('drop', (e) => {
    e.preventDefault();
    deck.classList.remove('over');
    addFiles([...(e.dataTransfer?.files ?? [])]);
  });
  document.addEventListener('paste', (e) => {
    const pasted = [...(e.clipboardData?.files ?? [])];
    if (pasted.length) addFiles(pasted);
  });
  $('[data-eject]').addEventListener('click', () => setFiles([]));
  $('[data-toggle-lever]').addEventListener('click', () => {
    if (editSet.disabled) return;
    $<HTMLInputElement>('[name=edit]:not(:checked)').checked = true;
    refresh();
  });
  deck.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).matches('[name=format], [name=edit], [name=cloud-format]')) refresh();
  });

  // Silence detection: runs after each decode (unless ignored for that file) and from the Detect key.
  const silBar = $('[data-silence]');
  const silText = $('[data-silence-text]');
  const silKeys = {
    both: $<HTMLButtonElement>('[data-sil=both]'),
    start: $<HTMLButtonElement>('[data-sil=start]'),
    end: $<HTMLButtonElement>('[data-sil=end]'),
    ignore: $<HTMLButtonElement>('[data-sil=ignore]'),
  };
  const announce = $('[data-announce]');
  const ignored = new WeakSet<File>();
  let silenceJob: AbortController | undefined;
  let found: Silence | undefined;

  function hideSilence() {
    silBar.hidden = true;
    found = undefined;
  }

  /** Detect on the loaded file and show the prompt; `quiet` shows nothing when there is no silence. */
  async function runSilence(quiet: boolean): Promise<Silence | undefined> {
    silenceJob?.abort();
    hideSilence();
    const source = decoded;
    if (!source || files.length !== 1) return;
    const controller = (silenceJob = new AbortController());
    const db = Number(checked('sil-db'));
    const result = await detectSilence(source.channels, source.rate, { thresholdDb: db, signal: controller.signal });
    if (controller.signal.aborted || decoded !== source) return;
    silenceJob = undefined;
    found = result;
    let text = `No silence found at −${-db} dBFS.`;
    if (result) {
      const parts = [result.lead && `${result.lead.toFixed(1)} s at the start`, result.trail && `${result.trail.toFixed(1)} s at the end`].filter(Boolean);
      text = `Silence detected: ${parts.join(', ')}. Trim it?`;
    } else if (quiet) return;
    silText.textContent = text;
    silKeys.both.hidden = !result;
    silKeys.start.hidden = silKeys.end.hidden = !result?.lead || !result.trail;
    silKeys.ignore.textContent = result ? 'Ignore' : 'Close';
    silBar.hidden = false;
    announce.textContent = text;
    return result;
  }

  function trimSilence(start: boolean, end: boolean) {
    if (!found) return;
    const sel = wave.selection;
    $<HTMLInputElement>('[name=edit][value=keep]').checked = true;
    wave.select(start ? found.lead : sel.start, end ? sel.duration - found.trail : sel.end);
    hideSilence();
    const now = wave.selection;
    announce.textContent = `Selection set to ${formatTime(now.start)} – ${formatTime(now.end)}. Adjust the handles if needed, then convert.`;
    $('[data-handle=start]').focus();
  }
  silKeys.both.onclick = () => trimSilence(true, true);
  silKeys.start.onclick = () => trimSilence(true, false);
  silKeys.end.onclick = () => trimSilence(false, true);
  silKeys.ignore.onclick = () => {
    if (found && decoded) ignored.add(decoded.file);
    hideSilence();
    announce.textContent = '';
    $('[data-detect]').focus();
  };
  $('[data-detect]').addEventListener('click', async () => {
    const result = await runSilence(false);
    if (result) silKeys.both.focus();
  });

  // Deep links from the tool list: ?mode=trim|cut|fade|silence|cloud preselects and focuses the matching control.
  const mode = new URLSearchParams(location.search).get('mode');
  const modeModule: Record<string, HTMLElement> = { trim: $('.mod-edit'), cut: $('.mod-edit'), fade: $('.mod-edit'), silence: $('.mod-edit'), cloud };
  // Focus waits for the first decoded file, since the edit controls are disabled until then.
  let pendingMode = mode && mode in modeModule ? mode : undefined;

  function flash(node: HTMLElement) {
    node.classList.remove('flash');
    void node.offsetWidth; // restart the animation
    node.classList.add('flash');
    setTimeout(() => node.classList.remove('flash'), 1100);
  }

  function afterDecode(file: File) {
    const focusMode = pendingMode;
    pendingMode = undefined;
    if (focusMode === 'silence' || !ignored.has(file)) {
      void runSilence(focusMode !== 'silence').then((result) => focusMode === 'silence' && result && silKeys.both.focus());
    }
    if (!focusMode) return;
    flash(modeModule[focusMode]);
    if (focusMode === 'trim' || focusMode === 'cut') $('[data-handle=start]').focus();
    else if (focusMode === 'fade') $('[data-knob=in]').focus();
    else if (focusMode === 'cloud') {
      const target = cloud.querySelector<HTMLElement>('[name=cloud-format]:checked:not(:disabled)') ?? cloudRun;
      target.focus();
    }
  }

  setStatus('idle');
  refresh();
  if (pendingMode) {
    const target = modeModule[pendingMode];
    flash(target);
    if (pendingMode === 'cloud') target.scrollIntoView({ block: 'nearest' });
  }
</script>
