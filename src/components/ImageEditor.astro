---
// Image editor markup. Behaviour: initImageEditor() in src/lib/editor.ts. Include at most once per page.
import Icon from './Icon.astro';
import ModeBadge from './ModeBadge.astro';
import ProgressDial from './ProgressDial.astro';
import { choiceLabel, RATIOS, SCALES, SIZES } from '../lib/editor';

const accept = 'image/jpeg,image/png,image/webp,image/svg+xml,.svg';
const cloudReady = Boolean(import.meta.env.PUBLIC_API_URL);
const bgTip = cloudReady ? 'Uploads this image to our EU server; asks first' : 'Not available: the cloud service is not configured on this site';
---
<section class="image-editor" data-image-editor data-empty aria-label="Image editor">
  <form class="ie-body" data-form>
    <div class="ie-main">
      <div class="ie-tb" role="toolbar" aria-label="Image tools">
        <div class="ie-tb-group ie-title">
          <Icon name="images" /><h2>Images</h2><ModeBadge mode="local" />
        </div>
        <div class="ie-tb-group">
          <label class="ie-tool" title="Add images">
            <Icon name="plus" /><span class="ie-tool-label">Add</span>
            <input class="visually-hidden" type="file" accept={accept} multiple data-add aria-label="Add images" />
          </label>
        </div>
        <div class="ie-tb-group">
          <button class="ie-tool" type="button" data-needs-image data-rotate-left aria-label="Rotate left" title="Rotate left"><Icon name="rotate-left" /></button>
          <button class="ie-tool" type="button" data-needs-image data-rotate-right aria-label="Rotate right" title="Rotate right"><Icon name="rotate-right" /></button>
          <button class="ie-tool" type="button" data-needs-image data-flip aria-label="Flip horizontally" title="Flip horizontally (mirror left ↔ right)"><Icon name="flip" /></button>
          <button class="ie-tool" type="button" data-needs-image data-flip-v aria-label="Flip vertically" title="Flip vertically (mirror top ↕ bottom)"><Icon name="flip" class="ie-flip-v" /></button>
        </div>
        <div class="ie-tb-group">
          <button class="ie-tool" type="button" data-crop-apply disabled aria-label="Crop to selection" title="Crop to selection (Enter)"><Icon name="crop" /></button>
          <button class="ie-tool" type="button" data-cut disabled aria-label="Cut out selection" title="Cut out selection: make it transparent (Delete)"><Icon name="scissor" /></button>
          <button class="ie-tool" type="button" data-undo disabled aria-label="Undo" title="Undo crop, cut or background removal (Ctrl+Z / ⌘Z)"><Icon name="undo" /></button>
          <button class="ie-tool" type="button" data-redo disabled aria-label="Redo" title="Redo (Shift+Ctrl+Z / ⇧⌘Z)"><Icon name="redo" /></button>
        </div>
        <div class="ie-tb-group ie-zoom">
          <button class="ie-tool" type="button" data-needs-image data-zoom-out aria-label="Zoom out" title="Zoom out"><Icon name="zoom-out" /></button>
          <input type="range" name="zoom" min="1" max="8" step="0.01" value="1" aria-label="Zoom" data-needs-image />
          <button class="ie-tool" type="button" data-needs-image data-zoom-in aria-label="Zoom in" title="Zoom in"><Icon name="zoom-in" /></button>
          <button class="ie-tool" type="button" data-needs-image data-reset title="Reset the selection">Reset</button>
        </div>
        <div class="ie-tb-group">
          <button class="ie-tool ie-cloud" type="button" data-remove-bg data-needs-image disabled title={bgTip} data-tip={bgTip} data-ready={cloudReady || undefined}>
            <Icon name="cloud" /><span class="ie-tool-label">Remove background</span>
          </button>
        </div>
        <div class="ie-tb-group ie-tb-end">
          <button class="ie-tool" type="button" data-needs-image data-remove-image aria-label="Remove this image from the editor" title="Remove this image"><Icon name="xmark" /></button>
        </div>
      </div>

      <div class="ie-stage">
        <canvas data-canvas tabindex="0" role="application" aria-roledescription="crop area" aria-label="Image preview" aria-describedby="ie-help ie-crop"></canvas>
        <div class="ie-float" data-float hidden>
          <button class="ie-tool" type="button" data-crop-apply title="Crop to selection (Enter)"><Icon name="crop" />Crop</button>
          <button class="ie-tool" type="button" data-cut title="Cut out selection (Delete)"><Icon name="scissor" />Cut</button>
        </div>
        <label class="ie-empty" data-empty-state>
          <span class="ie-ph" aria-hidden="true">
            <svg viewBox="0 0 120 90"><rect x="5" y="5" width="110" height="80" rx="10" /><circle cx="38" cy="32" r="8" /><path d="M8 76 38 46l20 18 16-13 38 29" /></svg>
          </span>
          <span class="ie-empty-title">Drop images or choose files</span>
          <span class="btn btn-primary"><Icon name="upload" />Choose files</span>
          <span class="ie-empty-hint">JPEG, PNG, WebP or SVG. You can also paste from the clipboard.</span>
          <input class="visually-hidden" type="file" accept={accept} multiple data-input />
        </label>
        <div class="ie-busy" data-busy hidden>
          <ProgressDial data-dial />
          <p data-busy-text role="status" aria-live="polite"></p>
          <button class="btn" type="button" data-busy-cancel>Cancel</button>
        </div>
      </div>
      <p class="ie-info"><span class="ie-name" data-name></span><span id="ie-crop" data-crop></span></p>
      <p class="visually-hidden" id="ie-help">Drag the corners or edges of the selection to resize it, drag inside to move it, or use the arrow keys; hold Shift for bigger steps. Plus and minus zoom. Enter crops to the selection, Delete cuts it out. Ctrl or Command Z undoes, with Shift it redoes.</p>
      <ul class="ie-thumbs" data-thumbs aria-label="Images" hidden></ul>
    </div>

    <div class="pane-resizer" role="separator" aria-orientation="vertical" tabindex="0" aria-label="Resize settings panel" data-side-resizer></div>

    <fieldset class="ie-side" data-side disabled>
      <legend class="visually-hidden">Output settings</legend>
      <fieldset>
        <legend>Aspect ratio</legend>
        <div class="ie-chips">
          {RATIOS.map((id) => <label><input type="radio" name="ratio" value={id} checked={id === 'original'} /><span>{choiceLabel(id)}</span></label>)}
          <button class="ie-chip-btn" type="button" data-swap aria-label="Swap orientation" title="Swap orientation (e.g. 3:2 ⇄ 2:3)">⇄</button>
        </div>
      </fieldset>
      <div class="ie-pair" data-custom-ratio hidden>
        <label class="field"><span>Ratio width</span><input type="number" name="rw" min="0.01" step="any" value="3" inputmode="decimal" /></label>
        <span aria-hidden="true">:</span>
        <label class="field"><span>Ratio height</span><input type="number" name="rh" min="0.01" step="any" value="2" inputmode="decimal" /></label>
      </div>

      <fieldset>
        <legend>Size, long side (px)</legend>
        <div class="ie-chips">
          {SIZES.filter((id) => id !== 'custom').map((id) => <label><input type="radio" name="size" value={id} /><span>{choiceLabel(id)}</span></label>)}
        </div>
      </fieldset>
      <fieldset>
        <legend>Scale</legend>
        <div class="ie-chips">
          {SCALES.map((p) => <label><input type="radio" name="scale" value={p} /><span>{p}%</span></label>)}
        </div>
      </fieldset>
      <div class="ie-size">
        <label class="field"><span>Width</span><input type="number" name="cw" min="1" step="1" inputmode="numeric" /></label>
        <span aria-hidden="true">×</span>
        <label class="field"><span>Height</span><input type="number" name="ch" min="1" step="1" inputmode="numeric" /></label>
        <label class="field"><span>Scale %</span><input type="number" name="pct" min="0.1" step="any" inputmode="decimal" /></label>
      </div>

      <fieldset data-fit-set>
        <legend>Fit</legend>
        <div class="segmented">
          <label><input type="radio" name="fit" value="fill" checked /><span>Crop to frame</span></label>
          <label><input type="radio" name="fit" value="fit" /><span>Fit inside</span></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Background</legend>
        <div class="ie-bg">
          <div class="segmented" data-bg-set>
            <label><input type="radio" name="bg" value="none" checked /><span>Transparent</span></label>
            <label><input type="radio" name="bg" value="colour" /><span>Colour</span></label>
          </div>
          <input type="color" name="colour" value="#ffffff" aria-label="Background colour" />
        </div>
      </fieldset>

      <div class="field" data-quality-field>
        <span id="ie-quality">Quality</span>
        <div class="ie-quality">
          <input type="range" name="quality" min="1" max="100" value="82" aria-labelledby="ie-quality" />
          <input type="number" min="1" max="100" step="1" inputmode="numeric" aria-labelledby="ie-quality" data-quality-num />
        </div>
      </div>
      <label class="ie-check"><input type="checkbox" role="switch" name="strip" checked /> Remove metadata (EXIF, GPS location)</label>
      <p class="ie-note" data-gps-hint hidden>Location data will be kept.</p>
      <p class="ie-note" data-svg-note hidden>SVG is rasterized: it is saved as pixels, drawn sharp at the output size. Crop and Cut convert it to pixels.</p>
      <p class="warn-box" data-upscale-warn role="status" hidden></p>
      <p class="warn-box" data-problem hidden></p>

      <div class="ie-actions">
        <p class="warn-box" data-jpeg-warn hidden>JPEG has no transparency: transparent areas get the background colour.</p>
        <dl class="ie-out">
          <dt>Output</dt><dd data-dims>–</dd>
          <dt>File size</dt><dd data-estimate>–</dd>
        </dl>
        <div class="ie-split">
          <button class="btn btn-primary" type="button" data-download><Icon name="arrow-down" />Download</button>
          <select name="format" aria-label="File type">
            <option value="image/jpeg">JPEG</option>
            <option value="image/png">PNG</option>
            <option value="image/webp" selected>WebP</option>
          </select>
        </div>
        <button class="btn" type="button" data-download-all hidden>Download all (ZIP)</button>
        <p class="status" data-status role="status" aria-live="polite"></p>
      </div>
    </fieldset>
  </form>

  <dialog data-consent aria-labelledby="consent-title">
    <h2 id="consent-title"><Icon name="cloud" /> Upload to remove the background?</h2>
    <p>This uploads the current image for processing in Belgium (EU). Files are not intentionally retained after processing. Operational request metadata (time, size, IP address) may be logged.</p>
    <p class="muted">Your answer is not remembered; we ask every time.</p>
    <form method="dialog">
      <button class="btn" value="cancel">Cancel</button>
      <button class="btn btn-primary" value="upload" autofocus>Upload &amp; process</button>
    </form>
  </dialog>
</section>

<style is:global>
  .image-editor {
    --ie-w: min(100vw - 2rem, 1280px);
    /* Canvas-only colours derived from the shared app tokens. */
    --ie-check-a: color-mix(in srgb, var(--fg) 6%, var(--app-stage));
    --ie-check-b: color-mix(in srgb, var(--fg) 12%, var(--app-stage));
    --ie-dim: color-mix(in srgb, var(--app-stage) 70%, transparent);
    width: var(--ie-w);
    margin: 1.5rem calc((100% - var(--ie-w)) / 2) 0;
    background: var(--app-bg);
    border: 1px solid var(--app-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    scroll-margin-top: 72px;
  }
  .image-editor .icon svg { width: 18px; height: 18px; }
  .ie-flip-v svg { transform: rotate(90deg); }

  .ie-body { display: grid; grid-template-columns: minmax(0, 1fr) auto var(--ie-side, 340px); height: clamp(560px, calc(100dvh - 140px), 920px); }
  .ie-main { display: flex; flex-direction: column; min-width: 0; background: var(--app-stage); color: var(--fg); }

  /* Toolbar: compact groups with dividers, 34 px controls. */
  .ie-tb { display: flex; align-items: center; flex-wrap: wrap; gap: 0.25rem 0; padding: 0.4rem 0.5rem; background: var(--app-bar); border-bottom: 1px solid var(--app-line); }
  .ie-tb-group { display: flex; align-items: center; gap: 0.1rem; padding: 0 0.4rem; }
  .ie-tb-group + .ie-tb-group { border-left: 1px solid var(--app-line); }
  .ie-tb-end { margin-left: auto; }
  /* Own title only when embedded in the hub; the standalone page has its h1. */
  :root:not([data-embed]) .ie-title { display: none; }
  :root:not([data-embed]) .ie-title + .ie-tb-group { border-left: 0; }
  .ie-title { gap: 0.45rem; padding-left: 0.35rem; padding-right: 0.75rem; }
  .ie-title h2 { margin: 0; font-size: 0.98rem; font-weight: 650; white-space: nowrap; }
  .ie-title .mode::after { left: -6px; right: auto; }
  .ie-tool {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; min-width: 34px; height: 34px; padding: 0 0.5rem;
    border: 0; border-radius: 8px; background: transparent; color: inherit; font: inherit; font-size: 0.86rem; font-weight: 600; cursor: pointer; white-space: nowrap;
  }
  .ie-tool:hover:not(:disabled) { background: var(--app-hover); }
  .ie-tool:disabled { opacity: 0.4; cursor: default; }
  .ie-tool:focus-visible, label.ie-tool:focus-within { outline: 3px solid var(--accent); outline-offset: 1px; }
  .ie-tool[hidden] { display: none; }
  .ie-zoom input { width: 7rem; }
  .ie-cloud { position: relative; }

  .ie-stage { position: relative; flex: 1; min-height: 0; }
  .ie-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; }
  .ie-stage canvas:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }
  .image-editor[data-empty] .ie-stage canvas, .image-editor:not([data-empty]) .ie-empty { display: none; }
  .ie-float {
    position: absolute; display: flex; gap: 0.15rem; padding: 3px; z-index: 2;
    background: var(--app-bar); border: 1px solid var(--app-line); border-radius: 10px; box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
  }
  .ie-float[hidden] { display: none; }
  .ie-float .ie-tool { height: 30px; }

  .ie-empty {
    position: absolute; inset: 1rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem;
    border: 2px dashed color-mix(in srgb, var(--fg) 22%, transparent); border-radius: 14px; text-align: center; cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .ie-empty:hover, .image-editor.ie-over .ie-empty { border-color: var(--accent); background: var(--app-selected); }
  .ie-empty:focus-within { outline: 3px solid var(--accent); outline-offset: 2px; }
  .ie-ph {
    display: grid; place-items: center; width: 168px; height: 128px; border-radius: 16px; margin-bottom: 0.25rem; color: var(--muted);
    background: repeating-conic-gradient(color-mix(in srgb, var(--fg) 7%, transparent) 0 25%, transparent 0 50%) 0 0 / 16px 16px;
  }
  .ie-ph svg { width: 120px; height: 90px; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .ie-empty-title { font-size: 1.15rem; font-weight: 650; }
  .ie-empty-hint { font-size: 0.85rem; color: var(--muted); }
  .image-editor.ie-over .ie-stage { box-shadow: inset 0 0 0 3px var(--accent); }

  .ie-busy {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem;
    background: color-mix(in srgb, var(--app-stage) 78%, transparent); backdrop-filter: blur(2px); text-align: center;
  }
  .ie-busy[hidden] { display: none; }
  .ie-busy p { margin: 0; font-weight: 600; }

  .ie-info { display: flex; gap: 0.75rem; margin: 0; padding: 0.35rem 0.9rem 0.5rem; font: 0.78rem/1.4 var(--mono); min-height: 2em; color: var(--muted); }
  .ie-name { min-width: 0; max-width: 40%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; color: var(--fg); }
  .ie-thumbs { list-style: none; display: flex; gap: 0.45rem; overflow-x: auto; margin: 0; padding: 0.55rem 0.75rem 0.7rem; background: var(--app-bar); border-top: 1px solid var(--app-line); }
  .ie-thumb { display: block; width: 52px; height: 52px; padding: 0; border-radius: 8px; border: 2px solid transparent; overflow: hidden; cursor: pointer; }
  .ie-thumb[aria-current='true'] { border-color: var(--accent); }
  .ie-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .ie-side { display: grid; gap: 0.9rem; align-content: start; min-width: 0; margin: 0; padding: 1rem; border: 0; border-left: 1px solid var(--app-line); background: var(--app-side); font-size: 0.92rem; overflow-y: auto; overscroll-behavior: contain; }
  .ie-side:disabled > :not(legend, .ie-actions), .ie-side:disabled .ie-actions > * { opacity: 0.5; }
  .ie-side fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .ie-side fieldset legend, .ie-side .field > span { font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 0.4rem; padding: 0; }
  .ie-side .field { gap: 0.15rem; }
  .ie-side input[type='number'], .ie-side select { width: 100%; height: 34px; padding: 0 0.55rem; border-radius: 8px; border-color: var(--app-line); }
  .ie-side .segmented { display: flex; background: var(--app-hover); }
  .ie-side .segmented label { flex: 1; text-align: center; }
  .ie-side .segmented span { padding: 0.3rem 0.5rem; font-size: 0.86rem; }
  .ie-side [type='range'] { width: 100%; }
  .ie-chips { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .ie-chips label { position: relative; }
  .ie-chips input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .ie-chips span, .ie-chip-btn { display: block; padding: 0.22rem 0.6rem; border: 1px solid var(--app-line); border-radius: 999px; background: transparent; color: inherit; font-family: inherit; font-weight: 600; font-size: 0.8rem; line-height: 1.35; font-variant-numeric: tabular-nums; }
  .ie-chips label:hover span, .ie-chip-btn:hover:not(:disabled) { background: var(--app-hover); }
  .ie-chips input:checked + span { border-color: var(--accent); background: var(--app-selected); color: var(--accent); }
  .ie-chips input:focus-visible + span, .ie-chip-btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 1px; }
  .ie-chip-btn { cursor: pointer; }
  .ie-chip-btn:disabled { opacity: 0.4; cursor: default; }
  .ie-pair { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.4rem; align-items: end; }
  .ie-pair[hidden] { display: none; }
  .ie-size { display: grid; grid-template-columns: 1fr auto 1fr 0.9fr; gap: 0.4rem; align-items: end; }
  .ie-pair > span, .ie-size > span { padding-bottom: 0.45rem; color: var(--muted); }
  .ie-check { display: flex; gap: 0.5rem; align-items: center; }
  .ie-check input, .ie-bg [type='color'] { accent-color: var(--accent); }
  .ie-bg { display: flex; gap: 0.5rem; align-items: center; }
  .ie-bg .segmented { flex: 1; }
  .ie-bg [type='color'] { width: 2.6rem; height: 2.1rem; padding: 2px; border: 1px solid var(--app-line); border-radius: 8px; background: var(--app-side); cursor: pointer; flex: none; }
  .ie-bg [type='color']:disabled { opacity: 0.35; cursor: default; }
  .ie-side .warn-box { margin: 0; }
  .ie-note { margin: -0.5rem 0 0; font-size: 0.8rem; color: var(--muted); }
  .ie-quality { display: flex; gap: 0.6rem; align-items: center; }
  .ie-side .ie-quality [type='number'] { width: 4.5rem; flex: none; }
  .ie-out { display: grid; grid-template-columns: auto 1fr; gap: 0.15rem 0.75rem; margin: 0; padding: 0.5rem 0.7rem; border-radius: 10px; background: var(--app-hover); font-size: 0.88rem; font-variant-numeric: tabular-nums; }
  .ie-out dt { color: var(--muted); }
  .ie-out dd { margin: 0; text-align: right; font-weight: 600; }
  .ie-actions { display: grid; gap: 0.55rem; position: sticky; bottom: 0; margin: 0 -1rem -1rem; padding: 0.75rem 1rem 1rem; background: var(--app-side); border-top: 1px solid var(--app-line); }
  .ie-split { display: flex; }
  .ie-split .btn { flex: 1; justify-content: center; border-radius: 10px 0 0 10px; }
  .ie-side .ie-split select { width: 6.5rem; height: auto; border-radius: 0 10px 10px 0; border-left: 0; font-weight: 600; background: var(--app-bar); }
  .ie-actions .status { margin: 0; min-height: 0; font-size: 0.85rem; }
  .ie-actions .status:empty { display: none; }

  @media (max-width: 820px) {
    .ie-body { grid-template-columns: minmax(0, 1fr); height: auto; }
    .ie-body > .pane-resizer { display: none; }
    .ie-side { border-left: 0; border-top: 1px solid var(--app-line); overflow: visible; }
    .ie-stage { flex: none; height: clamp(300px, 58dvh, 540px); }
    .ie-tool-label { display: none; }
  }
  @media (max-width: 480px) {
    .image-editor { --ie-w: calc(100vw - 1rem); border-radius: 10px; }
    .ie-tb-group.ie-zoom { order: 9; flex-basis: 100%; border-left: 0; }
    .ie-zoom input { flex: 1; width: auto; }
  }
</style>
