---
// Image editor markup. Behaviour: openImageEditor() in src/lib/editor.ts. Include at most once per page.
import Icon from './Icon.astro';
import { choiceLabel, RATIOS, SIZES } from '../lib/editor';
---
<section class="image-editor" data-image-editor hidden tabindex="-1" aria-labelledby="ie-title">
  <header class="ie-head">
    <h2 id="ie-title">Image editor</h2>
    <span class="ie-name" data-name></span>
    <label class="btn ie-add">
      <Icon name="plus" />
      Add images
      <input class="visually-hidden" type="file" accept="image/jpeg,image/png,image/webp" multiple data-add />
    </label>
    <button class="btn" type="button" data-close>Close</button>
  </header>

  <form class="ie-body" data-form>
    <div class="ie-main">
      <div class="ie-toolbar">
        <button class="icon-btn" type="button" data-rotate-left aria-label="Rotate left" title="Rotate left">
          <Icon name="undo" />
        </button>
        <button class="icon-btn" type="button" data-rotate-right aria-label="Rotate right" title="Rotate right">
          <Icon name="redo" />
        </button>
        <button class="icon-btn" type="button" data-flip aria-label="Flip horizontally" title="Flip horizontally">
          <Icon name="flip" />
        </button>
        <div class="ie-zoom" data-zoom-controls>
          <button class="icon-btn" type="button" data-zoom-out aria-label="Zoom out" title="Zoom out">−</button>
          <input type="range" name="zoom" min="1" max="8" step="0.01" value="1" aria-label="Zoom" />
          <button class="icon-btn" type="button" data-zoom-in aria-label="Zoom in" title="Zoom in">+</button>
          <button class="btn ie-reset" type="button" data-reset>Reset position</button>
        </div>
      </div>
      <div class="ie-stage">
        <canvas data-canvas tabindex="0" role="application" aria-roledescription="crop area" aria-label="Image preview" aria-describedby="ie-help ie-crop"></canvas>
      </div>
      <p class="ie-crop" id="ie-crop" data-crop></p>
      <p class="visually-hidden" id="ie-help">Drag or use the arrow keys to position the image in the frame; hold Shift for bigger steps. Plus and minus zoom.</p>
      <ul class="ie-thumbs" data-thumbs aria-label="Images" hidden></ul>
    </div>

    <div class="ie-side">
      <fieldset>
        <legend>Aspect ratio</legend>
        <div class="ie-chips">
          {RATIOS.map((id) => <label><input type="radio" name="ratio" value={id} checked={id === 'original'} /><span>{choiceLabel(id)}</span></label>)}
          <button class="ie-swap" type="button" data-swap aria-label="Swap orientation" title="Swap orientation (e.g. 3:2 ⇄ 2:3)">⇄</button>
        </div>
      </fieldset>
      <div class="ie-pair" data-custom-ratio hidden>
        <label class="field"><span>Ratio width</span><input type="number" name="rw" min="0.01" step="any" value="3" inputmode="decimal" /></label>
        <span aria-hidden="true">:</span>
        <label class="field"><span>Ratio height</span><input type="number" name="rh" min="0.01" step="any" value="2" inputmode="decimal" /></label>
      </div>

      <fieldset>
        <legend>Size, long side (px)</legend>
        <div class="ie-chips">
          {SIZES.map((id) => <label><input type="radio" name="size" value={id} checked={id === 'original'} /><span>{choiceLabel(id)}</span></label>)}
        </div>
      </fieldset>
      <div class="ie-pair" data-custom-size hidden>
        <label class="field"><span>Width (px)</span><input type="number" name="cw" min="1" step="1" inputmode="numeric" /></label>
        <span aria-hidden="true">×</span>
        <label class="field"><span>Height (px)</span><input type="number" name="ch" min="1" step="1" inputmode="numeric" /></label>
      </div>

      <fieldset data-fit-set>
        <legend>Fit</legend>
        <div class="segmented">
          <label><input type="radio" name="fit" value="fill" checked /><span>Fill frame</span></label>
          <label><input type="radio" name="fit" value="fit" /><span>Fit inside</span></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Background</legend>
        <div class="ie-bg">
          <div class="segmented" data-bg-set>
            <label><input type="radio" name="bg" value="none" checked /><span>Transparent</span></label>
            <label><input type="radio" name="bg" value="colour" /><span>Colour</span></label>
          </div>
          <input type="color" name="colour" value="#ffffff" aria-label="Background colour" />
        </div>
      </fieldset>

      <fieldset>
        <legend>Format</legend>
        <div class="segmented">
          <label><input type="radio" name="format" value="image/jpeg" /><span>JPEG</span></label>
          <label><input type="radio" name="format" value="image/png" /><span>PNG</span></label>
          <label><input type="radio" name="format" value="image/webp" checked /><span>WebP</span></label>
        </div>
      </fieldset>
      <div class="field">
        <span id="ie-quality">Quality <span class="muted" data-quality-out></span></span>
        <div class="ie-quality">
          <input type="range" name="quality" min="1" max="100" value="82" aria-labelledby="ie-quality" />
          <input type="number" min="1" max="100" step="1" inputmode="numeric" aria-labelledby="ie-quality" data-quality-num />
        </div>
      </div>
      <p class="warn-box" data-jpeg-warn hidden>JPEG has no transparency: transparent areas get the background colour.</p>
      <label class="ie-check"><input type="checkbox" role="switch" name="strip" checked /> Remove metadata (EXIF, GPS location)</label>
      <p class="ie-note" data-gps-hint hidden>Location data will be kept.</p>
      <p class="warn-box" data-problem hidden></p>

      <div class="ie-actions">
        <p class="warn-box" data-upscale-warn role="status" hidden></p>
        <dl class="ie-out">
          <dt>Output</dt><dd data-dims>–</dd>
          <dt>File size</dt><dd data-estimate>–</dd>
        </dl>
        <button class="btn btn-primary" type="button" data-download>Download</button>
        <button class="btn" type="button" data-download-all hidden>Download all (ZIP)</button>
        <p class="status" data-status role="status" aria-live="polite"></p>
      </div>
    </div>
  </form>
</section>

<style is:global>
  .image-editor {
    --ie-w: min(100vw - 2rem, 1280px);
    --stage: #1d1e22;
    width: var(--ie-w);
    margin: 1.5rem calc((100% - var(--ie-w)) / 2) 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    scroll-margin-top: 72px; /* below the sticky site header */
  }
  .image-editor:focus { outline: none; }
  .image-editor .icon svg { width: 18px; height: 18px; }
  .ie-head { display: flex; align-items: center; gap: 0.5rem; padding: 0.55rem 0.6rem 0.55rem 1rem; border-bottom: 1px solid var(--border); }
  .ie-head h2 { margin: 0; font-size: 1rem; white-space: nowrap; }
  .ie-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); font-size: 0.88rem; }
  .ie-head .btn { padding: 0.4rem 0.8rem; font-size: 0.88rem; }
  .ie-add:focus-within { outline: 3px solid var(--accent); outline-offset: 2px; }

  .ie-body { display: grid; grid-template-columns: minmax(0, 1fr) 340px; height: clamp(540px, calc(100dvh - 140px), 900px); }
  .ie-main { display: flex; flex-direction: column; min-width: 0; background: var(--stage); color: #d9dadf; }
  .ie-toolbar { display: flex; align-items: center; gap: 0.15rem; flex-wrap: wrap; padding: 0.4rem 0.5rem; border-bottom: 1px solid rgb(255 255 255 / 0.08); }
  .ie-toolbar .icon-btn { width: 36px; height: 36px; color: #c4c6cc; display: inline-grid; place-items: center; font-size: 1.2rem; }
  .ie-toolbar .icon-btn:hover { background: rgb(255 255 255 / 0.1); color: #fff; }
  .ie-zoom { display: flex; align-items: center; gap: 0.15rem; flex: 1; min-width: 14rem; margin-left: 0.5rem; padding-left: 0.5rem; border-left: 1px solid rgb(255 255 255 / 0.1); }
  .ie-zoom input { flex: 1; min-width: 4rem; max-width: 14rem; }
  .ie-reset { margin-left: auto; padding: 0.35rem 0.7rem; font-size: 0.85rem; background: transparent; color: inherit; border-color: rgb(255 255 255 / 0.18); }
  .ie-reset:hover { border-color: rgb(255 255 255 / 0.4); }
  .ie-stage { position: relative; flex: 1; min-height: 0; }
  .ie-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: grab; }
  .ie-stage canvas:active { cursor: grabbing; }
  .ie-stage canvas:focus-visible { outline-offset: -3px; border-radius: 0; }
  .ie-crop { margin: 0; padding: 0.35rem 0.9rem 0.5rem; font: 0.78rem/1.4 var(--mono); color: #a3a5ad; min-height: 2em; }
  .ie-thumbs { list-style: none; display: flex; gap: 0.45rem; overflow-x: auto; margin: 0; padding: 0.55rem 0.75rem 0.7rem; border-top: 1px solid rgb(255 255 255 / 0.08); }
  .ie-thumb { display: block; width: 56px; height: 56px; padding: 0; border-radius: 8px; border: 2px solid transparent; overflow: hidden; background: #000; cursor: pointer; }
  .ie-thumb[aria-current='true'] { border-color: var(--accent); }
  .ie-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .ie-side { display: grid; gap: 1rem; align-content: start; padding: 1rem; border-left: 1px solid var(--border); font-size: 0.92rem; overflow-y: auto; overscroll-behavior: contain; }
  .ie-side fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .ie-side legend, .ie-side .field > span { font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 0.4rem; padding: 0; }
  .ie-side .field { gap: 0.15rem; }
  .ie-side input[type='number'] { width: 100%; padding: 0.4rem 0.55rem; }
  .ie-side .segmented { display: flex; }
  .ie-side .segmented label { flex: 1; text-align: center; }
  .ie-side .segmented span { padding: 0.35rem 0.5rem; font-size: 0.88rem; }
  .ie-side [type='range'] { width: 100%; }
  .ie-chips { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .ie-chips label { position: relative; }
  .ie-chips input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .ie-chips span, .ie-swap { display: block; padding: 0.25rem 0.6rem; border: 1px solid var(--border); border-radius: 999px; font-family: inherit; font-weight: 600; font-size: 0.82rem; line-height: 1.3; font-variant-numeric: tabular-nums; }
  .ie-chips input:checked + span { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, var(--surface)); color: var(--accent); }
  .ie-chips input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 1px; }
  .ie-swap { background: var(--surface); color: inherit; cursor: pointer; }
  .ie-swap:disabled { opacity: 0.4; cursor: default; }
  .ie-pair { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.4rem; align-items: end; }
  .ie-pair > span { padding-bottom: 0.5rem; color: var(--muted); }
  .ie-check { display: flex; gap: 0.5rem; align-items: center; }
  .ie-check input, .ie-bg [type='color'] { accent-color: var(--accent); }
  .ie-bg { display: flex; gap: 0.5rem; align-items: center; }
  .ie-bg .segmented { flex: 1; }
  .ie-bg [type='color'] { width: 2.6rem; height: 2.2rem; padding: 2px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); cursor: pointer; flex: none; }
  .ie-bg [type='color']:disabled { opacity: 0.35; cursor: default; }
  .ie-side .warn-box { margin: 0; }
  .ie-out { display: grid; grid-template-columns: auto 1fr; gap: 0.15rem 0.75rem; margin: 0; padding: 0.5rem 0.7rem; border-radius: 10px; background: var(--surface-2); font-size: 0.88rem; font-variant-numeric: tabular-nums; }
  .ie-out dt { color: var(--muted); }
  .ie-out dd { margin: 0; text-align: right; font-weight: 600; }
  .ie-note { margin: -0.5rem 0 0; font-size: 0.8rem; color: var(--muted); }
  .ie-quality { display: flex; gap: 0.6rem; align-items: center; }
  .ie-side .ie-quality [type='number'] { width: 4.5rem; flex: none; }
  .ie-actions { display: grid; gap: 0.5rem; position: sticky; bottom: 0; margin: 0 -1rem -1rem; padding: 0.75rem 1rem 1rem; background: var(--surface); border-top: 1px solid var(--border); }
  .ie-actions .status { margin: 0; min-height: 0; font-size: 0.85rem; }
  .ie-actions .status:empty { display: none; }

  @media (max-width: 820px) {
    .ie-body { grid-template-columns: minmax(0, 1fr); height: auto; }
    .ie-side { border-left: 0; border-top: 1px solid var(--border); }
    .ie-stage { flex: none; height: clamp(280px, 58dvh, 520px); }
  }
  @media (max-width: 480px) {
    .image-editor { --ie-w: calc(100vw - 1rem); border-radius: 10px; }
    .ie-zoom { margin-left: 0; padding-left: 0; border-left: 0; min-width: 100%; }
    .ie-head h2 { display: none; }
  }
</style>
