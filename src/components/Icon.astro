---
// Iconoir icons (same set as the portfolio), inlined at build time; strokes use currentColor.
import archive from 'iconoir/icons/regular/archive.svg?raw';
import arrowDown from 'iconoir/icons/regular/arrow-down.svg?raw';
import arrowLeft from 'iconoir/icons/regular/arrow-left.svg?raw';
import arrowRight from 'iconoir/icons/regular/arrow-right.svg?raw';
import arrowUp from 'iconoir/icons/regular/arrow-up.svg?raw';
import cloud from 'iconoir/icons/regular/cloud.svg?raw';
import computer from 'iconoir/icons/regular/computer.svg?raw';
import laptop from 'iconoir/icons/regular/laptop.svg?raw';
import code from 'iconoir/icons/regular/code.svg?raw';
import home from 'iconoir/icons/regular/home-simple-door.svg?raw';
import download from 'iconoir/icons/regular/download.svg?raw';
import pause from 'iconoir/icons/regular/pause.svg?raw';
import play from 'iconoir/icons/regular/play.svg?raw';
import scissor from 'iconoir/icons/regular/scissor.svg?raw';
import skipPrev from 'iconoir/icons/regular/skip-prev.svg?raw';
import zoomIn from 'iconoir/icons/regular/zoom-in.svg?raw';
import zoomOut from 'iconoir/icons/regular/zoom-out.svg?raw';
import flip from 'iconoir/icons/regular/flip.svg?raw';
import halfMoon from 'iconoir/icons/regular/half-moon.svg?raw';
import lock from 'iconoir/icons/regular/lock.svg?raw';
import mediaImage from 'iconoir/icons/regular/media-image.svg?raw';
import music from 'iconoir/icons/regular/music-double-note.svg?raw';
import page from 'iconoir/icons/regular/page.svg?raw';
import plus from 'iconoir/icons/regular/plus.svg?raw';
import redo from 'iconoir/icons/regular/redo.svg?raw';
import search from 'iconoir/icons/regular/search.svg?raw';
import settings from 'iconoir/icons/regular/settings.svg?raw';
import shield from 'iconoir/icons/regular/shield-check.svg?raw';
import sun from 'iconoir/icons/regular/sun-light.svg?raw';
import undo from 'iconoir/icons/regular/undo.svg?raw';
import upload from 'iconoir/icons/regular/upload.svg?raw';
import viewGrid from 'iconoir/icons/regular/view-grid.svg?raw';
import xmark from 'iconoir/icons/regular/xmark.svg?raw';
import checkCircle from 'iconoir/icons/regular/check-circle.svg?raw';
import codeBrackets from 'iconoir/icons/regular/code-brackets.svg?raw';
import copy from 'iconoir/icons/regular/copy.svg?raw';
import editPencil from 'iconoir/icons/regular/edit-pencil.svg?raw';
import folder from 'iconoir/icons/regular/folder.svg?raw';
import pageEdit from 'iconoir/icons/regular/page-edit.svg?raw';
import pagePlus from 'iconoir/icons/regular/page-plus.svg?raw';
import pasteClipboard from 'iconoir/icons/regular/paste-clipboard.svg?raw';
import sidebarCollapse from 'iconoir/icons/regular/sidebar-collapse.svg?raw';
import trash from 'iconoir/icons/regular/trash.svg?raw';
import warningCircle from 'iconoir/icons/regular/warning-circle.svg?raw';
import gitCompare from 'iconoir/icons/regular/git-compare.svg?raw';
import arrowSeparateVertical from 'iconoir/icons/regular/arrow-separate-vertical.svg?raw';
import openInWindow from 'iconoir/icons/regular/open-in-window.svg?raw';
import restart from 'iconoir/icons/regular/restart.svg?raw';
import rotateLeft from 'iconoir/icons/regular/rotate-camera-left.svg?raw';
import rotateRight from 'iconoir/icons/regular/rotate-camera-right.svg?raw';
import crop from 'iconoir/icons/regular/crop.svg?raw';

const icons = {
  // Local-mode marker; distinct from the theme's computer icon.
  device: laptop, code, home, cloud, lock, upload, plus, undo, redo, flip, search, settings, shield, xmark, grid: viewGrid,
  'arrow-up': arrowUp, 'arrow-down': arrowDown, 'arrow-left': arrowLeft, 'arrow-right': arrowRight,
  download, play, pause, scissor, 'skip-prev': skipPrev, 'zoom-in': zoomIn, 'zoom-out': zoomOut,
  'theme-system': computer, 'theme-light': sun, 'theme-dark': halfMoon,
  images: mediaImage, pdf: page, audio: music, files: archive,
  braces: codeBrackets, check: checkCircle, copy, doc: pageEdit, edit: editPencil, folder, 'new-file': pagePlus, paste: pasteClipboard,
  sidebar: sidebarCollapse, trash, warning: warningCircle, compare: gitCompare,
  open: openInWindow, restart, reverse: arrowSeparateVertical,
  'rotate-left': rotateLeft, 'rotate-right': rotateRight, crop,
};
type IconName = keyof typeof icons;

interface Props { name: IconName; class?: string }
const { name, class: cls } = Astro.props;
// Drop the fixed 24px size so CSS controls it; mark decorative.
const svg = icons[name].replace(/ width="24" height="24"/, ' aria-hidden="true" focusable="false"');
---
<span class:list={['icon', cls]} set:html={svg} />
