---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import logo from '../../public/logo.svg?raw';
import { href } from '../tools';
interface Props { title: string; description?: string; /** Full-viewport home page: chrome floats in the corners, no footer. */ wide?: boolean }
const { title, description = 'Fast, private file tools that run in your browser.', wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${href('favicon.svg').replace(/\/$/, '')}?v=eyes`} type="image/svg+xml" />
    <script is:inline src={href('theme.js').replace(/\/$/, '')}></script>
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    {!wide && <slot name="home-link"><a class="corner corner-tl brand" href={href()} aria-label="tools home"><Fragment set:html={logo} /></a></slot>}
    <main id="main" class={wide ? 'wide' : undefined}><slot /></main>
    {!wide && (
      <footer class="site-footer">
        <div class="inner">
          <dl class="footer-legend">
            <div><dt><Icon name="device" /><span>On your device</span></dt><dd>Runs in your browser; nothing is uploaded.</dd></div>
            <div><dt><Icon name="cloud" /><span>Cloud · EU</span></dt><dd>Uploaded to our server in Belgium (EU) for processing, only after you confirm each time. Nothing is stored.</dd></div>
          </dl>
          <p class="footer-more">Details on the <a href={href('privacy')}>privacy page</a>.</p>
        </div>
      </footer>
    )}
  </body>
</html>
