---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { href } from '../tools';
interface Props { title: string; description?: string; /** Full-viewport home page: chrome floats in the corners, no footer. */ wide?: boolean }
const { title, description = 'Fast, private file tools that run in your browser.', wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('favicon.svg').replace(/\/$/, '')} type="image/svg+xml" />
    <script is:inline src={href('theme.js').replace(/\/$/, '')}></script>
  </head>
  <body class:list={{ 'is-wide': wide }}>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <a class="corner corner-tl brand" href={href()}>Tools</a>
    <button class="corner corner-tr icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Colour theme: switch between system, light and dark" title="Theme">
      <Icon name="theme-system" class="t-system" /><Icon name="theme-light" class="t-light" /><Icon name="theme-dark" class="t-dark" />
    </button>
    <main id="main" class={wide ? 'wide' : undefined}><slot /></main>
    {wide ? (
      <>
        <a class="corner corner-bl" href={href('privacy')}><Icon name="shield" />Privacy</a>
        <a class="corner corner-br" href={href('settings')}><Icon name="settings" />Settings</a>
      </>
    ) : (
      <footer class="site-footer">
        <div class="inner">
          <dl class="footer-legend">
            <div><dt><Icon name="device" /><span>On your device</span></dt><dd>Runs in your browser. Your files never leave your device.</dd></div>
            <div><dt><Icon name="cloud" /><span>Cloud · EU</span></dt><dd>Uploaded to our server in Belgium (EU) for processing, only after you confirm each time. Nothing is stored.</dd></div>
          </dl>
          <div class="footer-corners">
            <a class="corner-link" href={href('privacy')}><Icon name="shield" />Privacy</a>
            <a class="corner-link" href={href('settings')}><Icon name="settings" />Settings</a>
          </div>
        </div>
      </footer>
    )}
    <script>
      import { cycleTheme } from '../lib/prefs';
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', cycleTheme);
    </script>
  </body>
</html>
